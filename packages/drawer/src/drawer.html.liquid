{% doc %}
  This snippet is used to render a drawer.

  @param {string} id - The drawer ID. Required.
  @param {string} content - The drawer content. Required.
  @param {string} [label] - ID of the element labelling the dialog. Optional.
  @param {string} [direction] - The direction the drawer will open from. Possible values are 'from-left', 'from-right' and 'from-bottom'. Default is 'from-right'.
  @param {string} [classes] - Additional classes to apply to the dialog. Optional.
  @param {string} [margin_top] - The top offset of the drawer. Optional. Default is '0rem'.
  @param {string} [background] - The background color of the drawer. Optional. Default is 'bg-white'.
  @param {boolean} [modal] - `false` opens with `show()`: the page, header included, stays interactive, and a scrim replaces `::backdrop`. Default `true`.

  @example
  {% render 'cinq-drawer.html', id: 'drawer1', direction: 'from-left', label: 'drawer1-title', content: panel %}
{% enddoc %}

{% liquid
  assign direction = direction | default: 'from-right'
  assign position = 'inset-y-0 right-0 left-auto w-125 translate-x-full open:translate-x-0 starting:open:translate-x-full'
  assign margin_top = margin_top | default: '0rem'
  assign background = background | default: 'bg-white'

  if direction == 'from-left'
    assign position = 'inset-y-0 left-0 right-auto w-125 -translate-x-full open:translate-x-0 starting:open:-translate-x-full'
  endif

  if direction == 'from-bottom'
    assign position = 'inset-x-0 bottom-0 top-auto w-full translate-y-full open:translate-y-0 starting:open:translate-y-full'
  endif
%}
<cinq-drawer id="{{ id }}"{% if modal == false %} data-modal="false"{% endif %}>
  {%- if modal == false %}
    <div
      class="pointer-events-none fixed inset-x-0 bottom-0 bg-black/30 opacity-0 transition-opacity duration-300 in-[[open]]:pointer-events-auto in-[[open]]:opacity-100"
      style="top: {{ margin_top }};"
      aria-hidden="true"
    ></div>
  {%- endif %}
  <dialog
    {% if label %}aria-labelledby="{{ label }}"{% endif %}
    class="fixed m-0 h-full max-h-none max-w-full border-0 p-0 {{ position }} {{ background }} transition-[translate,overlay,display] transition-discrete duration-300 ease-out backdrop:bg-black/30 backdrop:opacity-0 backdrop:transition-[opacity,overlay,display] backdrop:transition-discrete backdrop:duration-300 open:backdrop:opacity-100 starting:open:backdrop:opacity-0{% if classes %} {{ classes }}{% endif %}"
    style="margin-top: {{ margin_top }}; height: calc(100% - {{ margin_top }});"
  >
    <div class="scrollbar-hidden h-full overflow-y-auto scroll-smooth">
      {{- content -}}
    </div>
  </dialog>
</cinq-drawer>
