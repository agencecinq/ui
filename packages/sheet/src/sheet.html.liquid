{% doc %}
  Renders a cinq-sheet host with a native dialog anchored to the bottom edge.
  Open height follows content. Cap it with `max-height` in `classes`.

  @param {string} id - The sheet ID. Required.
  @param {string} content - The sheet content. Required.
  @param {string} [label] - ID of the element labelling the dialog. Optional.
  @param {string} [classes] - Extra classes on the dialog. Optional.
  @param {boolean} [handle] - Render the drag handle. Default `true`.

  @example
  {% render 'cinq-sheet.html', id: 'size-sheet', label: 'size-sheet-title', content: panel %}
{% enddoc %}

<cinq-sheet id="{{ id }}" class="contents">
  <dialog
    {% if label %}aria-labelledby="{{ label }}"{% endif %}
    class="fixed inset-x-0 top-auto -bottom-4 m-0 w-auto max-w-none max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-0 border-t border-[#e9e9e9] bg-white p-0 pb-4 translate-y-[max(-1rem,var(--cinq-sheet-drag-offset,0px))] not-open:translate-y-full starting:open:translate-y-full transition-[translate,display,overlay] transition-discrete duration-300 ease-out in-[[dragging]]:transition-none motion-reduce:transition-none backdrop:bg-[#171717]/30{% if classes %} {{ classes }}{% endif %}"
  >
    {% unless handle == false %}
      <div
        data-dom="drag-indicator"
        class="flex touch-none justify-center pt-2 pb-3"
        aria-hidden="true"
      >
        <span class="h-0.75 w-9 rounded-full bg-[#e9e9e9]"></span>
      </div>
    {% endunless %}
    {{- content -}}
  </dialog>
</cinq-sheet>
