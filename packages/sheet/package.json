{
  "name": "@agencecinq/sheet",
  "version": "2.0.0",
  "description": "Accessible bottom sheet Web Component on native <dialog>, content-sized with drag-to-dismiss.",
  "type": "module",
  "license": "MIT",
  "author": "Jérémy Levron <jeremy@agencecinq.com> (https://agencecinq.com)",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
