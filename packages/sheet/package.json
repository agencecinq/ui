    "directory": "packages/sheet"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@agencecinq/utils": "workspace:*",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
