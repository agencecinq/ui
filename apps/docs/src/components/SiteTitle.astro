---
/**
 * Site title: the CINQ logo of the Figma Section/Header, then « UI ». The link is named after the
 * site title, which holds the visible text.
 */
import Logo from './Logo.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a
  href={siteTitleHref}
  class="text-primary focus-visible:outline-focus-ring flex items-center gap-3 no-underline focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <Logo class="h-6 w-20 shrink-0" />
  <span class="text-muted text-[0.9375rem]" aria-hidden="true">UI</span>
  <span class="sr-only">{siteTitle}</span>
</a>
