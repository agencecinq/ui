---
import "../../styles/example.css";

type Place = {
  id: string;
  name: string;
  region: string;
  lore: string;
  x: number;
  y: number;
};

const places: Place[] = [
  {
    id: "neverwinter",
    name: "Neverwinter",
    region: "The North",
    lore: "The Jewel of the North, warmed by the river that never freezes. Its gardens bloom even in the dead of winter.",
    x: 46,
    y: 16,
  },
  {
    id: "waterdeep",
    name: "Waterdeep",
    region: "The North",
    lore: "The City of Splendors. Its masked lords rule from the shadows, and its sewers hide more than rats.",
    x: 36,
    y: 38,
  },
  {
    id: "daggerford",
    name: "Daggerford",
    region: "The Western Heartlands",
    lore: "A walled town on the Delimbiyr ford, guarded by a duke and a handful of very tired militia.",
    x: 56,
    y: 49,
  },
  {
    id: "candlekeep",
    name: "Candlekeep",
    region: "The Sword Coast",
    lore: "A library fortress on a cliff. Its monks admit only visitors who bring a book they do not already own.",
    x: 26,
    y: 66,
  },
  {
    id: "baldurs-gate",
    name: "Baldur's Gate",
    region: "The Western Heartlands",
    lore: "A bustling port of merchants and smugglers, where the Flaming Fist keeps a very loose order.",
    x: 50,
    y: 80,
  },
];

const start = places[1];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Map of the Sword Coast | CINQ UI</title>
  </head>
  <body class="overflow-hidden bg-[#cfdcdc] font-sans text-[#2f2a22] antialiased">
    <main class="relative h-dvh">
      <svg class="absolute inset-0 size-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M100 0 H30 C34 8 40 10 38 20 C36 28 28 30 30 40 C32 48 40 50 34 58 C28 64 20 62 22 72 C24 80 40 76 42 86 C43 92 38 96 40 100 H100 Z"
          fill="#e9dfc4"
          stroke="#b9a77c"
          stroke-width="0.4"
        />
        <path d="M60 26 C66 30 74 28 80 34 M64 60 C70 56 78 62 86 58" fill="none" stroke="#9fb6c4" stroke-width="0.6" />
        <g fill="#c9b98f">
          <path d="M70 12 l4 -6 l4 6 Z M76 14 l3 -5 l3 5 Z M82 40 l4 -6 l4 6 Z M88 44 l3 -5 l3 5 Z" />
        </g>
        <g fill="#b7c49a">
          <circle cx="62" cy="68" r="3" />
          <circle cx="66" cy="71" r="2.5" />
          <circle cx="70" cy="68" r="2" />
        </g>
      </svg>

      <header class="absolute inset-x-4 top-4 rounded-2xl bg-white/90 px-4 py-3 shadow">
        <p class="font-serif text-lg italic">Sword Coast</p>
        <p class="text-sm" data-dom="party" aria-live="polite">The party rests in {start.name}.</p>
      </header>

      <ul data-dom="places" aria-label="Places">
        {places.map((place) => (
          <li class="absolute -translate-x-1/2 -translate-y-1/2" style={`left: ${place.x}%; top: ${place.y}%`}>
            <button
              type="button"
              class="group flex flex-col items-center gap-1 rounded-lg p-1 focus-visible:outline-2 focus-visible:outline-[#2f2a22]"
              commandfor="place-sheet"
              command="show-popover"
              data-place={place.id}
              aria-current={place === start ? "location" : undefined}
            >
              <span class="size-3 rounded-full bg-[#2f2a22] ring-4 ring-white/70 transition-colors group-aria-[current=location]:bg-[#a33a2e] group-aria-[current=location]:ring-[#a33a2e]/30" aria-hidden="true"></span>
              <span class="rounded bg-white/80 px-1.5 font-serif text-xs italic">{place.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </main>

    <cinq-sheet>
      <dialog
        id="place-sheet"
        popover="manual"
        aria-labelledby="place-name"
        class="fixed inset-x-0 top-auto -bottom-4 m-0 w-auto max-w-none max-h-[55dvh] overflow-y-auto overscroll-contain rounded-t-3xl border-0 bg-white p-0 pb-4 text-[#2f2a22] shadow-[0_-8px_30px_rgb(0_0_0/0.15)] translate-y-[max(-1rem,var(--cinq-sheet-drag-offset,0px))] not-open:translate-y-full starting:open:translate-y-full transition-[translate,display,overlay] transition-discrete duration-300 ease-out in-[[dragging]]:transition-none motion-reduce:transition-none"
      >
        <div
          data-dom="drag-indicator"
          class="flex cursor-grab touch-none justify-center pt-2 pb-3 active:cursor-grabbing"
          aria-hidden="true"
        >
          <span class="h-1 w-9 rounded-full bg-[#e2dccd]"></span>
        </div>

        <div class="flex flex-col gap-3 px-5 pb-6">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 id="place-name" class="font-serif text-xl italic" data-dom="name"></h2>
              <p class="text-sm text-[#6b6355]" data-dom="region"></p>
            </div>
            <button
              type="button"
              class="grid size-8 shrink-0 place-items-center rounded-full bg-[#f3efe4] focus-visible:outline-2 focus-visible:outline-[#2f2a22]"
              commandfor="place-sheet"
              command="hide-popover"
              aria-label="Close"
            >
              <svg class="size-3" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M1 1l12 12M13 1L1 13" />
              </svg>
            </button>
          </div>
          <p class="text-sm font-medium" data-dom="distance"></p>
          <p class="text-sm leading-relaxed" data-dom="lore"></p>
          <button
            type="button"
            class="h-11 w-full rounded-xl bg-[#2f2a22] text-sm text-white disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2f2a22]"
            data-dom="travel"
          >
            Travel here
          </button>
        </div>
      </dialog>
    </cinq-sheet>

    <script is:inline type="application/json" data-dom="data" set:html={JSON.stringify(places)}></script>

    <script>
      import "@agencecinq/sheet";

      type Place = { id: string; name: string; region: string; lore: string; x: number; y: number };

      const places: Place[] = JSON.parse(document.querySelector('[data-dom="data"]')?.textContent ?? "[]");
      const sheet = document.getElementById("place-sheet");
      const field = (name: string) => sheet?.querySelector<HTMLElement>(`[data-dom="${name}"]`);
      const travel = field("travel") as HTMLButtonElement | null | undefined;
      const party = document.querySelector('[data-dom="party"]');
      const pins = document.querySelectorAll<HTMLElement>("[data-place]");

      let here = places.find((place) => place.id === "waterdeep") ?? places[0];
      let shown = here;

      /** About a day on foot for every 6 units of map. */
      const days = (from: Place, to: Place) => Math.max(1, Math.round(Math.hypot(to.x - from.x, to.y - from.y) / 6));

      function render(place: Place): void {
        shown = place;

        const name = field("name");
        const region = field("region");
        const distance = field("distance");
        const lore = field("lore");

        if (name) name.textContent = place.name;
        if (region) region.textContent = place.region;
        if (lore) lore.textContent = place.lore;

        const atHere = place === here;
        const count = days(here, place);

        if (distance) {
          distance.textContent = atHere ? "The party is here." : `${count} ${count === 1 ? "day" : "days"} on foot from ${here.name}.`;
        }

        if (travel) {
          travel.disabled = atHere;
        }
      }

      // Click runs before the command: the sheet opens, or stays open, on the place.
      pins.forEach((pin) => {
        pin.addEventListener("click", () => {
          const place = places.find((item) => item.id === pin.dataset.place);

          if (place) render(place);
        });
      });

      travel?.addEventListener("click", () => {
        here = shown;

        pins.forEach((pin) => {
          if (pin.dataset.place === here.id) {
            pin.setAttribute("aria-current", "location");
          } else {
            pin.removeAttribute("aria-current");
          }
        });

        if (party) {
          party.textContent = `The party rests in ${here.name}.`;
        }

        render(here);
      });

      /*
       * A manual popover ignores close requests, so that taps on the map leave
       * the card open. CloseWatcher brings them back: Escape, and the back
       * gesture on Android. Where it is missing (Safari), Escape alone.
       */
      const host = sheet?.closest("cinq-sheet") as (HTMLElement & { close(): Promise<boolean> }) | null;
      const supportsCloseWatcher = "CloseWatcher" in window;

      let watcher: CloseWatcher | null = null;

      function watch(): void {
        watcher = new CloseWatcher();
        watcher.addEventListener("close", () => {
          // A close canceled by sheet:before-close leaves the card open: watch again.
          void host?.close().then((closed) => {
            if (!closed) watch();
          });
        });
      }

      sheet?.addEventListener("toggle", (event) => {
        if (!supportsCloseWatcher) return;

        if ((event as ToggleEvent).newState === "open") {
          watch();
        } else {
          watcher?.destroy();
          watcher = null;
        }
      });

      document.addEventListener("keydown", (event) => {
        if (supportsCloseWatcher || event.key !== "Escape" || !sheet?.matches(":popover-open")) return;

        host?.close();
      });

      render(here);
    </script>
  </body>
</html>
