---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-calendar {
    max-width: 20rem;
    font-size: 0.875rem;
  }

  .docs-calendar header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .docs-calendar header button {
    appearance: none;
    border: 1px solid #d1d5db;
    background: #fff;
    border-radius: 0.375rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    font: inherit;
    color: #111827;
  }

  .docs-calendar header button:hover {
    background: #f3f4f6;
  }

  /* Previous points right and next points left in a right-to-left calendar. */
  .docs-calendar header [command]:dir(rtl) {
    scale: -1 1;
  }

  .docs-calendar [aria-live] {
    flex: 1;
    margin: 0;
    font-size: inherit;
    font-weight: 600;
    color: #111827;
    text-align: center;
    text-transform: capitalize;
  }

  .docs-calendar table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .docs-calendar th {
    padding: 0.35rem 0;
    font-weight: 500;
    color: #6b7280;
    font-size: 0.75rem;
  }

  .docs-calendar td {
    padding: 0.125rem;
    text-align: center;
  }

  .docs-calendar [data-day] {
    appearance: none;
    width: 100%;
    aspect-ratio: 1;
    border: none;
    border-radius: 0.375rem;
    background: transparent;
    cursor: pointer;
    font: inherit;
    color: #111827;
  }

  .docs-calendar td:not([aria-selected='true'], [data-range]) [data-day]:hover:not([aria-disabled='true']) {
    background: #f3f4f6;
  }

  .docs-calendar [data-day][aria-current='date'] {
    outline: 1px solid #111827;
    outline-offset: -1px;
  }

  /* Picked day. The rules below weigh the same: the last one wins. */
  .docs-calendar td[aria-selected='true'] [data-day] {
    background: #111827;
    color: #fff;
  }

  /* Inside a range, ends included, picked or previewed. */
  .docs-calendar td[data-range] [data-day] {
    background: #e5e7eb;
    border-radius: 0;
    color: #111827;
  }

  .docs-calendar td[data-range]:not([data-start], [data-end]) [data-day]:hover {
    background: #d1d5db;
  }

  /* Range ends keep the strong contrast. */
  .docs-calendar td[data-start] [data-day],
  .docs-calendar td[data-end] [data-day] {
    background: #111827;
    color: #fff;
  }

  /* Logical corners: the start of a range sits on the right in a right-to-left grid. */
  .docs-calendar td[data-start] [data-day] {
    border-start-start-radius: 0.375rem;
    border-end-start-radius: 0.375rem;
  }

  .docs-calendar td[data-end] [data-day] {
    border-start-end-radius: 0.375rem;
    border-end-end-radius: 0.375rem;
  }

  .docs-calendar td[data-start][data-end] [data-day] {
    border-radius: 0.375rem;
  }

  .docs-calendar [data-day][aria-disabled='true'] {
    color: #9ca3af;
    cursor: not-allowed;
  }

  .docs-calendar-events [data-day] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    line-height: 1.1;
  }

  .docs-calendar-events [data-day] time {
    font-variant-numeric: tabular-nums;
  }

  .docs-calendar-events [data-day][data-has-event]::after {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 9999px;
    background: #111827;
  }

  .docs-calendar-events td[aria-selected='true'] [data-day][data-has-event]::after {
    background: #fff;
  }

  .docs-calendar td:not([aria-selected='true']) [data-day][data-weekend] {
    color: #9ca3af;
  }

  .docs-calendar-dialog {
    margin: auto;
    background: #fff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
  }

  .docs-calendar-dialog::backdrop {
    background: rgb(17 24 39 / 0.4);
  }
</style>

<div class="not-content flex flex-col gap-10">
  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Single date</h3>
        <p class="text-sm text-gray-600">
          Locale <code>fr</code> and <code>deselectable</code>.
          Click the selected day again to clear. Try the keyboard once a day is focused:
          arrows, <kbd>Home</kbd>/<kbd>End</kbd>, <kbd>Page Up</kbd>/<kbd>Page Down</kbd>.
        </p>
      </div>

      <cinq-calendar
        id="docs-calendar-single"
        class="docs-calendar"
        data-calendar-demo="single"
        lang="fr"
        deselectable
        name="single"
      >
        <header>
          <button type="button" commandfor="docs-calendar-single" command="--previous-month" aria-label="Mois précédent">‹</button>
          <h4 id="docs-calendar-single-label" aria-live="polite"></h4>
          <button type="button" commandfor="docs-calendar-single" command="--next-month" aria-label="Mois suivant">›</button>
        </header>
        <table role="grid" aria-labelledby="docs-calendar-single-label">
          <thead>
            <tr></tr>
          </thead>
          <tbody></tbody>
        </table>
      </cinq-calendar>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="single" class="font-medium text-gray-900">Aucune date</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Date range</h3>
        <p class="text-sm text-gray-600">
          <code>mode="range"</code>. Pick a start day, then an end day. Hover (or move focus)
          paints the in-between preview. A third click resets the range.
        </p>
      </div>

      <cinq-calendar
        id="docs-calendar-range"
        class="docs-calendar"
        data-calendar-demo="range"
        lang="fr"
        mode="range"
        name="range"
      >
        <header>
          <button type="button" commandfor="docs-calendar-range" command="--previous-month" aria-label="Mois précédent">‹</button>
          <h4 id="docs-calendar-range-label" aria-live="polite"></h4>
          <button type="button" commandfor="docs-calendar-range" command="--next-month" aria-label="Mois suivant">›</button>
        </header>
        <table role="grid" aria-labelledby="docs-calendar-range-label" aria-multiselectable="true">
          <thead>
            <tr></tr>
          </thead>
          <tbody></tbody>
        </table>
      </cinq-calendar>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="range" class="font-medium text-gray-900">Aucune date</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Multiple dates</h3>
        <p class="text-sm text-gray-600">
          <code>mode="multiple"</code>. Toggle discrete days in and out of the
          selection. No range painting. Click a selected day again to remove it.
          Capped at 3 days here by canceling <code>calendar:before-change</code>.
        </p>
      </div>

      <cinq-calendar
        id="docs-calendar-multiple"
        class="docs-calendar"
        data-calendar-demo="multiple"
        lang="fr"
        mode="multiple"
        name="multiple"
      >
        <header>
          <button type="button" commandfor="docs-calendar-multiple" command="--previous-month" aria-label="Mois précédent">‹</button>
          <h4 id="docs-calendar-multiple-label" aria-live="polite"></h4>
          <button type="button" commandfor="docs-calendar-multiple" command="--next-month" aria-label="Mois suivant">›</button>
        </header>
        <table role="grid" aria-labelledby="docs-calendar-multiple-label" aria-multiselectable="true">
          <thead>
            <tr></tr>
          </thead>
          <tbody></tbody>
        </table>
      </cinq-calendar>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="multiple" class="font-medium text-gray-900">Aucune date</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Preselected dates</h3>
        <p class="text-sm text-gray-600">
          Seed the view with <code>data-month</code>, <code>data-year</code>, and&nbsp;<code>data-picked</code>. Here a range covering mid-November 2025.
        </p>
      </div>

      <cinq-calendar
        id="docs-calendar-preselected"
        class="docs-calendar"
        data-calendar-demo="preselected"
        lang="fr"
        mode="range"
        data-month="10"
        data-year="2025"
        data-picked='["2025-11-10","2025-11-18"]'
        name="preselected"
      >
        <header>
          <button type="button" commandfor="docs-calendar-preselected" command="--previous-month" aria-label="Mois précédent">‹</button>
          <h4 id="docs-calendar-preselected-label" aria-live="polite"></h4>
          <button type="button" commandfor="docs-calendar-preselected" command="--next-month" aria-label="Mois suivant">›</button>
        </header>
        <table role="grid" aria-labelledby="docs-calendar-preselected-label" aria-multiselectable="true">
          <thead>
            <tr></tr>
          </thead>
          <tbody></tbody>
        </table>
      </cinq-calendar>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="preselected" class="font-medium text-gray-900">2025-11-10 to 2025-11-18</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Form</h3>
        <p class="text-sm text-gray-600">
          <code>&lt;cinq-calendar&gt;</code> is a form field: <code>name="stay"</code>,
          <code>mode="range"</code> and <code>required</code>. Submit with a missing end to get the
          browser's own message. Reset brings back the initial selection.
        </p>
      </div>

      <form class="flex flex-col gap-4" data-calendar-form>
        <p id="docs-calendar-form-field" class="text-sm font-medium text-gray-900">Dates du séjour</p>

        <cinq-calendar
          id="docs-calendar-form"
          class="docs-calendar"
          data-calendar-demo="form"
          lang="fr"
          mode="range"
          name="stay"
          required
        >
          <header>
            <button type="button" commandfor="docs-calendar-form" command="--previous-month" aria-label="Mois précédent">‹</button>
            <h4 id="docs-calendar-form-label" aria-live="polite"></h4>
            <button type="button" commandfor="docs-calendar-form" command="--next-month" aria-label="Mois suivant">›</button>
          </header>
          <table
            role="grid"
            aria-labelledby="docs-calendar-form-field docs-calendar-form-label"
            aria-multiselectable="true"
          >
            <thead>
              <tr></tr>
            </thead>
            <tbody></tbody>
          </table>
        </cinq-calendar>

        <div class="flex gap-2">
          <button type="submit" class="rounded-md bg-gray-900 px-3 py-1.5 text-sm font-medium text-white">
            Réserver
          </button>
          <button type="reset" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-900">
            Réinitialiser
          </button>
        </div>
      </form>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        FormData&nbsp;:&nbsp;<span data-calendar-form-output class="font-medium text-gray-900">-</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">In a dialog</h3>
        <p class="text-sm text-gray-600">
          A native <code>&lt;input type="date"&gt;</code> stays the field. The button opens the
          calendar in a <code>&lt;dialog&gt;</code> with <code>command="show-modal"</code>, without a
          script. A picked day fills the input and closes the dialog. <kbd>Escape</kbd> closes it
          too, and focus goes back to the button.
        </p>
      </div>

      <div class="flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-sm text-gray-700">
          <span class="text-xs font-medium uppercase tracking-wide text-gray-500">Arrivée</span>
          <input
            type="date"
            id="docs-calendar-dialog-input"
            class="rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-900"
          />
        </label>
        <button
          type="button"
          command="show-modal"
          commandfor="docs-calendar-dialog"
          class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-900"
        >
          Choisir dans le calendrier
        </button>
      </div>

      <dialog
        id="docs-calendar-dialog"
        class="docs-calendar-dialog"
        aria-labelledby="docs-calendar-dialog-title"
      >
        <h4 id="docs-calendar-dialog-title" class="mb-3 text-base font-semibold text-gray-900">
          Date d'arrivée
        </h4>
        <cinq-calendar id="docs-calendar-dialog-calendar" class="docs-calendar" lang="fr">
          <header>
            <button type="button" commandfor="docs-calendar-dialog-calendar" command="--previous-month" aria-label="Mois précédent">‹</button>
            <h5 id="docs-calendar-dialog-label" aria-live="polite"></h5>
            <button type="button" commandfor="docs-calendar-dialog-calendar" command="--next-month" aria-label="Mois suivant">›</button>
          </header>
          <table
            role="grid"
            aria-labelledby="docs-calendar-dialog-title docs-calendar-dialog-label"
          >
            <thead>
              <tr></tr>
            </thead>
            <tbody></tbody>
          </table>
        </cinq-calendar>
        <button
          type="button"
          command="close"
          commandfor="docs-calendar-dialog"
          class="mt-3 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-900"
        >
          Fermer
        </button>
      </dialog>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Bounds</h3>
        <p class="text-sm text-gray-600">
          The page script sets <code>min</code> to today and <code>max</code> 60 days later. Days outside are&nbsp;<code>aria-disabled</code>&nbsp;and cannot be selected (still in the keyboard grid).
        </p>
      </div>

      <cinq-calendar
        id="docs-calendar-future"
        class="docs-calendar"
        data-calendar-demo="future"
        lang="fr"
        deselectable
        name="future"
      >
        <header>
          <button type="button" commandfor="docs-calendar-future" command="--previous-month" aria-label="Mois précédent">‹</button>
          <h4 id="docs-calendar-future-label" aria-live="polite"></h4>
          <button type="button" commandfor="docs-calendar-future" command="--next-month" aria-label="Mois suivant">›</button>
        </header>
        <table role="grid" aria-labelledby="docs-calendar-future-label">
          <thead>
            <tr></tr>
          </thead>
          <tbody></tbody>
        </table>
      </cinq-calendar>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="future" class="font-medium text-gray-900">Aucune date</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Language & week start</h3>
        <p class="text-sm text-gray-600">
          The select sets <code>lang</code> on the calendar, an observed attribute: labels
          follow through <code>Intl</code>, the week starts on the language's first day unless
          <code>first-day</code> says otherwise, and the language's weekend from
          <code>Intl.Locale#getWeekInfo()</code> is grayed: Friday alone for <code>fa</code>,
          Friday and Saturday for <code>ar</code>. It also sets <code>dir</code> from
          <code>getTextInfo()</code>: <code>ar</code> and <code>fa</code> read from the right,
          and the arrow keys follow.
        </p>
      </div>

      <div class="flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-sm text-gray-700">
          <span class="text-xs font-medium uppercase tracking-wide text-gray-500">Language</span>
          <select
            data-calendar-locale-select
            class="rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm text-gray-900 shadow-sm focus:border-gray-900 focus:outline-none focus:ring-1 focus:ring-gray-900"
          >
            <option value="en" lang="en">English (en)</option>
            <option value="fr" lang="fr" selected>Français (fr)</option>
            <option value="de" lang="de">Deutsch (de)</option>
            <option value="es" lang="es">Español (es)</option>
            <option value="ja" lang="ja">日本語 (ja)</option>
            <option value="ar" lang="ar">العربية (ar)</option>
            <option value="fa" lang="fa">فارسی (fa)</option>
            <option value="th" lang="th">ไทย (th)</option>
          </select>
        </label>
        <p class="pb-1.5 font-mono text-xs text-gray-500">
          firstDay&nbsp;=&nbsp;<span data-calendar-first-day>1</span>
          <span class="text-gray-400">(0=Sun ... 6=Sat)</span>
        </p>
      </div>

      <cinq-calendar
        id="docs-calendar-locale"
        class="docs-calendar"
        data-calendar-demo="locale"
        lang="fr"
        deselectable
        name="locale"
      >
        <header>
          <button type="button" commandfor="docs-calendar-locale" command="--previous-month" lang="en" aria-label="Previous month">‹</button>
          <h4 id="docs-calendar-locale-label" aria-live="polite"></h4>
          <button type="button" commandfor="docs-calendar-locale" command="--next-month" lang="en" aria-label="Next month">›</button>
        </header>
        <table role="grid" aria-labelledby="docs-calendar-locale-label">
          <thead>
            <tr></tr>
          </thead>
          <tbody></tbody>
        </table>
      </cinq-calendar>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="locale" class="font-medium text-gray-900">Aucune date</span>
      </p>
    </div>
  </section>

  <section class="rounded-2xl bg-white p-6 shadow">
    <div class="flex flex-col gap-4">
      <div>
        <h3 class="text-lg font-semibold text-gray-900">Advanced: event markers</h3>
        <p class="text-sm text-gray-600">
          Decorate the days on <code>calendar:render</code>: wrap each one in
          <code>&lt;time&gt;</code>, mark weekends, and paint dots on days that have events.
          Only event days are selectable. Others get <code>aria-disabled</code>.
        </p>
      </div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
        <cinq-calendar
          id="docs-calendar-events"
          class="docs-calendar docs-calendar-events"
          data-calendar-demo="events"
          lang="fr"
          deselectable
          name="events"
        >
          <header>
            <button type="button" commandfor="docs-calendar-events" command="--previous-month" aria-label="Mois précédent">‹</button>
            <h4 id="docs-calendar-events-label" aria-live="polite"></h4>
            <button type="button" commandfor="docs-calendar-events" command="--next-month" aria-label="Mois suivant">›</button>
          </header>
          <table role="grid" aria-labelledby="docs-calendar-events-label">
            <thead>
              <tr></tr>
            </thead>
            <tbody></tbody>
          </table>
        </cinq-calendar>

        <aside
          class="min-w-0 flex-1 rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700"
          data-calendar-event-panel
          aria-live="polite"
        >
          <p class="text-xs font-medium uppercase tracking-wide text-gray-500">Événement</p>
          <p class="mt-1 font-medium text-gray-900" data-calendar-event-title>
            Sélectionnez un jour marqué
          </p>
          <p class="mt-1 font-mono text-xs text-gray-500" data-calendar-event-date></p>
          <ul class="mt-3 space-y-1 text-xs text-gray-500">
            <li>• Point = jour avec événement</li>
            <li>• Week-ends en gris</li>
            <li>• Jours sans événement désactivés</li>
          </ul>
        </aside>
      </div>

      <p class="rounded-lg bg-gray-50 px-3 py-2 font-mono text-sm text-gray-800">
        Selection&nbsp;:&nbsp;<span data-calendar-output="events" class="font-medium text-gray-900">Aucune date</span>
      </p>
    </div>
  </section>
</div>

<script>
  import { EVENTS } from '@agencecinq/utils';
  import { dateFromDay, dayFromDate } from '@agencecinq/calendar';

  const emptyLabels = {
    single: 'Aucune date',
    range: 'Aucune date',
    multiple: 'Aucune date',
    preselected: 'Aucune date',
    future: 'Aucune date',
    locale: 'Aucune date',
    events: 'Aucune date',
  };

  document.querySelectorAll('[data-calendar-demo]').forEach((el) => {
    const key = el.getAttribute('data-calendar-demo');
    const output = document.querySelector(`[data-calendar-output="${key}"]`);

    el.addEventListener(EVENTS.CALENDAR_CHANGE, (event) => {
      const { values } = event.detail;
      if (!output) return;
      if (!values.length) {
        output.textContent = emptyLabels[key] ?? '-';
        return;
      }
      output.textContent =
        key === 'multiple' ? values.join(', ') : values.join(' to ');
    });
  });

  const multipleCalendar = document.querySelector('[data-calendar-demo="multiple"]');

  multipleCalendar?.addEventListener(EVENTS.CALENDAR_BEFORE_CHANGE, (event) => {
    if (event.detail.values.length > 3) {
      event.preventDefault();
    }
  });

  const boundsCalendar = document.querySelector('[data-calendar-demo="future"]');
  const today = new Date();
  const inSixtyDays = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 60);

  boundsCalendar?.setAttribute('min', dayFromDate(today));
  boundsCalendar?.setAttribute('max', dayFromDate(inSixtyDays));

  const form = document.querySelector('[data-calendar-form]');
  const formOutput = document.querySelector('[data-calendar-form-output]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (formOutput) {
      formOutput.textContent =
        [...new FormData(form)].map(([key, value]) => `${key}=${value}`).join('&') || '-';
    }
  });

  form?.addEventListener('reset', () => {
    if (formOutput) {
      formOutput.textContent = '-';
    }
  });

  const dialogInput = document.getElementById('docs-calendar-dialog-input');
  const dialog = document.getElementById('docs-calendar-dialog');
  const dialogCalendar = dialog?.querySelector('cinq-calendar');

  dialog?.addEventListener('toggle', ({ newState }) => {
    if (newState !== 'open' || !dialogCalendar) return;

    const value = dialogInput.value;
    const date = value ? dateFromDay(value) : new Date();

    dialogCalendar.current = {
      month: date.getMonth(),
      year: date.getFullYear(),
      day: value || null,
    };
    dialogCalendar.setPicked(value ? [value] : [], false);
    dialogCalendar.render({ focus: true });
  });

  dialogCalendar?.addEventListener(EVENTS.CALENDAR_CHANGE, ({ detail }) => {
    dialogInput.value = detail.values[0] ?? '';
    dialogInput.dispatchEvent(new Event('change', { bubbles: true }));
    dialog.close();
  });

  const markWeekend = (calendar) => {
    const { weekend } = new Intl.Locale(calendar.options.locale).getWeekInfo();

    calendar.querySelectorAll('[data-day]').forEach((button) => {
      // getWeekInfo() counts 1 (Monday) to 7 (Sunday), getDay() 0 (Sunday) to 6.
      const weekday = dateFromDay(button.dataset.day).getDay() || 7;

      button.toggleAttribute('data-weekend', weekend.includes(weekday));
    });
  };

  const localeCalendar = document.querySelector('[data-calendar-demo="locale"]');
  const localeSelect = document.querySelector('[data-calendar-locale-select]');
  const firstDayOutput = document.querySelector('[data-calendar-first-day]');

  localeCalendar?.addEventListener(EVENTS.CALENDAR_RENDER, () => {
    markWeekend(localeCalendar);
  });

  const applyLang = (lang) => {
    if (!localeCalendar) return;

    localeCalendar.lang = lang;
    localeCalendar.dir = new Intl.Locale(lang).getTextInfo().direction;

    if (firstDayOutput) {
      firstDayOutput.textContent = String(localeCalendar.options.firstDay);
    }
  };

  localeSelect?.addEventListener('change', (event) => {
    applyLang(event.target.value);
  });

  if (localeSelect) {
    applyLang(localeSelect.value);
  }

  const eventsCalendar = document.querySelector('[data-calendar-demo="events"]');
  const eventTitle = document.querySelector('[data-calendar-event-title]');
  const eventDate = document.querySelector('[data-calendar-event-date]');

  const dayOffset = (offset) => {
    const date = new Date();
    date.setHours(0, 0, 0, 0);
    date.setDate(date.getDate() + offset);
    return date;
  };

  const events = {
    [dayFromDate(dayOffset(1))]: 'Kick-off projet',
    [dayFromDate(dayOffset(3))]: 'Revue design',
    [dayFromDate(dayOffset(8))]: 'Atelier accessibilité',
    [dayFromDate(dayOffset(12))]: 'Livraison sprint',
  };

  if (eventsCalendar) {
    eventsCalendar.addEventListener(EVENTS.CALENDAR_RENDER, () => {
      markWeekend(eventsCalendar);

      eventsCalendar.querySelectorAll('[data-day]').forEach((button) => {
        const day = button.dataset.day;

        button.innerHTML = `<time datetime="${day}">${button.textContent.trim()}</time>`;

        if (events[day]) {
          button.dataset.hasEvent = '';
          button.title = events[day];
        } else {
          button.setAttribute('aria-disabled', 'true');
        }
      });
    });

    eventsCalendar.addEventListener(EVENTS.CALENDAR_CHANGE, (event) => {
      const day = event.detail.values[0];
      if (!eventTitle || !eventDate) return;

      if (!day || !events[day]) {
        eventTitle.textContent = 'Sélectionnez un jour marqué';
        eventDate.textContent = '';
        return;
      }

      eventTitle.textContent = events[day];
      eventDate.textContent = dateFromDay(day).toLocaleDateString('fr', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
    });

    eventsCalendar.render();
  }
</script>
