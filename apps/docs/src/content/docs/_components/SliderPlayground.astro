    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Encounter builder (advanced)</h3>
          <p class="text-sm text-muted">
            Presets via <code>setValues(..., &#123; emit: false &#125;)</code>, last moved thumb from{' '}
            <code>event.detail.$thumb</code>, and hidden inputs for form submit.
          </p>
        </div>

        <div class="docs-slider-advanced-toolbar">
          <button
            type="button"
            id="docs-slider-advanced-preset-wilderness"
            class="rounded-lg bg-accent-default px-3 py-2 text-sm text-on-accent hover:bg-accent-hover"
          >
            Wilderness skirmish
          </button>
          <button
            type="button"
            id="docs-slider-advanced-preset-dungeon"
            class="rounded-lg bg-surface px-3 py-2 text-sm text-body hover:bg-surface-hover"
          >
            Dungeon delve
          </button>
          <button
            type="button"
            id="docs-slider-advanced-preset-epic"
            class="rounded-lg bg-surface px-3 py-2 text-sm text-body hover:bg-surface-hover"
          >
            Epic showdown
          </button>
          <button
            type="button"
            id="docs-slider-advanced-reset"
            class="rounded-lg border border-default bg-elevated px-3 py-2 text-sm text-body hover:bg-surface"
          >
            Reset band
          </button>
        </div>

        <div class="docs-slider-advanced-layout">
          <div class="flex flex-col gap-4">
            <div class="docs-slider docs-slider--compact">
              <span id="docs-slider-advanced-label" class="docs-slider__label">
                Challenge rating band
              </span>

              <cinq-slider-range
                id="docs-slider-advanced"
                class="docs-slider-rail docs-slider-rail--compact docs-slider-rail--range"
                data-step="1"
                data-page="5"
                aria-labelledby="docs-slider-advanced-label"
              >
                <button
                  type="button"
                  role="slider"
                  tabindex="0"
                  aria-label="Maximum CR"
                  aria-orientation="horizontal"
                  aria-valuemin="0"
                  aria-valuemax="30"
                  aria-valuenow="10"
                  aria-valuetext="CR 10"
                ></button>
                <button
                  type="button"
                  role="slider"
                  tabindex="0"
                  aria-label="Minimum CR"
                  aria-orientation="horizontal"
                  aria-valuemin="0"
                  aria-valuemax="30"
                  aria-valuenow="4"
                  aria-valuetext="CR 4"
                ></button>
              </cinq-slider-range>

              <div class="docs-slider-range-labels" aria-hidden="true">
                <span>CR 0</span>
                <span>CR 30</span>
              </div>
            </div>

            <p class="docs-slider-status">
              Band:{' '}
              <span id="docs-slider-advanced-status" class="font-mono font-medium text-primary">
                CR 4 to CR 10
              </span>
            </p>

            <p class="text-sm text-muted" aria-live="polite">
              Last moved:{' '}
              <span
                id="docs-slider-advanced-active"
                class="font-mono font-medium text-primary"
              >
                -
              </span>
            </p>

            <pre
              id="docs-slider-advanced-log"
              class="docs-slider-advanced-log"
              aria-live="polite"
            >Waiting for slider:change…</pre>
          </div>

          <form id="docs-slider-advanced-form" class="docs-slider-advanced-form">
            <input type="hidden" name="cr_min" id="docs-slider-advanced-min-input" value="4" />
            <input type="hidden" name="cr_max" id="docs-slider-advanced-max-input" value="10" />

            <p class="text-sm text-muted">
              Hidden fields stay in sync with the range. Submit to read <code>FormData</code>.
            </p>

            <button
              type="submit"
              class="self-start rounded-lg bg-accent-default px-4 py-2 text-sm text-on-accent hover:bg-accent-hover"
            >
              Save encounter band
            </button>

            <pre id="docs-slider-advanced-output" class="docs-slider-advanced-output">FormData:
  cr_min=4
  cr_max=10</pre>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import type { Slider, SliderRange } from '@agencecinq/slider';
  import { EVENTS } from '@agencecinq/utils';

  const formatClock = (totalSeconds: number): string => {
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  };

  const formatDurationText = (totalSeconds: number): string => {
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;

    if (m === 0) {
      return s === 1 ? '1 second' : `${s} seconds`;
    }

    if (s === 0) {
      return m === 1 ? '1 minute' : `${m} minutes`;
    }

    const minutePart = m === 1 ? '1 minute' : `${m} minutes`;
    const secondPart = s === 1 ? '1 second' : `${s} seconds`;
    return `${minutePart} ${secondPart}`;
  };

  const ratingText = (value: number): string => {
    if (value === 0) {
      return 'Rate the encounter from 1 to 10, where 10 is a total party kill';
    }

    if (value === 1) {
      return '1, trivial skirmish';
    }

    if (value === 10) {
      return '10, total party kill';
    }

    return `${value} out of 10`;
  };

  const colorPreview = document.getElementById('docs-slider-color-preview');
  const colorHex = document.getElementById('docs-slider-color-hex');

  const readChannel = (channel: string): number => {
    const host = document.getElementById(`docs-slider-color-${channel}`) as Slider | null;
    return host?.value ?? 0;
  };

  const syncColorPreview = () => {
    const r = readChannel('crimson');
    const g = readChannel('verdant');
    const b = readChannel('azure');
    const hex = `#${[r, g, b].map((v) => v.toString(16).padStart(2, '0')).join('')}`;

    if (colorPreview) {
      colorPreview.style.backgroundColor = `rgb(${r} ${g} ${b})`;
    }

    if (colorHex) {
      colorHex.textContent = hex;
    }
  };

  (['crimson', 'verdant', 'azure'] as const).forEach((channel) => {
    const host = document.getElementById(`docs-slider-color-${channel}`) as Slider | null;
    const valueEl = document.getElementById(`docs-slider-color-${channel}-value`);

    if (!host) return;

    host.formatValue = (value) => String(value);

    host.addEventListener(EVENTS.SLIDER_CHANGE, (event) => {
      const { min } = (event as CustomEvent<{ min: number; max: number }>).detail;
      if (valueEl) valueEl.textContent = String(min);
      syncColorPreview();
    });
  });

  syncColorPreview();

  const ratingHost = document.getElementById('docs-slider-rating') as Slider | null;
  const ratingStatus = document.getElementById('docs-slider-rating-status');

  if (ratingHost && ratingStatus) {
    ratingHost.formatValue = ratingText;

    const syncRating = () => {
      ratingStatus.textContent =
        ratingHost.$thumb?.getAttribute('aria-valuetext') ?? '';
    };

    ratingHost.addEventListener(EVENTS.SLIDER_CHANGE, syncRating);
    syncRating();
  }

  const seekHost = document.getElementById('docs-slider-seek') as Slider | null;
  const seekStatus = document.getElementById('docs-slider-seek-status');
  const seekClock = seekHost?.$thumb?.querySelector('[data-seek-value]');

  if (seekHost && seekStatus) {
    seekHost.formatValue = formatDurationText;

    const syncSeek = () => {
      const value = seekHost.value;
      seekStatus.textContent =
        seekHost.$thumb?.getAttribute('aria-valuetext') ?? '';
      if (seekClock instanceof HTMLElement) {
        seekClock.textContent = formatClock(value);
      }
    };

    seekHost.addEventListener(EVENTS.SLIDER_CHANGE, syncSeek);
    syncSeek();
  }

  const rtl = document.getElementById('docs-slider-rtl');
  const rtlValue = document.getElementById('docs-slider-rtl-value');

  rtl?.addEventListener(EVENTS.SLIDER_CHANGE, (event) => {
    const { min } = (event as CustomEvent<{ min: number; max: number }>).detail;
    if (rtlValue) rtlValue.textContent = `${min}%`;
  });

  const priceHost = document.getElementById('docs-slider-price') as SliderRange | null;
  const priceStatus = document.getElementById('docs-slider-price-status');

  if (priceHost && priceStatus) {
    priceHost.formatValue = (value) => `${value} gp`;

    const syncPrice = () => {
      priceStatus.textContent = `${priceHost.min} gp to ${priceHost.max} gp`;
    };

    priceHost.addEventListener(EVENTS.SLIDER_CHANGE, syncPrice);
    syncPrice();
  }

  const PARTY_TOTAL = 1000;

  const partyPaladin = document.getElementById(
    'docs-slider-party-paladin',
  ) as Slider | null;
  const partyCleric = document.getElementById(
    'docs-slider-party-cleric',
  ) as Slider | null;
  const partyRogue = document.getElementById('docs-slider-party-rogue') as Slider | null;
  const partyStatus = document.getElementById('docs-slider-party-status');
  const partyPaladinValue = document.getElementById('docs-slider-party-paladin-value');
  const partyClericValue = document.getElementById('docs-slider-party-cleric-value');
  const partyRogueValue = document.getElementById('docs-slider-party-rogue-value');

  if (
    partyPaladin &&
    partyCleric &&
    partyRogue &&
    partyStatus &&
    partyPaladinValue &&
    partyClericValue &&
    partyRogueValue
  ) {
    const formatGp = (value: number) => `${value} gp`;

    partyPaladin.formatValue = formatGp;
    partyCleric.formatValue = formatGp;
    partyRogue.formatValue = formatGp;

    const shares = { paladin: 300, cleric: 350, rogue: 350 };

    type PartyMember = keyof typeof shares;

    const takeOrder: Record<PartyMember, PartyMember[]> = {
      paladin: ['rogue', 'cleric'],
      cleric: ['rogue', 'paladin'],
      rogue: ['cleric', 'paladin'],
    };

    const hosts: Record<PartyMember, Slider> = {
      paladin: partyPaladin,
      cleric: partyCleric,
      rogue: partyRogue,
    };

    const setShare = (who: PartyMember, next: number) => {
      next = Math.max(0, Math.min(PARTY_TOTAL, next));
      const delta = next - shares[who];

      shares[who] = next;

      if (delta === 0) {
        return;
      }

      if (delta > 0) {
        let remaining = delta;

        for (const other of takeOrder[who]) {
          const take = Math.min(remaining, shares[other]);
          shares[other] -= take;
          remaining -= take;

          if (remaining === 0) {
            break;
          }
        }

        if (remaining > 0) {
          shares[who] -= remaining;
        }
      } else {
        shares.rogue += -delta;
      }

      const overflow =
        shares.paladin + shares.cleric + shares.rogue - PARTY_TOTAL;

      if (overflow > 0) {
        shares.rogue = Math.max(0, shares.rogue - overflow);
      }

      const under =
        PARTY_TOTAL - shares.paladin - shares.cleric - shares.rogue;

      if (under > 0) {
        shares.rogue += under;
      }
    };

    const syncPartySplit = () => {
      for (const member of ['paladin', 'cleric', 'rogue'] as const) {
        hosts[member].setValue(shares[member], { emit: false });
      }

      partyPaladinValue.textContent = String(shares.paladin);
      partyClericValue.textContent = String(shares.cleric);
      partyRogueValue.textContent = String(shares.rogue);

      partyStatus.textContent = `${shares.paladin} + ${shares.cleric} + ${shares.rogue} = ${PARTY_TOTAL} gp`;
    };

    for (const member of ['paladin', 'cleric', 'rogue'] as const) {
      hosts[member].addEventListener(EVENTS.SLIDER_CHANGE, (event) => {
        const { min } = (event as CustomEvent<{ min: number }>).detail;
        setShare(member, min);
        syncPartySplit();
      });
    }

    syncPartySplit();
  }

  const budgetHost = document.getElementById('docs-slider-budget') as SliderRange | null;
  const budgetStatus = document.getElementById('docs-slider-budget-status');

  if (budgetHost && budgetStatus) {
    budgetHost.formatValue = (value) => `${value} gp`;

    const syncBudget = () => {
      budgetStatus.textContent = `${budgetHost.min} gp to ${budgetHost.max} gp`;
    };

    budgetHost.addEventListener(EVENTS.SLIDER_CHANGE, syncBudget);
    syncBudget();
  }

  const tempHost = document.getElementById('docs-slider-temp') as Slider | null;
  const tempStatus = document.getElementById('docs-slider-temp-status');

  if (tempHost && tempStatus) {
    tempHost.formatValue = (value) => `Potency ${value} out of 10`;

    const syncTemp = () => {
      tempStatus.textContent =
        tempHost.$thumb?.getAttribute('aria-valuetext') ?? '';
    };

    tempHost.addEventListener(EVENTS.SLIDER_CHANGE, syncTemp);
    syncTemp();
  }

  const tempRangeHost = document.getElementById(
    'docs-slider-temp-range',
  ) as SliderRange | null;
  const tempRangeStatus = document.getElementById('docs-slider-temp-range-status');

  if (tempRangeHost && tempRangeStatus) {
    tempRangeHost.formatValue = (value) =>
      value === 1 ? '1 hit point' : `${value} hit points`;

    const syncTempRange = () => {
      tempRangeStatus.textContent = `${tempRangeHost.min} HP to ${tempRangeHost.max} HP`;
    };

    tempRangeHost.addEventListener(EVENTS.SLIDER_CHANGE, syncTempRange);
    syncTempRange();
  }

  const advancedHost = document.getElementById(
    'docs-slider-advanced',
  ) as SliderRange | null;
  const advancedStatus = document.getElementById('docs-slider-advanced-status');
  const advancedActive = document.getElementById('docs-slider-advanced-active');
  const advancedLog = document.getElementById('docs-slider-advanced-log');
  const advancedForm = document.getElementById(
    'docs-slider-advanced-form',
  ) as HTMLFormElement | null;
  const advancedOutput = document.getElementById('docs-slider-advanced-output');
  const advancedMinInput = document.getElementById(
    'docs-slider-advanced-min-input',
  ) as HTMLInputElement | null;
  const advancedMaxInput = document.getElementById(
    'docs-slider-advanced-max-input',
  ) as HTMLInputElement | null;
  const advancedPresetWilderness = document.getElementById(
    'docs-slider-advanced-preset-wilderness',
  );
  const advancedPresetDungeon = document.getElementById(
    'docs-slider-advanced-preset-dungeon',
  );
  const advancedPresetEpic = document.getElementById('docs-slider-advanced-preset-epic');
  const advancedReset = document.getElementById('docs-slider-advanced-reset');

  if (
    advancedHost &&
    advancedStatus &&
    advancedActive &&
    advancedLog &&
    advancedForm &&
    advancedOutput &&
    advancedMinInput &&
    advancedMaxInput
  ) {
    const logLines: string[] = [];
    const defaultBand = { min: 4, max: 10 };

    advancedHost.formatValue = (value) => `CR ${value}`;

    const formatBand = (min: number, max: number) => `CR ${min} to CR ${max}`;

    const thumbLabel = ($thumb: HTMLElement) => {
      if ($thumb === advancedHost.$min) return 'min';
      if ($thumb === advancedHost.$max) return 'max';
      return 'unknown';
    };

    const appendLog = (line: string) => {
      logLines.unshift(line);
      if (5 < logLines.length) logLines.length = 5;
      advancedLog.textContent = logLines.join('\n');
    };

    const syncHiddenInputs = () => {
      advancedMinInput.value = String(advancedHost.min);
      advancedMaxInput.value = String(advancedHost.max);
    };

    const formatFormData = () => {
      const data = new FormData(advancedForm);
      const lines = ['FormData:'];
      data.forEach((value, key) => {
        lines.push(`  ${key}=${value}`);
      });
      return lines.join('\n');
    };

    const writeOutput = (message: string) => {
      advancedOutput.textContent = `${message}\n\n${formatFormData()}`;
    };

    const syncBandDisplay = () => {
      advancedStatus.textContent = formatBand(advancedHost.min, advancedHost.max);
      syncHiddenInputs();
    };

    const applyPreset = (min: number, max: number, label: string) => {
      advancedHost.setValues(min, max, { active: 'min', emit: false });
      syncBandDisplay();
      appendLog(`preset "${label}" via setValues(..., { emit: false })`);
      writeOutput(`Preset loaded: ${label}. No slider:change fired.`);
    };

    advancedHost.addEventListener(EVENTS.SLIDER_CHANGE, (event) => {
      const { min, max, $thumb } = (
        event as CustomEvent<{ min: number; max: number; $thumb: HTMLElement }>
      ).detail;
      const which = thumbLabel($thumb);

      advancedActive.textContent = `${which} thumb (${formatBand(min, max)})`;
      appendLog(`slider:change — ${which} → CR ${min}–${max}`);
      syncBandDisplay();
    });

    advancedPresetWilderness?.addEventListener('click', () => {
      applyPreset(0, 3, 'Wilderness skirmish');
    });

    advancedPresetDungeon?.addEventListener('click', () => {
      applyPreset(4, 10, 'Dungeon delve');
    });

    advancedPresetEpic?.addEventListener('click', () => {
      applyPreset(15, 20, 'Epic showdown');
    });

    advancedReset?.addEventListener('click', () => {
      advancedHost.setValues(defaultBand.min, defaultBand.max, {
        active: 'min',
        emit: true,
      });
      writeOutput('Band reset to defaults.');
    });

    advancedForm.addEventListener('submit', (event) => {
      event.preventDefault();
      syncHiddenInputs();
      writeOutput('Form submitted with current hidden fields.');
    });

    syncBandDisplay();
    writeOutput('Adjust the band or load a preset.');
  }
</script>
