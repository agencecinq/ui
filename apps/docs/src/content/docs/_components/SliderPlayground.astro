---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-slider {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .docs-slider__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .docs-slider__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-color-primary);
  }

  .docs-slider__value {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-color-body);
    font-variant-numeric: tabular-nums;
  }

  .docs-slider-rail {
    position: relative;
    width: 100%;
    block-size: 2.75rem;
    touch-action: none;
    user-select: none;
    --docs-slider-thumb: 2.75rem;
  }

  .docs-slider-rail--compact {
    --docs-slider-thumb: 1rem;
  }

  .docs-slider-rail--seek {
    --docs-slider-thumb: 0.875rem;
    block-size: 4.5rem;
  }

  .docs-slider-rail::before {
    content: '';
    position: absolute;
    inset-inline: calc(var(--docs-slider-thumb) / 2);
    top: 50%;
    block-size: 0.375rem;
    border-radius: 9999px;
    background: var(--background-color-surface-hover);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .docs-slider-rail::after {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--docs-slider-thumb) / 2);
    top: 50%;
    width: calc(var(--ratio) * (100% - var(--docs-slider-thumb)));
    block-size: 0.375rem;
    border-radius: 9999px;
    background: var(--color-accent-default);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .docs-slider-rail [role='slider'] {
    position: absolute;
    top: calc(50% - var(--docs-slider-thumb) / 2);
    z-index: 1;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: grab;
    touch-action: none;
  }

  .docs-slider-rail:not(.docs-slider-rail--range) [role='slider'] {
    inset-inline-start: calc(var(--ratio) * (100% - var(--docs-slider-thumb)));
  }

  .docs-slider-rail--range [role='slider']:first-child {
    inset-inline-start: calc(var(--max-ratio) * (100% - var(--docs-slider-thumb)));
    z-index: 2;
  }

  .docs-slider-rail--range [role='slider']:last-child {
    inset-inline-start: calc(var(--min-ratio) * (100% - var(--docs-slider-thumb)));
  }

  .docs-slider-rail--range[data-active='min'] [role='slider']:last-child {
    z-index: 3;
  }

  .docs-slider-rail--range[data-active='max'] [role='slider']:first-child {
    z-index: 3;
  }

  /* Collapsed (min === max): offset min on the low side so both handles stay visible. */
  .docs-slider-rail--range[data-collapsed] [role='slider']:last-child {
    inset-inline-start: calc(
      var(--min-ratio) * (100% - var(--docs-slider-thumb)) - var(--docs-slider-thumb)
    );
  }

  [dir='rtl'] .docs-slider-rail--range[data-collapsed] [role='slider']:last-child {
    inset-inline-start: calc(
      var(--min-ratio) * (100% - var(--docs-slider-thumb)) + var(--docs-slider-thumb)
    );
  }

  .docs-slider-rail--vertical.docs-slider-rail--range[data-collapsed] [role='slider']:last-child {
    inset-block-end: calc(
      var(--min-ratio) * (100% - var(--docs-slider-thumb)) - var(--docs-slider-thumb)
    );
  }

  .docs-slider-rail--seek [role='slider'] {
    top: calc(50% - 1.5rem);
    width: var(--docs-slider-thumb);
    height: 3rem;
    border-radius: 0.3125rem;
    background: var(--background-color-elevated);
    border: 2px solid var(--border-color-accent);
    box-shadow: 0 1px 3px rgb(0 0 0 / 12%);
  }

  .docs-slider-rail [role='slider']:active,
  .docs-slider-rail[dragging] [role='slider'] {
    cursor: grabbing;
  }

  .docs-slider-rail--compact [role='slider'] {
    width: var(--docs-slider-thumb);
    height: var(--docs-slider-thumb);
    border-radius: 50%;
    background: var(--background-color-elevated);
    border: 2px solid var(--border-color-accent);
    box-shadow: 0 1px 3px rgb(0 0 0 / 12%);
  }

  .docs-slider-rail [role='slider']:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  .docs-slider-rail--range [role='slider']:focus-visible {
    z-index: 4;
  }

  .docs-slider-rail--seek [data-seek-value] {
    position: absolute;
    inset-inline-start: 50%;
    top: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-color-primary);
    pointer-events: none;
    white-space: nowrap;
    transform: translate(-50%, calc(-100% - 0.35rem));
  }

  .docs-slider-seek-ticks {
    display: flex;
    justify-content: space-between;
    margin-block-start: 0.35rem;
    padding-inline: calc(var(--docs-slider-thumb) / 2);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    color: var(--text-color-muted);
    list-style: none;
  }

  .docs-slider-color {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .docs-slider-color {
      grid-template-columns: 5rem 1fr;
      align-items: start;
    }
  }

  .docs-slider-color__preview {
    aspect-ratio: 1;
    width: 100%;
    max-width: 5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-color-default);
    background: rgb(128 64 32);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 5%);
  }

  .docs-slider-color__channels {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .docs-slider-rating-scale {
    display: flex;
    justify-content: space-between;
    padding-inline: calc(var(--docs-slider-thumb) / 2);
    font-size: 0.6875rem;
    color: var(--text-color-muted);
  }

  .docs-slider-status {
    font-size: 0.875rem;
    color: var(--text-color-body);
    border: 1px solid var(--border-color-default);
    border-radius: 0.5rem;
    background: var(--background-color-surface);
    padding: 0.5rem 0.75rem;
  }

  .docs-slider-status code {
    font-size: 0.8125rem;
  }

  .docs-slider--compact {
    --docs-slider-thumb: 1rem;
  }

  .docs-slider--seek {
    --docs-slider-thumb: 0.875rem;
  }

  .docs-slider-rail--range::after {
    inset-inline-start: calc(
      var(--docs-slider-thumb) / 2 + var(--min-ratio) * (100% - var(--docs-slider-thumb))
    );
    width: calc(
      (var(--max-ratio) - var(--min-ratio)) * (100% - var(--docs-slider-thumb))
    );
    border-radius: 0;
  }

  .docs-slider-range-labels {
    display: flex;
    justify-content: space-between;
    padding-inline: calc(var(--docs-slider-thumb) / 2);
    font-size: 0.6875rem;
    color: var(--text-color-muted);
  }

  .docs-slider-step-ticks {
    display: flex;
    justify-content: space-between;
    margin-block-start: 0.35rem;
    padding-inline: calc(var(--docs-slider-thumb) / 2);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    color: var(--text-color-muted);
    list-style: none;
  }

  .docs-slider-vertical {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .docs-slider-rail--vertical {
    width: var(--docs-slider-thumb);
    height: 14rem;
    flex-shrink: 0;
  }

  .docs-slider-rail--vertical::before {
    inset-inline: auto;
    inset-block: calc(var(--docs-slider-thumb) / 2);
    inset-inline-start: 50%;
    top: calc(var(--docs-slider-thumb) / 2);
    bottom: calc(var(--docs-slider-thumb) / 2);
    left: 50%;
    width: 0.375rem;
    height: auto;
    transform: translateX(-50%);
  }

  .docs-slider-rail--vertical::after {
    inset-inline-start: 50%;
    inset-block-start: auto;
    inset-block-end: calc(var(--docs-slider-thumb) / 2);
    top: auto;
    left: 50%;
    width: 0.375rem;
    height: calc(var(--ratio) * (100% - var(--docs-slider-thumb)));
    transform: translateX(-50%);
    border-radius: 9999px;
  }

  .docs-slider-rail--vertical:not(.docs-slider-rail--range) [role='slider'] {
    inset-inline-start: calc(50% - var(--docs-slider-thumb) / 2);
    inset-block-start: auto;
    inset-block-end: calc(var(--ratio) * (100% - var(--docs-slider-thumb)));
    top: auto;
    width: var(--docs-slider-thumb);
    height: var(--docs-slider-thumb);
  }

  .docs-slider-rail--vertical.docs-slider-rail--range [role='slider']:first-child {
    inset-inline-start: calc(50% - var(--docs-slider-thumb) / 2);
    inset-block-start: auto;
    inset-block-end: calc(var(--max-ratio) * (100% - var(--docs-slider-thumb)));
    top: auto;
  }

  .docs-slider-rail--vertical.docs-slider-rail--range [role='slider']:last-child {
    inset-inline-start: calc(50% - var(--docs-slider-thumb) / 2);
    inset-block-start: auto;
    inset-block-end: calc(var(--min-ratio) * (100% - var(--docs-slider-thumb)));
    top: auto;
  }

  .docs-slider-rail--vertical.docs-slider-rail--range::after {
    inset-block-end: calc(
      var(--docs-slider-thumb) / 2 + var(--min-ratio) * (100% - var(--docs-slider-thumb))
    );
    height: calc(
      (var(--max-ratio) - var(--min-ratio)) * (100% - var(--docs-slider-thumb))
    );
    border-radius: 0;
  }

  .docs-slider-rail--vertical.docs-slider-rail--range [role='slider']:first-child {
    z-index: 2;
  }

  .docs-slider-vertical-ticks {
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    height: 14rem;
    padding-block: calc(var(--docs-slider-thumb) / 2);
    margin: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--text-color-muted);
    font-variant-numeric: tabular-nums;
  }

  .docs-slider-advanced-layout {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .docs-slider-advanced-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
      align-items: start;
    }
  }

  .docs-slider-advanced-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .docs-slider-advanced-log {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--border-color-default);
    border-radius: 0.5rem;
    background: var(--background-color-surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--text-color-body);
    max-height: 10rem;
    overflow: auto;
    white-space: pre-wrap;
  }

  .docs-slider-advanced-output {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--border-color-default);
    border-radius: 0.5rem;
    background: var(--color-accent-default);
    color: var(--text-color-on-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6875rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .docs-slider-advanced-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .docs-slider-party-split {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .docs-slider-party-split__total {
    font-size: 0.75rem;
    color: var(--text-color-muted);
  }
</style>

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Tabard colors</h3>
          <p class="text-sm text-muted">
            Three sliders mix crimson, verdant, and azure dye for your character token.
          </p>
        </div>

        <div class="docs-slider-color">
          <div
            id="docs-slider-color-preview"
            class="docs-slider-color__preview"
            aria-hidden="true"
          ></div>

          <div class="docs-slider-color__channels">
            {
              [
                ['Crimson', 'crimson', 128],
                ['Verdant', 'verdant', 64],
                ['Azure', 'azure', 32],
              ].map(([label, channel, initial]) => (
                <div class="docs-slider">
                  <div class="docs-slider__header">
                    <span id={`docs-slider-color-${channel}-label`} class="docs-slider__label">
                      {label}
                    </span>
                    <span
                      id={`docs-slider-color-${channel}-value`}
                      class="docs-slider__value"
                      aria-hidden="true"
                    >
                      {initial}
                    </span>
                  </div>
                  <cinq-slider
                    id={`docs-slider-color-${channel}`}
                    class="docs-slider-rail docs-slider-rail--compact"
                    data-channel={channel}
                  >
                    <button
                      type="button"
                      role="slider"
                      tabindex="0"
                      aria-labelledby={`docs-slider-color-${channel}-label`}
                      aria-orientation="horizontal"
                      aria-valuemin="0"
                      aria-valuemax="255"
                      aria-valuenow={initial}
                      aria-valuetext={`${initial}`}
                    ></button>
                  </cinq-slider>
                </div>
              ))
            }
          </div>
        </div>

        <p class="docs-slider-status">
          Heraldry preview:{' '}
          <span id="docs-slider-color-hex" class="font-mono font-medium text-primary">
            #804020
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Encounter difficulty</h3>
          <p class="text-sm text-muted">
            Rate the last fight from 0 to 10 with readable <code>aria-valuetext</code>.
          </p>
        </div>

        <div class="docs-slider docs-slider--compact">
          <label id="docs-slider-rating-label" class="docs-slider__label">
            How deadly was this encounter?
          </label>

          <cinq-slider
            id="docs-slider-rating"
            class="docs-slider-rail docs-slider-rail--compact"
            data-step="1"
            data-page="2"
          >
            <button
              type="button"
              role="slider"
              tabindex="0"
              aria-labelledby="docs-slider-rating-label"
              aria-orientation="horizontal"
              aria-valuemin="0"
              aria-valuemax="10"
              aria-valuenow="0"
              aria-valuetext="Rate the encounter from 1 to 10, where 10 is a total party kill"
            ></button>
          </cinq-slider>

          <div class="docs-slider-rating-scale" aria-hidden="true">
            <span>1 Trivial skirmish</span>
            <span>10 Total party kill</span>
          </div>
        </div>

        <p class="docs-slider-status">
          <code>aria-valuetext</code>:{' '}
          <span id="docs-slider-rating-status" class="font-mono font-medium text-primary">
            Rate the encounter from 1 to 10, where 10 is a total party kill
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Battle replay</h3>
          <p class="text-sm text-muted">
            Scrub through a five-minute combat log. Values read as minutes and seconds.
          </p>
        </div>

        <div class="docs-slider docs-slider--seek">
          <span id="docs-slider-seek-label" class="docs-slider__label">Round timeline</span>

          <cinq-slider
            id="docs-slider-seek"
            class="docs-slider-rail docs-slider-rail--seek"
            data-step="1"
            data-page="15"
          >
            <button
              type="button"
              role="slider"
              tabindex="0"
              aria-labelledby="docs-slider-seek-label"
              aria-orientation="horizontal"
              aria-valuemin="0"
              aria-valuemax="300"
              aria-valuenow="90"
              aria-valuetext="1 minute 30 seconds"
            >
              <span data-seek-value aria-hidden="true">1:30</span>
            </button>
          </cinq-slider>

          <ol class="docs-slider-seek-ticks" aria-hidden="true">
            <li>0:00</li>
            <li>1:00</li>
            <li>2:00</li>
            <li>3:00</li>
            <li>4:00</li>
            <li>5:00</li>
          </ol>
        </div>

        <p class="docs-slider-status">
          <code>aria-valuetext</code>:{' '}
          <span id="docs-slider-seek-status" class="font-mono font-medium text-primary">
            1 minute 30 seconds
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Loot split</h3>
          <p class="text-sm text-muted">
            Two thumbs pick a gold piece range for the party treasury split. Tab between handles.
            Arrow keys move the focused one.
          </p>
        </div>

        <div class="docs-slider docs-slider--compact">
          <span id="docs-slider-price-label" class="docs-slider__label">Treasure share (gp)</span>

          <cinq-slider-range
            id="docs-slider-price"
            class="docs-slider-rail docs-slider-rail--compact docs-slider-rail--range"
            data-step="10"
            data-page="50"
            aria-labelledby="docs-slider-price-label"
          >
            <button
              type="button"
              role="slider"
              tabindex="0"
              aria-label="Maximum share"
              aria-orientation="horizontal"
              aria-valuemin="100"
              aria-valuemax="1000"
              aria-valuenow="800"
              aria-valuetext="800 gp"
            ></button>
            <button
              type="button"
              role="slider"
              tabindex="0"
              aria-label="Minimum share"
              aria-orientation="horizontal"
              aria-valuemin="100"
              aria-valuemax="1000"
              aria-valuenow="200"
              aria-valuetext="200 gp"
            ></button>
          </cinq-slider-range>

          <div class="docs-slider-range-labels" aria-hidden="true">
            <span>100 gp</span>
            <span>1000 gp</span>
          </div>
        </div>

        <p class="docs-slider-status">
          Split:{' '}
          <span id="docs-slider-price-status" class="font-mono font-medium text-primary">
            200 gp to 800 gp
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Party loot (1000 gp)</h3>
          <p class="text-sm text-muted">
            Split a fixed 1000 gp treasury between three characters. Each slider is that
            hero&apos;s share. The three values always sum to 1000 (app code on{' '}
            <code>slider:change</code> takes from the others when one share grows).
          </p>
        </div>

        <div class="docs-slider-party-split">
          <div class="docs-slider docs-slider--compact">
            <div class="docs-slider__header">
              <label id="docs-slider-party-paladin-label" class="docs-slider__label">
                Paladin share
              </label>
              <span
                id="docs-slider-party-paladin-value"
                class="docs-slider__value"
                aria-hidden="true"
              >
                300
              </span>
            </div>
            <cinq-slider
              id="docs-slider-party-paladin"
              class="docs-slider-rail docs-slider-rail--compact"
              data-step="25"
              data-page="100"
            >
              <button
                type="button"
                role="slider"
                tabindex="0"
                aria-labelledby="docs-slider-party-paladin-label"
                aria-orientation="horizontal"
                aria-valuemin="0"
                aria-valuemax="1000"
                aria-valuenow="300"
                aria-valuetext="300 gp"
              ></button>
            </cinq-slider>
          </div>

          <div class="docs-slider docs-slider--compact">
            <div class="docs-slider__header">
              <label id="docs-slider-party-cleric-label" class="docs-slider__label">
                Cleric share
              </label>
              <span
                id="docs-slider-party-cleric-value"
                class="docs-slider__value"
                aria-hidden="true"
              >
                350
              </span>
            </div>
            <cinq-slider
              id="docs-slider-party-cleric"
              class="docs-slider-rail docs-slider-rail--compact"
              data-step="25"
              data-page="100"
            >
              <button
                type="button"
                role="slider"
                tabindex="0"
                aria-labelledby="docs-slider-party-cleric-label"
                aria-orientation="horizontal"
                aria-valuemin="0"
                aria-valuemax="1000"
                aria-valuenow="350"
                aria-valuetext="350 gp"
              ></button>
            </cinq-slider>
          </div>

          <div class="docs-slider docs-slider--compact">
            <div class="docs-slider__header">
              <label id="docs-slider-party-rogue-label" class="docs-slider__label">
                Rogue share
              </label>
              <span
                id="docs-slider-party-rogue-value"
                class="docs-slider__value"
                aria-hidden="true"
              >
                350
              </span>
            </div>
            <cinq-slider
              id="docs-slider-party-rogue"
              class="docs-slider-rail docs-slider-rail--compact"
              data-step="25"
              data-page="100"
            >
              <button
                type="button"
                role="slider"
                tabindex="0"
                aria-labelledby="docs-slider-party-rogue-label"
                aria-orientation="horizontal"
                aria-valuemin="0"
                aria-valuemax="1000"
                aria-valuenow="350"
                aria-valuetext="350 gp"
              ></button>
            </cinq-slider>
          </div>

          <p class="docs-slider-party-split__total" aria-hidden="true">
            Total treasury: 1000 gp
          </p>
        </div>

        <p class="docs-slider-status">
          Split:{' '}
          <span id="docs-slider-party-status" class="font-mono font-medium text-primary">
            300 + 350 + 350 = 1000 gp
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Party treasury</h3>
          <p class="text-sm text-muted">
            Multi-thumb range with <code>data-step="50"</code>. Gold snaps on pointer, keyboard, and
