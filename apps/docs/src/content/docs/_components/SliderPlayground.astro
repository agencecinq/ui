        <div class="docs-slider docs-slider--compact">
          <span id="docs-slider-temp-range-label" class="docs-slider__label">
            Target HP band
          </span>

          <div class="docs-slider-vertical">
            <cinq-slider-range
              id="docs-slider-temp-range"
              class="docs-slider-rail docs-slider-rail--compact docs-slider-rail--vertical docs-slider-rail--range"
              data-step="1"
              data-page="3"
              aria-labelledby="docs-slider-temp-range-label"
            >
              <button
                type="button"
                role="slider"
                tabindex="0"
                aria-label="Maximum target HP"
                aria-orientation="vertical"
                aria-valuemin="0"
                aria-valuemax="40"
                aria-valuenow="26"
                aria-valuetext="26 hit points"
              ></button>
              <button
                type="button"
                role="slider"
                tabindex="0"
                aria-label="Minimum target HP"
                aria-orientation="vertical"
                aria-valuemin="0"
                aria-valuemax="40"
                aria-valuenow="18"
                aria-valuetext="18 hit points"
              ></button>
            </cinq-slider-range>

            <ol class="docs-slider-vertical-ticks" aria-hidden="true">
              <li>0 HP</li>
              <li>20 HP</li>
              <li>30 HP</li>
              <li>40 HP</li>
            </ol>
          </div>
        </div>

        <p class="docs-slider-status">
          Band:{' '}
          <span id="docs-slider-temp-range-status" class="font-mono font-medium text-primary">
            18 HP to 26 HP
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default" dir="rtl">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Underdark torch</h3>
          <p class="text-sm text-muted">
            Horizontal slider with <code>dir="rtl"</code>. Pointer and arrow keys mirror on the
            rail.
          </p>
        </div>

        <div class="docs-slider">
          <div class="docs-slider__header">
            <label id="docs-slider-rtl-label" class="docs-slider__label">
              Torch brightness
            </label>
            <span id="docs-slider-rtl-value" class="docs-slider__value" aria-hidden="true">
              60%
            </span>
          </div>

          <cinq-slider
            id="docs-slider-rtl"
            dir="rtl"
            class="docs-slider-rail docs-slider-rail--compact"
          >
            <button
              type="button"
              role="slider"
              tabindex="0"
              aria-labelledby="docs-slider-rtl-label"
              aria-orientation="horizontal"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="60"
              aria-valuetext="60%"
            ></button>
          </cinq-slider>
        </div>
