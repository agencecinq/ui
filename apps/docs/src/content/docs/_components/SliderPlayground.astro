          <ol class="docs-slider-step-ticks" aria-hidden="true">
            <li>0 gp</li>
            <li>50 gp</li>
            <li>100 gp</li>
            <li>150 gp</li>
            <li>200 gp</li>
            <li>250 gp</li>
            <li>300 gp</li>
            <li>350 gp</li>
            <li>400 gp</li>
            <li>450 gp</li>
            <li>500 gp</li>
