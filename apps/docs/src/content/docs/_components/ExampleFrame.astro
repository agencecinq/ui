---
type Props = {
  /** Path of a page under `src/pages/examples/`, without the base. */
  path: string;
  title: string;
};

const { path, title } = Astro.props;
const src = `${import.meta.env.BASE_URL}examples/${path}/`;
---

<div class="not-content flex flex-col items-center gap-3">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    class="h-[46rem] w-full max-w-[24.375rem] rounded-[2rem] border border-default bg-white shadow-xl"
  ></iframe>
  <a href={src} class="text-sm underline underline-offset-4">Open the example in a new tab</a>
</div>
