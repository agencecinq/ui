---
import RegisterComponents from "./RegisterComponents.astro";

const colors = [
  { name: "Moss", value: "#7a8b5c" },
  { name: "Dusk", value: "#8fa6bf" },
  { name: "Ash", value: "#b9b4ab" },
  { name: "Ember", value: "#c26a5a" },
];

const sizes = [
  { name: "Halfling", soldOut: false },
  { name: "Gnome", soldOut: false },
  { name: "Elf", soldOut: false },
  { name: "Human", soldOut: false },
  { name: "Ogre", soldOut: true },
];

const selectedColor = colors[1];
---

<RegisterComponents />

<style>
  #cloak-sheet-demo dialog {
    translate: 0 max(-1rem, var(--cinq-sheet-drag-offset, 0px));
    transition:
      translate 300ms ease-out,
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }

  #cloak-sheet-demo dialog:not([open]) {
    translate: 0 100%;
  }

  #cloak-sheet-demo dialog::backdrop {
    background-color: rgb(23 23 23 / 0.3);
    transition:
      background-color 300ms ease-out,
      display 300ms allow-discrete,
      overlay 300ms allow-discrete;
  }

  #cloak-sheet-demo dialog:not([open])::backdrop {
    background-color: transparent;
  }

  @starting-style {
    #cloak-sheet-demo dialog[open] {
      translate: 0 100%;
    }

    #cloak-sheet-demo dialog[open]::backdrop {
      background-color: transparent;
    }
  }

  #cloak-sheet-demo[dragging] dialog {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #cloak-sheet-demo dialog,
    #cloak-sheet-demo dialog::backdrop {
      transition: none;
    }
  }
</style>

<div class="not-content flex justify-center">
  <div
    class="relative flex h-[34rem] w-full max-w-[24.375rem] flex-col overflow-hidden rounded-[2rem] border border-[#e9e9e9] bg-[#efece6] text-[#2a343a] shadow-xl"
  >
    <div class="flex flex-1 items-center justify-center p-8 text-center">
      <p class="font-serif text-sm italic opacity-60">
        Imagine a cloak hanging in a dim elven boutique.
      </p>
    </div>

    <div class="flex flex-col gap-3 border-t border-[#e9e9e9] bg-white px-5 pt-2 pb-5">
      <cinq-sheet-button class="flex justify-center">
        <button
          class="flex w-full cursor-grab touch-none justify-center py-1 active:cursor-grabbing focus-visible:outline-2 focus-visible:outline-[#171717]"
          aria-controls="cloak-sheet-demo"
          aria-expanded="false"
          aria-label="Show sizes"
        >
          <span class="h-0.75 w-9 rounded-full bg-[#e9e9e9]"></span>
        </button>
      </cinq-sheet-button>

      <div class="flex items-center justify-between gap-3">
        <p class="font-serif text-[0.984rem] leading-snug italic">Cloak of Elvenkind</p>
        <button class="text-lg leading-none" aria-label="Add to wishlist">&#9825;</button>
      </div>

      <div class="flex items-center justify-between gap-3">
        <p class="text-[0.844rem]">6 000 gp</p>
        <ul class="flex items-center gap-3" aria-label="Colors">
          {colors.map((color) => (
            <li
              class:list={[
                "rounded-full border border-[#e9e9e9]",
                color === selectedColor ? "size-5.5 p-0.5 ring-1 ring-[#2a343a] ring-inset" : "size-4",
              ]}
            >
              <span class="block size-full rounded-full" style={`background: ${color.value}`}></span>
              <span class="sr-only">{color.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <cinq-sheet-button class="block">
        <button
          data-dom="summary"
          class="h-11.25 w-full bg-[#171717] text-[0.844rem] text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#171717]"
          aria-controls="cloak-sheet-demo"
          aria-expanded="false"
        >
          Select a size
        </button>
      </cinq-sheet-button>
    </div>
  </div>

  <cinq-sheet id="cloak-sheet-demo" class="contents">
    <dialog
      aria-labelledby="cloak-sheet-title"
      class="fixed inset-x-[max(0px,calc(50%-12.1875rem))] top-auto -bottom-4 m-0 w-auto max-w-none max-h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-0 border-t border-[#e9e9e9] bg-white p-0 pb-4 text-[#2a343a]"
    >
      <div
        data-dom="drag-indicator"
        class="flex cursor-grab touch-none justify-center pt-2 pb-3 active:cursor-grabbing"
        aria-hidden="true"
      >
        <span class="h-0.75 w-9 rounded-full bg-[#e9e9e9]"></span>
      </div>

      <form method="dialog" class="flex flex-col gap-4 px-5 pb-6">
        <div class="flex flex-col gap-2">
          <div class="flex items-center justify-between gap-3">
            <h2 id="cloak-sheet-title" class="font-serif text-[0.984rem] leading-snug font-normal italic">
              Cloak of Elvenkind
            </h2>
            <button type="button" class="text-lg leading-none" aria-label="Add to wishlist">&#9825;</button>
          </div>
          <p class="text-[0.844rem]">6 000 gp</p>
        </div>

        <hr class="border-[#e9e9e9]" />

        <fieldset>
          <legend class="mb-3 flex gap-2 text-[0.844rem]">
            Color: <span data-dom="color" class="font-serif italic">{selectedColor.name}</span>
          </legend>
          <div class="flex items-center gap-3">
            {colors.map((color) => (
              <label
                class="grid size-5.5 cursor-pointer place-items-center rounded-full has-checked:ring-1 has-checked:ring-[#2a343a] has-focus-visible:outline-2 has-focus-visible:outline-[#171717]"
              >
                <input
                  type="radio"
                  name="color"
                  value={color.name}
                  checked={color === selectedColor}
                  class="sr-only"
                />
                <span class="size-4 rounded-full border border-[#e9e9e9]" style={`background: ${color.value}`}></span>
                <span class="sr-only">{color.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <hr class="border-[#e9e9e9]" />

        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between gap-3 text-[0.844rem]">
            <p id="cloak-size-label" class="flex gap-2">
              Size: <span class="font-serif italic">Wearer sizes</span>
            </p>
            <a href="#size-guide" class="underline underline-offset-4">Size guide</a>
          </div>
          <div
            role="radiogroup"
            aria-labelledby="cloak-size-label"
            class="flex flex-wrap items-center gap-x-5.5 gap-y-2 text-[0.844rem]"
          >
            {sizes.map((size) => (
              <label
                class:list={[
                  "cursor-pointer has-checked:font-serif has-checked:italic has-checked:underline has-checked:underline-offset-4 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[#171717]",
                  size.soldOut && "cursor-not-allowed text-[#9a9a9a] line-through",
                ]}
              >
                <input
                  type="radio"
                  name="size"
                  value={size.name}
                  disabled={size.soldOut}
                  class="sr-only"
                />
                {size.name}
                {size.soldOut && <span class="sr-only">, sold out</span>}
              </label>
            ))}
          </div>
        </div>

        <button
          data-dom="add"
          type="submit"
          disabled
          class="h-11.25 w-full bg-[#171717] text-[0.844rem] text-white disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#171717]"
        >
          Select a size
        </button>

        <div class="flex flex-col items-start gap-3 text-[0.844rem]">
          <a href="#fitting" class="underline underline-offset-4">Book a fitting at the guildhall</a>
          <a href="#delivery" class="underline underline-offset-4">Delivery by griffon</a>
        </div>
      </form>
    </dialog>
  </cinq-sheet>
</div>

<script>
  const sheet = document.getElementById("cloak-sheet-demo");
  const form = sheet?.querySelector("form");
  const add = sheet?.querySelector<HTMLButtonElement>('[data-dom="add"]');
  const color = sheet?.querySelector('[data-dom="color"]');
  const summary = document.querySelector<HTMLButtonElement>('[data-dom="summary"]');

  form?.addEventListener("change", (event) => {
    const input = event.target as HTMLInputElement;

    if (input.name === "color" && color) {
      color.textContent = input.value;
      return;
    }

    if (input.name !== "size" || !add) {
      return;
    }

    add.disabled = false;
    add.textContent = `Add to hoard (${input.value})`;
  });

  form?.addEventListener("submit", () => {
    const size = new FormData(form).get("size");

    if (summary && size) {
      summary.textContent = `In your hoard (${size})`;
    }
  });
</script>
