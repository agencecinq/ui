<script>
  import type { Spinbutton } from '@agencecinq/spinbutton';
  import { EVENTS } from '@agencecinq/utils';

  const formatEvent = (value: number) => `${EVENTS.SPINBUTTON_CHANGE} (value: ${value})`;

  const wireEventStatus = (hostId: string, statusId: string) => {
    const host = document.getElementById(hostId);
    const status = document.getElementById(statusId);
    if (!host || !status) return;

    host.addEventListener(EVENTS.SPINBUTTON_CHANGE, (event) => {
      const { value } = (event as CustomEvent<{ value: number }>).detail;
      status.textContent = formatEvent(value);
    });
  };

  wireEventStatus('docs-spinbutton-basic', 'docs-spinbutton-basic-status');
  wireEventStatus('docs-spinbutton-controls', 'docs-spinbutton-controls-status');

  {
    const host = document.getElementById('docs-spinbutton-labels') as Spinbutton | null;
    const status = document.getElementById('docs-spinbutton-labels-status');
    const localeSelect = document.getElementById(
      'docs-spinbutton-labels-locale',
    ) as HTMLSelectElement | null;

    const LABELS: Record<string, Partial<Record<Intl.LDMLPluralRule, string>>> = {
      en: { one: 'level', other: 'levels' },
      pl: { one: 'poziom', few: 'poziomy', many: 'poziomów', other: 'poziomów' },
    };

    const applyLocale = (locale: string) => {
      if (!host || !status) return;

      const labels = LABELS[locale] ?? LABELS.en;
      const pluralRules = new Intl.PluralRules(locale);

      host.formatValue = (value) => {
        const form = pluralRules.select(value);
        const unit = labels[form] ?? labels.other ?? '';
        return `${value} ${unit}`.trim();
      };

      status.textContent = host.$input?.getAttribute('aria-valuetext') ?? '';
    };

    if (host && status && localeSelect) {
      host.addEventListener(EVENTS.SPINBUTTON_CHANGE, () => {
        status.textContent = host.$input?.getAttribute('aria-valuetext') ?? '';
      });

      localeSelect.addEventListener('change', () => {
        applyLocale(localeSelect.value);
      });

      applyLocale(localeSelect.value);
    }
  }

  {
    const host = document.getElementById('docs-spinbutton-controls') as Spinbutton | null;
    if (host) {
      const apply = (key: 'min' | 'max' | 'value', value: number) => {
        if (Number.isNaN(value)) return;
        if (key === 'min') host.setMin(value);
        if (key === 'max') host.setMax(value);
        if (key === 'value') host.setValue(value);
      };

      (['min', 'max', 'value'] as const).forEach((key) => {
        const input = document.querySelector<HTMLInputElement>(`[data-control="${key}"]`);
        input?.addEventListener('input', () => apply(key, parseInt(input.value, 10)));
      });
    }
  }

  {
    const host = document.getElementById('docs-spinbutton-programmatic') as Spinbutton | null;
    const status = document.getElementById('docs-spinbutton-programmatic-status');
    const events = document.getElementById('docs-spinbutton-programmatic-events');
    const decrease = document.getElementById('docs-spinbutton-programmatic-decrease');
    const increase = document.getElementById('docs-spinbutton-programmatic-increase');
    const set = document.getElementById('docs-spinbutton-programmatic-set');
    const silent = document.getElementById('docs-spinbutton-programmatic-silent');

    if (host && status && events) {
      let eventCount = 0;

      const sync = () => {
        status.textContent = host.$input?.value ?? '0';
      };

      host.addEventListener(EVENTS.SPINBUTTON_CHANGE, () => {
        eventCount += 1;
        events.textContent = String(eventCount);
        sync();
      });

      decrease?.addEventListener('click', () => {
        host.decrease();
      });

      increase?.addEventListener('click', () => {
        host.increase();
      });

      set?.addEventListener('click', () => {
        host.setValue(10);
      });

      silent?.addEventListener('click', () => {
        host.setValue(15, false);
        sync();
      });
    }
  }

  {
    const host = document.getElementById('docs-spinbutton-typing') as Spinbutton | null;
    const valueStatus = document.getElementById('docs-spinbutton-typing-status');
    const invalidStatus = document.getElementById('docs-spinbutton-typing-invalid');
    const input = host?.$input;

    if (host && valueStatus && invalidStatus && input) {
      const sync = () => {
        valueStatus.textContent = input.value;
        invalidStatus.textContent = input.hasAttribute('aria-invalid') ? 'true' : 'false';
      };

      host.addEventListener(EVENTS.SPINBUTTON_CHANGE, sync);
      input.addEventListener('change', sync);
      input.addEventListener('input', () => {
        invalidStatus.textContent = input.hasAttribute('aria-invalid') ? 'true' : 'false';
      });
    }
  }

  {
    const host = document.getElementById('docs-spinbutton-throttle') as Spinbutton | null;
    const valueEl = document.getElementById('docs-spinbutton-throttle-value');
    const eventsEl = document.getElementById('docs-spinbutton-throttle-events');
    const burst = document.getElementById('docs-spinbutton-throttle-burst');
    const reset = document.getElementById('docs-spinbutton-throttle-reset');

    if (host && valueEl && eventsEl) {
      let eventCount = 0;

      const sync = () => {
        valueEl.textContent = host.$input?.value ?? '0';
        eventsEl.textContent = String(eventCount);
      };

      host.addEventListener(EVENTS.SPINBUTTON_CHANGE, () => {
        eventCount += 1;
        sync();
      });

      burst?.addEventListener('click', () => {
        for (let i = 0; i < 10; i += 1) {
          host.increase();
        }
        sync();
        window.setTimeout(sync, 550);
      });

      reset?.addEventListener('click', () => {
        eventCount = 0;
        host.setValue(1, false);
        sync();
      });
    }
  }

  {
    const root = document.querySelector('[data-spinbutton-quantity]');
    const host = document.getElementById('docs-spinbutton-quantity') as Spinbutton | null;
    const total = root?.querySelector<HTMLElement>('[data-spinbutton-quantity-total]');

    if (root && host && total) {
      const unitPrice = Number.parseInt(host.getAttribute('data-unit-price') ?? '0', 10);
      const stock = host.value.max !== false ? host.value.max : 0;
      const pluralRules = new Intl.PluralRules(root.getAttribute('lang') ?? undefined);
      const labels: Partial<Record<Intl.LDMLPluralRule, string>> = {
        one: 'torch',
        other: 'torches',
      };

      host.formatValue = (value) => {
        const unit = labels[pluralRules.select(value)] ?? labels.other ?? 'torches';
        return `${value} ${unit}`;
      };

      const syncTotal = () => {
        const quantity = host.value.now;
        const lineTotal = quantity * unitPrice;
        const unit = labels[pluralRules.select(quantity)] ?? labels.other ?? 'torches';
        total.textContent = `${quantity} ${unit} · ${lineTotal} gp`;
      };

      host.addEventListener(EVENTS.SPINBUTTON_CHANGE, syncTotal);
      syncTotal();

      const stockEl = root.querySelector('[data-spinbutton-quantity-stock]');
      if (stockEl) stockEl.textContent = String(stock);
    }
  }

  {
    const root = document.querySelector('[data-spinbutton-duration]');
    const hours = document.getElementById('docs-spinbutton-duration-hours') as Spinbutton | null;
    const minutes = document.getElementById(
      'docs-spinbutton-duration-minutes',
    ) as Spinbutton | null;
    const summary = root?.querySelector<HTMLElement>('[data-spinbutton-duration-summary]');

    if (root && hours && minutes && summary) {
      const MAX_TOTAL = 23 * 60 + 59;
      let minutesBeforeStep = minutes.value.now;

      const syncSummary = () => {
        const h = hours.value.now;
        const m = minutes.value.now;

        if (h === 0 && m === 0) {
          summary.textContent = 'No rest';
          return;
        }

        if (h === 0) {
          summary.textContent = `${m} min rest`;
          return;
        }

        if (m === 0) {
          summary.textContent = `${h} h rest`;
          return;
        }

        summary.textContent = `${h} h ${m} min rest`;
      };

      const setTotalMinutes = (total: number, emit = true) => {
        const clamped = Math.min(Math.max(total, 0), MAX_TOTAL);
        hours.setValue(Math.floor(clamped / 60), emit);
        minutes.setValue(clamped % 60, false);
        syncSummary();
      };

      const tryRollover = (direction: 1 | -1, previousMinutes: number) => {
        const h = hours.value.now;
        const m = minutes.value.now;

        if (direction === 1 && previousMinutes === 59 && m === 59 && h < 23) {
          setTotalMinutes(h * 60 + 60);
          return true;
        }

        if (direction === -1 && previousMinutes === 0 && m === 0 && h > 0) {
          setTotalMinutes(h * 60 - 1);
          return true;
        }

        return false;
      };

      const afterMinutesStep = (direction: 1 | -1, previousMinutes: number) => {
        window.requestAnimationFrame(() => {
          if (!tryRollover(direction, previousMinutes)) {
            syncSummary();
          }
        });
      };

      minutes.$increase?.addEventListener('mousedown', () => {
        minutesBeforeStep = minutes.value.now;
      });
      minutes.$decrease?.addEventListener('mousedown', () => {
        minutesBeforeStep = minutes.value.now;
      });

      minutes.$increase?.addEventListener('click', () => afterMinutesStep(1, minutesBeforeStep));
      minutes.$decrease?.addEventListener('click', () => afterMinutesStep(-1, minutesBeforeStep));

      minutes.$input?.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
          const previousMinutes = minutes.value.now;
          const direction = event.key === 'ArrowUp' ? 1 : -1;
          afterMinutesStep(direction, previousMinutes);
        },
        true,
      );

      hours.addEventListener(EVENTS.SPINBUTTON_CHANGE, syncSummary);
      minutes.addEventListener(EVENTS.SPINBUTTON_CHANGE, syncSummary);
      syncSummary();
    }
  }

  {
    const root = document.querySelector('[data-spinbutton-checkout]');
    if (root) {
      type TicketKey = 'adventurer' | 'henchman' | 'porter';

      const TICKET_LABELS: Record<
        TicketKey,
        Partial<Record<Intl.LDMLPluralRule, string>>
      > = {
        adventurer: { one: 'adventurer', other: 'adventurers' },
        henchman: { one: 'henchman', other: 'henchmen' },
        porter: { one: 'porter', other: 'porters' },
      };

      const capacity = Number.parseInt(root.getAttribute('data-capacity') ?? '12', 10);
      const summary = root.querySelector<HTMLElement>('[data-spinbutton-checkout-summary]');
      const seats = [...root.querySelectorAll<HTMLElement>('[data-spinbutton-seats] > *')];
      const locale = root.getAttribute('lang') ?? undefined;
      const pluralRules = new Intl.PluralRules(locale);
      const tickets = {} as Record<TicketKey, Spinbutton>;

      root.querySelectorAll<Spinbutton>('cinq-spinbutton[data-ticket]').forEach((host) => {
        const key = host.getAttribute('data-ticket') as TicketKey | null;
        if (!key) return;

        const labels = TICKET_LABELS[key];
        host.formatValue = (value) => {
          const form = pluralRules.select(value);
          const unit = labels[form] ?? labels.other ?? key;
          return `${value} ${unit}`;
        };

        tickets[key] = host;
      });

      const syncCheckout = () => {
        const adventurer = tickets.adventurer.value.now;
        const henchman = tickets.henchman.value.now;

        if (tickets.porter.value.now > adventurer) {
          tickets.porter.setValue(adventurer, false);
        }

        const porter = tickets.porter.value.now;
        const taken = adventurer + henchman + porter;
        const left = capacity - taken;

        tickets.adventurer.setMax(adventurer + left, false);
        tickets.henchman.setMax(henchman + left, false);
        tickets.porter.setMax(Math.min(adventurer, porter + left), false);

        const henchmanMaxEl = root.querySelector('[data-spinbutton-ticket-max="henchman"]');
        const porterMaxEl = root.querySelector('[data-spinbutton-ticket-max="porter"]');
        const henchmanMax = tickets.henchman.value.max;
        const porterMax = tickets.porter.value.max;

        if (henchmanMaxEl) {
          henchmanMaxEl.textContent = henchmanMax === false ? '—' : String(henchmanMax);
        }

        if (porterMaxEl) {
          porterMaxEl.textContent = porterMax === false ? '—' : String(porterMax);
        }

        const total = (['adventurer', 'henchman', 'porter'] as const).reduce((sum, key) => {
          const price = Number.parseInt(tickets[key].getAttribute('data-price') ?? '0', 10);
          return sum + tickets[key].value.now * price;
        }, 0);

        seats.forEach((seat, index) => {
          seat.classList.remove('is-adventurer', 'is-henchman', 'is-porter');

          if (index < adventurer) {
            seat.classList.add('is-adventurer');
          } else if (index < adventurer + henchman) {
            seat.classList.add('is-henchman');
          } else if (index < taken) {
            seat.classList.add('is-porter');
          }
        });

        if (summary) {
          const slotsWord = pluralRules.select(left) === 'one' ? 'slot' : 'slots';
          summary.textContent = `${taken} in party · ${total} gp upkeep · ${left} ${slotsWord} open`;
        }
      };

      Object.values(tickets).forEach((host) => {
        host.addEventListener(EVENTS.SPINBUTTON_CHANGE, syncCheckout);
      });

      syncCheckout();
    }
  }

  {
    const root = document.querySelector('[data-character-sheet]');
    if (root) {
      type Ability = 'str' | 'dex' | 'con' | 'int' | 'wis' | 'cha';
      type ClassRequirements = Partial<Record<Ability, number>>;

      const CLASS_REQUIREMENTS: Record<string, ClassRequirements> = {
        bard: { dex: 12, int: 13, cha: 15 },
        cleric: { wis: 9 },
        druid: { wis: 12, cha: 15 },
        fighter: { str: 9 },
        illusionist: { dex: 16 },
        mage: { int: 9 },
        paladin: { str: 12, con: 9, wis: 13, cha: 17 },
        ranger: { str: 13, dex: 13, con: 14, wis: 14 },
        thief: { dex: 9 },
      };

      const ABILITIES: readonly Ability[] = ['str', 'dex', 'con', 'int', 'wis', 'cha'] as const;
      const FLOOR = 3;

      const roll3d6 = () =>
        Array.from({ length: 3 }, () => 1 + Math.floor(Math.random() * 6)).reduce(
          (sum, die) => sum + die,
          0,
        );

      const getSpinbutton = (ability: Ability) =>
        root.querySelector<Spinbutton>(`cinq-spinbutton[data-ability="${ability}"]`);

      const getRequirementBadge = (ability: Ability) =>
        root.querySelector<HTMLElement>(`[data-requirement="${ability}"]`);

      root.querySelectorAll<HTMLButtonElement>('[data-roll]').forEach((button) => {
        button.addEventListener('click', () => {
          const ability = button.dataset.roll as Ability | undefined;
          if (!ability) return;
          getSpinbutton(ability)?.setValue(roll3d6());
        });
      });

      const select = root.querySelector<HTMLSelectElement>('[data-character-class]');
      select?.addEventListener('change', (event) => {
        const value = (event.target as HTMLSelectElement).value;
        const reqs = CLASS_REQUIREMENTS[value] ?? {};

        ABILITIES.forEach((ability) => {
          const min = reqs[ability] ?? FLOOR;
          getSpinbutton(ability)?.setMin(min);

          const badge = getRequirementBadge(ability);
          if (badge) badge.textContent = reqs[ability] ? `(min ${reqs[ability]})` : '';
        });
      });
    }
  }
</script>
