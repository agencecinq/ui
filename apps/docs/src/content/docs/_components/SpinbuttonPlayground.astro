---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-spinbutton-typing input[aria-invalid='true'] {
    outline: 2px solid #dc2626;
    outline-offset: 1px;
    border-radius: 0.25rem;
  }

  .docs-spinbutton-seats {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .docs-spinbutton-seats__seat {
    aspect-ratio: 1;
    border-radius: 0.25rem;
    background: #e5e7eb;
  }

  .docs-spinbutton-seats__seat.is-adventurer {
    background: #111827;
  }

  .docs-spinbutton-seats__seat.is-henchman {
    background: #f59e0b;
  }

  .docs-spinbutton-seats__seat.is-porter {
    background: #8b5cf6;
  }

  .docs-spinbutton-seats-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    color: #4b5563;
  }

  .docs-spinbutton-seats-legend li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .docs-spinbutton-seats-legend span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 0.125rem;
    flex-shrink: 0;
  }
</style>

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Spell level</h3>
          <p class="text-sm text-gray-600">
            Basic usage on a wizard&apos;s spell picker. Use the buttons or keyboard (<kbd>↑</kbd>/<kbd>↓</kbd>,{' '}
            <kbd>Page Up</kbd>/<kbd>Page Down</kbd>, <kbd>Home</kbd>/<kbd>End</kbd>).{' '}
            <code>spinbutton:change</code> events are logged below.
          </p>
        </div>

        <cinq-spinbutton
          id="docs-spinbutton-basic"
          class="inline-flex w-fit items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
        >
          <button
            type="button"
            name="decrease"
            tabindex="-1"
            aria-label="One spell level less"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            −
          </button>

          <input
            type="number"
            value="1"
            aria-label="Spell level"
            aria-valuemin="1"
            aria-valuemax="9"
            aria-valuenow="1"
            class="w-14 bg-transparent text-center font-mono text-base focus:outline-none"
          />

          <button
            type="button"
            name="increase"
            tabindex="-1"
            aria-label="One spell level more"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            +
          </button>
        </cinq-spinbutton>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Last event:{' '}
          <span id="docs-spinbutton-basic-status" class="font-mono font-medium text-gray-900">none</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Camp gear &amp; initiative</h3>
          <p class="text-sm text-gray-600">
            Three markup patterns from the same party sheet: rations via{' '}
            <code>aria-labelledby</code>, encumbrance on <code>type="text"</code> with an explicit{' '}
            <code>role="spinbutton"</code>, and an initiative modifier with no + / − buttons
            (keyboard only).
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          <div class="flex flex-col gap-2">
            <span id="docs-spinbutton-labelledby-label" class="text-sm font-medium text-gray-900">
              Rations (days)
            </span>
            <cinq-spinbutton
              class="inline-flex w-full items-center justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
            >
              <button
                type="button"
                name="decrease"
                tabindex="-1"
                aria-label="Decrease rations"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
              >
                −
              </button>
              <input
                type="number"
                value="7"
                aria-labelledby="docs-spinbutton-labelledby-label"
                aria-valuemin="1"
                aria-valuemax="30"
                aria-valuenow="7"
                class="w-12 bg-transparent text-center font-mono text-base focus:outline-none"
              />
              <button
                type="button"
                name="increase"
                tabindex="-1"
                aria-label="Increase rations"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
              >
                +
              </button>
            </cinq-spinbutton>
            <p class="text-xs text-gray-500">
              Name from the visible label through <code>aria-labelledby</code>.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-gray-900">Encumbrance (text input)</span>
            <cinq-spinbutton
              class="inline-flex w-full items-center justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
            >
              <button
                type="button"
                name="decrease"
                tabindex="-1"
                aria-label="Decrease encumbrance"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
              >
                −
              </button>
              <input
                type="text"
                role="spinbutton"
                inputmode="numeric"
                value="50"
                aria-label="Encumbrance"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                class="w-12 bg-transparent text-center font-mono text-base focus:outline-none"
              />
              <button
                type="button"
                name="increase"
                tabindex="-1"
                aria-label="Increase encumbrance"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
              >
                +
              </button>
            </cinq-spinbutton>
            <p class="text-xs text-gray-500">
              Use <code>type="text"</code> when you want free typing without native number UI.
            </p>
          </div>

          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-gray-900">Initiative (input only)</span>
            <cinq-spinbutton
              class="inline-flex w-full justify-center rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
            >
              <input
                type="number"
                value="0"
                aria-label="Initiative modifier"
                aria-valuemin="-10"
                aria-valuemax="10"
                aria-valuenow="0"
                class="w-full bg-transparent py-1 text-center font-mono text-base focus:outline-none"
              />
            </cinq-spinbutton>
            <p class="text-xs text-gray-500">
              Buttons are optional. Arrow keys still adjust by step.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Spell level (i18n)</h3>
          <p class="text-sm text-gray-600">
            Assign <code>formatValue</code> so <code>aria-valuetext</code> reads naturally in the
            spell book (and mirrors into an optional <code>[aria-live]</code> child). Use{' '}
            <code>Intl.PluralRules</code> in your app: English has <strong>one/other</strong>, Polish
            adds <strong>few/many</strong>. Switch locale below to hear the difference.
          </p>
        </div>

        <label class="flex flex-col gap-1 text-sm sm:max-w-xs">
          <span class="font-medium text-gray-700">Locale</span>
          <select
            id="docs-spinbutton-labels-locale"
            class="rounded-md border border-gray-200 bg-white px-2 py-1 font-medium text-gray-900 focus:outline-none focus:ring-2 focus:ring-black"
          >
            <option value="en">English (one / other)</option>
            <option value="pl">Polish (one / few / many / other)</option>
          </select>
        </label>

        <cinq-spinbutton
          id="docs-spinbutton-labels"
          class="inline-flex w-fit items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
        >
          <button
            type="button"
            name="decrease"
            tabindex="-1"
            aria-label="One spell level less"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            −
          </button>

          <input
            type="number"
            value="1"
            aria-label="Spell level"
            aria-valuemin="0"
            aria-valuemax="9"
            aria-valuenow="1"
            class="w-14 bg-transparent text-center font-mono text-base focus:outline-none"
          />

          <button
            type="button"
            name="increase"
            tabindex="-1"
            aria-label="One spell level more"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            +
          </button>

          <div aria-live="polite" aria-atomic="true" class="sr-only"></div>
        </cinq-spinbutton>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          <code>aria-valuetext</code>:{' '}
          <span id="docs-spinbutton-labels-status" class="font-mono font-medium text-gray-900">
            1 level
          </span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Treasury</h3>
          <p class="text-sm text-gray-600">
            Party gold counted in increments of 10 gp. Set <code>data-step</code> on the
            host. Buttons, arrow keys, and <kbd>Page Up</kbd>/<kbd>Page Down</kbd> (×5) all respect
            the same increment.
          </p>
        </div>

        <cinq-spinbutton
          id="docs-spinbutton-step"
          data-step="10"
          class="inline-flex w-fit items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
        >
          <button
            type="button"
            name="decrease"
            tabindex="-1"
            aria-label="Decrease gold by 10"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            −
          </button>
          <input
            type="number"
            value="100"
            aria-label="Gold pieces"
            aria-valuemin="0"
            aria-valuemax="1000"
            aria-valuenow="100"
            class="w-20 bg-transparent text-center font-mono text-base focus:outline-none"
          />
          <button
            type="button"
            name="increase"
            tabindex="-1"
            aria-label="Increase gold by 10"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            +
          </button>
        </cinq-spinbutton>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Step: <span class="font-mono font-medium text-gray-900">10 gp</span> per click or arrow key
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Bounds on the trail</h3>
          <p class="text-sm text-gray-600">
            <code>aria-valuemin</code> and <code>aria-valuemax</code> are each optional. XP can
            climb without a ceiling, arrows cannot go below zero, and prepared 1st-level slots cannot
            exceed the mage&apos;s daily allowance.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <div class="flex flex-col gap-2">
            <span id="bounds-none-label" class="text-xs font-medium uppercase tracking-wide text-gray-500">
              Experience points
            </span>
            <cinq-spinbutton
              class="inline-flex w-full items-center justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
            >
              <button
                type="button"
                name="decrease"
                tabindex="-1"
                aria-label="Decrease experience points"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100"
              >
                −
              </button>
              <input
                type="number"
                value="1250"
                aria-labelledby="bounds-none-label"
                aria-valuenow="1250"
                class="w-16 bg-transparent text-center font-mono text-base focus:outline-none"
              />
              <button
                type="button"
                name="increase"
                tabindex="-1"
                aria-label="Increase experience points"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100"
              >
                +
              </button>
            </cinq-spinbutton>
            <p class="text-xs text-gray-500">No min or max. The − / + buttons never auto-disable.</p>
          </div>

          <div class="flex flex-col gap-2">
            <span id="bounds-min-label" class="text-xs font-medium uppercase tracking-wide text-gray-500">
              Arrows (min 0)
            </span>
            <cinq-spinbutton
              class="inline-flex w-full items-center justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
            >
              <button
                type="button"
                name="decrease"
                tabindex="-1"
                aria-label="Decrease arrows"
                disabled
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
              >
                −
              </button>
              <input
                type="number"
                value="0"
                aria-labelledby="bounds-min-label"
                aria-valuemin="0"
                aria-valuenow="0"
                class="w-12 bg-transparent text-center font-mono text-base focus:outline-none"
              />
              <button
                type="button"
                name="increase"
                tabindex="-1"
                aria-label="Increase arrows"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100"
              >
                +
              </button>
            </cinq-spinbutton>
            <p class="text-xs text-gray-500">Minimum only. − disables at zero.</p>
          </div>

          <div class="flex flex-col gap-2">
            <span id="bounds-max-label" class="text-xs font-medium uppercase tracking-wide text-gray-500">
              1st-level slots (max 4)
            </span>
            <cinq-spinbutton
              class="inline-flex w-full items-center justify-between gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
            >
              <button
                type="button"
                name="decrease"
                tabindex="-1"
                aria-label="Decrease prepared slots"
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100"
              >
                −
              </button>
              <input
                type="number"
                value="4"
                aria-labelledby="bounds-max-label"
                aria-valuemax="4"
                aria-valuenow="4"
                class="w-12 bg-transparent text-center font-mono text-base focus:outline-none"
              />
              <button
                type="button"
                name="increase"
                tabindex="-1"
                aria-label="Increase prepared slots"
                disabled
                class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
              >
                +
              </button>
            </cinq-spinbutton>
            <p class="text-xs text-gray-500">Maximum only. + disables when all slots are filled.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Party size</h3>
          <p class="text-sm text-gray-600">
            Recruiting for the delve: type freely in the input. Intermediate keystrokes do not
            dispatch events. The value commits on <kbd>Enter</kbd> or blur (<code>change</code>).
            Out-of-range entries set <code>aria-invalid="true"</code> briefly, then clamp to min/max.
          </p>
        </div>

        <cinq-spinbutton
          id="docs-spinbutton-typing"
          class="docs-spinbutton-typing inline-flex w-fit items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
        >
          <button
            type="button"
            name="decrease"
            tabindex="-1"
            aria-label="One fewer adventurer"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            −
          </button>
          <input
            type="number"
            value="5"
            aria-label="Party size"
            aria-valuemin="1"
            aria-valuemax="10"
            aria-valuenow="5"
            class="w-14 bg-transparent text-center font-mono text-base focus:outline-none"
          />
          <button
            type="button"
            name="increase"
            tabindex="-1"
            aria-label="One more adventurer"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            +
          </button>
        </cinq-spinbutton>

        <p class="text-xs text-gray-500">Try typing <strong>99</strong> recruits, then blur the field.</p>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Committed value:{' '}
          <span id="docs-spinbutton-typing-status" class="font-mono font-medium text-gray-900">5</span>
          {' · '}
          <code>aria-invalid</code>:{' '}
          <span id="docs-spinbutton-typing-invalid" class="font-mono font-medium text-gray-900">false</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Combat round</h3>
          <p class="text-sm text-gray-600">
            Initiative tracker with <code>data-delay</code> throttling{' '}
            <code>spinbutton:change</code> only. DOM updates (round number, button disabled state)
            stay immediate. Hold + or mash the arrow keys to compare round count vs. events logged.
          </p>
        </div>

        <cinq-spinbutton
          id="docs-spinbutton-throttle"
          data-delay="500"
          class="inline-flex w-fit items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
        >
          <button
            type="button"
            name="decrease"
            tabindex="-1"
            aria-label="Previous round"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            −
          </button>
          <input
            type="number"
            value="1"
            aria-label="Combat round"
            aria-valuemin="1"
            aria-valuemax="999"
            aria-valuenow="1"
            class="w-16 bg-transparent text-center font-mono text-base focus:outline-none"
          />
          <button
            type="button"
            name="increase"
            tabindex="-1"
            aria-label="Next round"
            class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
          >
            +
          </button>
        </cinq-spinbutton>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-spinbutton-throttle-burst"
            class="rounded-lg bg-black px-3 py-2 text-white hover:bg-gray-800"
          >
            Advance 10 rounds (programmatic)
          </button>
          <button
            type="button"
            id="docs-spinbutton-throttle-reset"
            class="rounded-lg bg-gray-100 px-3 py-2 text-gray-800 hover:bg-gray-200"
          >
            Reset tracker
          </button>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Round:{' '}
          <span id="docs-spinbutton-throttle-value" class="font-mono font-medium text-gray-900">1</span>
          {' · '}
          Events dispatched:{' '}
          <span id="docs-spinbutton-throttle-events" class="font-mono font-medium text-gray-900">0</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Hit points</h3>
          <p class="text-sm text-gray-600">
            Wound tracker with bounds adjusted at runtime. Type into the inputs below to call{' '}
            <code>setMin()</code>, <code>setMax()</code>, and <code>setValue()</code> on the
            spinbutton while the party rests or takes damage.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-center">
          <cinq-spinbutton
            id="docs-spinbutton-controls"
            data-step="5"
            class="inline-flex w-fit items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-1 text-gray-900 focus-within:ring-2 focus-within:ring-black"
          >
            <button
              type="button"
              name="decrease"
              tabindex="-1"
              aria-label="Lose hit points"
              class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
            >
              −
            </button>
            <input
              type="number"
              value="20"
              aria-label="Hit points"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="20"
              class="w-16 bg-transparent text-center font-mono text-base focus:outline-none"
            />
            <button
              type="button"
              name="increase"
              tabindex="-1"
              aria-label="Gain hit points"
              class="grid h-8 w-8 place-items-center rounded-md bg-white shadow-sm hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40"
            >
              +
            </button>
          </cinq-spinbutton>

          <div class="grid grid-cols-3 gap-3 text-sm">
            <label class="flex flex-col gap-1">
              <span class="font-medium text-gray-700">Minimum</span>
              <input
                type="number"
                value="0"
                data-control="min"
                class="rounded-md border border-gray-200 bg-white px-2 py-1 font-mono"
              />
            </label>
            <label class="flex flex-col gap-1">
              <span class="font-medium text-gray-700">Maximum</span>
              <input
                type="number"
