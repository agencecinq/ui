---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-combobox {
    position: relative;
    display: flex;
    max-width: 28rem;
    align-items: stretch;
    gap: 0;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: #fff;
  }

  @supports (anchor-name: --x) and (position-anchor: --x) {
    .docs-combobox {
      anchor-name: --docs-combobox-anchor;
      anchor-scope: --docs-combobox-anchor;
    }
  }

  .docs-combobox:focus-within {
    outline: 2px solid #111827;
    outline-offset: 2px;
  }

  .docs-combobox input[role='combobox'] {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: #111827;
  }

  .docs-combobox input[role='combobox']:focus {
    outline: none;
  }

  .docs-combobox button[aria-controls] {
    flex-shrink: 0;
    border: 0;
    border-left: 1px solid #e5e7eb;
    background: #f9fafb;
    padding: 0 0.75rem;
    color: #374151;
    cursor: pointer;
  }

  .docs-combobox button[aria-controls]:hover {
    background: #f3f4f6;
  }

  .docs-combobox [role='listbox'] {
    position: absolute;
    z-index: 10;
    top: calc(100% + 0.25rem);
    left: 0;
    right: 0;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: #fff;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    max-height: 16rem;
    overflow: auto;
    display: flex;
    flex-direction: column;
  }

  @supports (anchor-name: --x) and (position-anchor: --x) {
    .docs-combobox [role='listbox'] {
      position: fixed;
      position-anchor: --docs-combobox-anchor;
      top: anchor(bottom);
      left: anchor(left);
      width: anchor-size(width);
      right: auto;
      margin-top: 0.25rem;
      position-try-fallbacks: flip-block;
    }
  }

  .docs-combobox [role='listbox'][hidden] {
    display: none;
  }

  .docs-combobox [role='option'] {
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: #111827;
    cursor: pointer;
  }

  .docs-combobox [role='option'][aria-selected='true'] {
    background: #f3f4f6;
  }

  .docs-combobox[busy] input[role='combobox'],
  .docs-combobox[busy] [role='listbox'] {
    opacity: 0.75;
  }

  .docs-combobox-group-label {
    margin: 0;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b7280;
    background: #f9fafb;
  }

  .docs-combobox-option-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .docs-combobox-event-log {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    max-height: 10rem;
    overflow-y: auto;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: #f9fafb;
    padding: 0.5rem 0.75rem;
  }

  .docs-combobox-event-log:empty::before {
    content: 'No events yet.';
    color: #9ca3af;
  }

  .docs-combobox-empty {
    display: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .docs-combobox-empty.is-visible {
    display: block;
  }

  .docs-combobox-picked {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 0.375rem;
    background: #ecfdf5;
    color: #047857;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
  }

  /* ── Advanced compendium ─────────────────────────────────────────────────── */
  .docs-combobox-advanced-layout {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .docs-combobox-advanced-layout {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      align-items: start;
    }
  }

  .docs-combobox--palette {
    max-width: none;
    border-radius: 0.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }

  .docs-combobox--palette input[role='combobox'] {
    padding-left: 0.75rem;
    font-size: 0.9375rem;
  }

  .docs-combobox--palette [role='listbox'] {
    max-height: 20rem;
    padding: 0.375rem;
    border-radius: 0.75rem;
  }

  .docs-combobox--palette [role='option'] {
    padding: 0;
    margin: 0;
  }

  .docs-combobox--palette [role='option'][aria-selected='true'] .docs-combobox-rich-option {
    background: #f3f4f6;
    outline: 1px solid #d1d5db;
  }

  .docs-combobox-rich-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
  }

  .docs-combobox-rich-option__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: #111827;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .docs-combobox-rich-option__body {
    flex: 1;
    min-width: 0;
  }

  .docs-combobox-rich-option__name {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }

  .docs-combobox-rich-option__meta {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: #6b7280;
  }

  .docs-combobox-rich-option__badge {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .docs-combobox-detail {
    min-height: 14rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
    padding: 1.25rem;
  }

  .docs-combobox-detail.is-empty {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: #6b7280;
  }

  .docs-combobox-detail__eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6b7280;
  }

  .docs-combobox-detail__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
  }

  .docs-combobox-detail__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .docs-combobox-detail__stat {
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: #fff;
    border: 1px solid #e5e7eb;
  }

  .docs-combobox-detail__stat dt {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #9ca3af;
  }

  .docs-combobox-detail__stat dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #111827;
  }

  .docs-combobox-detail__blurb {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #374151;
  }

  .docs-combobox-advanced-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .docs-combobox-advanced-kbd {
    font-size: 0.75rem;
    color: #6b7280;
  }
</style>

<div class="not-content">
  <div class="flex flex-col gap-10">
    <!-- 1. Managed: sync local list -->
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Local list</h3>
          <p class="text-sm text-gray-600">
            Managed mode: sync <code>search</code>, optional open button, and
            <code>data-autoselect</code> (first match highlighted on open).
          </p>
        </div>

        <label for="docs-monster-local" class="text-sm font-medium text-gray-700">Monster</label>
        <cinq-combobox id="docs-monster-local" class="docs-combobox" data-autoselect>
          <input
            id="docs-monster-local-input"
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="docs-monster-local-listbox"
            autocomplete="off"
            placeholder="e.g. Mind Flayer"
          />
          <button
            type="button"
            tabindex="-1"
            aria-label="Monsters"
            aria-controls="docs-monster-local-listbox"
            aria-expanded="false"
          >
            Open
          </button>
          <ul
            id="docs-monster-local-listbox"
            role="listbox"
            aria-label="AD&amp;D 2e monsters"
            hidden
          ></ul>
        </cinq-combobox>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800" aria-live="polite">
          Status: <span data-combobox-status="local" class="font-mono font-medium text-gray-900">-</span>
        </p>
      </div>
    </section>

    <!-- 2. Managed: async fetch + event log -->
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Async search</h3>
          <p class="text-sm text-gray-600">
            Managed mode: async <code>search</code>, <code>AbortSignal</code>, event log, and
            <code>[busy]</code> while loading.
          </p>
        </div>

        <label for="docs-monster-api" class="text-sm font-medium text-gray-700">Monster</label>
        <cinq-combobox id="docs-monster-api" class="docs-combobox">
          <input
            id="docs-monster-api-input"
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="docs-monster-api-listbox"
            autocomplete="off"
            placeholder="e.g. Quaggoth"
          />
          <ul
            id="docs-monster-api-listbox"
            role="listbox"
            aria-label="Monsters from API"
            hidden
          ></ul>
        </cinq-combobox>

        <p class="text-sm text-gray-600" aria-live="polite">
          Status: <span data-combobox-status="api" class="font-mono font-medium text-gray-900">Idle</span>
        </p>
        <div
          data-combobox-log="api"
          class="docs-combobox-event-log"
          aria-label="API event log"
        ></div>
      </div>
    </section>

    <!-- 3. External: grouped HTML -->
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">External mode</h3>
          <p class="text-sm text-gray-600">
            Grouped HTML, debounce, <code>minLength</code>, and <code>combobox:empty</code>.
          </p>
        </div>

        <form data-combobox-form="external" action="#" method="get" role="search" class="flex flex-col gap-2 max-w-md">
          <label for="docs-monster-external" class="text-sm font-medium text-gray-700">Query</label>
          <cinq-combobox
            id="docs-monster-external"
            class="docs-combobox"
            data-mode="external"
            data-debounce="280"
            data-min-length="2"
            data-open-on-empty
          >
            <input
              id="docs-monster-external-input"
              type="search"
              name="q"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="docs-monster-external-listbox"
              autocomplete="off"
              placeholder="Type at least 2 characters"
            />
            <div
              id="docs-monster-external-listbox"
              role="listbox"
              aria-label="Search results"
              hidden
            ></div>
          </cinq-combobox>
          <p
            data-combobox-empty="external"
            class="docs-combobox-empty rounded-lg border border-gray-200 bg-gray-50"
            role="status"
          ></p>
          <p class="sr-only" data-combobox-live="external" aria-live="polite" aria-atomic="true"></p>
        </form>

        <p class="text-sm text-gray-600" aria-live="polite">
          Hint: <span data-combobox-hint="external" class="font-mono font-medium text-gray-900">Idle. Try "be", "mi", or "xx".</span>
        </p>
      </div>
    </section>

    <!-- 4. Custom select: picker without filling the input -->
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Custom select</h3>
          <p class="text-sm text-gray-600">
            By default, choosing an option fills the input (see <strong>Local list</strong> above).
            With <code>data-select-mode="custom"</code>, the input stays your filter. Handle the
            choice in <code>combobox:submit</code>.
          </p>
          <ol class="list-decimal pl-5 text-sm text-gray-600 space-y-1">
            <li>Type <code class="text-xs">be</code> in the field below.</li>
            <li>Open the list (Down arrow or click the input).</li>
            <li>Pick an option (click or Enter).</li>
            <li>
              <strong>Query</strong> stays <code class="text-xs">be</code>. Only <strong>Picked</strong> updates.
            </li>
          </ol>
        </div>

        <label for="docs-monster-custom" class="text-sm font-medium text-gray-700">Filter</label>
        <cinq-combobox
          id="docs-monster-custom"
          class="docs-combobox"
          data-select-mode="custom"
        >
          <input
            id="docs-monster-custom-input"
            type="text"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="docs-monster-custom-listbox"
            autocomplete="off"
            placeholder="Type to filter"
          />
          <ul
            id="docs-monster-custom-listbox"
            role="listbox"
            aria-label="Monsters"
            hidden
          ></ul>
        </cinq-combobox>

        <dl class="grid gap-2 text-sm text-gray-800 sm:grid-cols-2">
          <div class="rounded-lg bg-gray-50 px-3 py-2">
            <dt class="text-gray-600">Query (unchanged on pick)</dt>
            <dd>
              <span data-combobox-query="custom" class="font-mono font-medium text-gray-900">-</span>
            </dd>
          </div>
          <div class="rounded-lg bg-gray-50 px-3 py-2">
            <dt class="text-gray-600">Picked</dt>
            <dd>
              <span data-combobox-picked="custom" class="docs-combobox-picked">-</span>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- 5. Advanced: rich external UI + detail panel -->
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Compendium (advanced)</h3>
          <p class="text-sm text-gray-600">
            External mode and <code>selectMode: custom</code>: rich grouped options, debounced async
            search, empty state, and a detail panel fed from <code>combobox:submit</code>.
          </p>
        </div>

        <div class="docs-combobox-advanced-layout">
          <div class="flex flex-col gap-3">
            <label for="docs-monster-advanced-input" class="text-sm font-medium text-gray-700">
              Search compendium
            </label>
            <cinq-combobox
              id="docs-monster-advanced"
              class="docs-combobox docs-combobox--palette"
              data-mode="external"
              data-select-mode="custom"
              data-debounce="220"
              data-min-length="1"
              data-autoselect
            >
              <input
                id="docs-monster-advanced-input"
                type="search"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="docs-monster-advanced-listbox"
                autocomplete="off"
                placeholder="Try mind, dragon, undead"
              />
              <div
                id="docs-monster-advanced-listbox"
                role="listbox"
                aria-label="Compendium results"
                hidden
              ></div>
            </cinq-combobox>
            <p
              data-combobox-empty="advanced"
              class="docs-combobox-empty rounded-lg border border-amber-200 bg-amber-50 text-amber-900"
              role="status"
            ></p>
            <div class="docs-combobox-advanced-toolbar">
              <p class="text-sm text-gray-600" aria-live="polite">
                Filter:
                <span data-combobox-filter="advanced" class="font-mono font-medium text-gray-900">-</span>
              </p>
              <button
                type="button"
                data-combobox-clear="advanced"
                class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50"
              >
                Clear selection
              </button>
            </div>
            <p class="docs-combobox-advanced-kbd">
              Down arrow to navigate, Enter to inspect. The filter stays in the field.
            </p>
          </div>

          <aside
            data-combobox-detail="advanced"
            class="docs-combobox-detail is-empty"
            aria-live="polite"
          >
            <p class="text-sm">Pick a creature from the list.</p>
            <p class="mt-1 text-xs text-gray-500">The search field keeps your filter.</p>
          </aside>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import { EVENTS } from '@agencecinq/utils';

  type ComboboxHost = HTMLElement & {
    search: (
      value: string,
      context: { signal: AbortSignal },
    ) =>
      | string[]
      | Promise<string[]>
      | { html: string }
      | Promise<{ html: string }>;
    onSelect: ((detail: { option: { element: HTMLElement } | null }) => void) | null;
    options: { length: number };
    expanded: boolean;
    disabled: boolean;
    ensureOpen: () => Promise<boolean>;
    hide: (options?: { force?: boolean }) => void;
    setValue: (value: string) => void;
    $input: HTMLInputElement | null;
  };

  const wireOpenButton = (host: ComboboxHost, button: HTMLButtonElement) => {
    const sync = () => {
      button.setAttribute('aria-expanded', host.expanded ? 'true' : 'false');
      button.disabled = host.disabled;
      if (host.disabled) {
        button.setAttribute('disabled', '');
      } else {
        button.removeAttribute('disabled');
      }
    };

    button.addEventListener('mousedown', (event) => event.preventDefault());
    button.addEventListener('click', (event) => {
      event.stopPropagation();
      if (host.disabled) return;
      if (host.expanded) host.hide({ force: true });
      else void host.ensureOpen().then(() => host.$input?.focus());
    });

    const observer = new MutationObserver(sync);
    observer.observe(host, {
      attributes: true,
      attributeFilter: ['expanded', 'disabled'],
    });
    sync();
  };

  const LOCAL_MONSTERS = [
    'Aarakocra',
    'Aboleth',
    'Ankheg',
    'Basilisk',
    'Beholder',
    'Bugbear',
    'Bulette',
    'Carrion Crawler',
    'Chimera',
    'Cockatrice',
    'Displacer Beast',
    'Dragon, Red',
    'Drow',
    'Dryad',
    'Ettin',
    'Gargoyle',
    'Gelatinous Cube',
    'Ghast',
    'Ghoul',
    'Giant, Hill',
    'Gnoll',
    'Goblin',
    'Golem, Flesh',
    'Griffon',
    'Harpy',
    'Hell Hound',
    'Hippogriff',
    'Hobgoblin',
    'Hook Horror',
    'Hydra',
    'Intellect Devourer',
    'Invisible Stalker',
    'Kenku',
    'Kobold',
    'Lich',
    'Lizard Man',
    'Manticore',
    'Medusa',
    'Mind Flayer',
    'Minotaur',
    'Mummy',
    'Naga, Guardian',
    'Nightmare',
    'Ogre',
    'Orc',
    'Owlbear',
    'Pegasus',
    'Phase Spider',
    'Purple Worm',
    'Quaggoth',
    'Rakshasa',
    'Remorhaz',
    'Roc',
    'Roper',
    'Rust Monster',
    'Satyr',
    'Shadow',
    'Skeleton',
    'Spectre',
    'Stirge',
    'Tarrasque',
    'Treant',
    'Troll',
    'Umber Hulk',
    'Unicorn',
    'Vampire',
    'Wight',
    "Will-o'-Wisp",
    'Wraith',
    'Wyvern',
    'Xorn',
    'Yuan-ti',
    'Zombie',
  ];

  /** Real `fetch` + AbortSignal, without a network dependency. */
  const MONSTERS_URL = URL.createObjectURL(
    new Blob([JSON.stringify(LOCAL_MONSTERS)], { type: 'application/json' }),
  );

  const escapeHtml = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');

  const filterMonsters = (list: string[], input: string) => {
    if (input.length < 1) return list;
    return list.filter((name) => name.toLowerCase().startsWith(input.toLowerCase()));
  };

  const classifyMonster = (name: string) => {
    const initial = name.trim().charAt(0).toUpperCase();
    return initial <= 'M' ? 'Aberrations & beasts' : 'Undermountain denizens';
  };

  const MONSTER_TYPES = [
    'Aberration',
    'Beast',
    'Dragon',
    'Giant',
    'Humanoid',
    'Monstrosity',
    'Undead',
  ] as const;

  const HABITATS = ['Underdark', 'Forest', 'Swamp', 'Mountains', 'Ruins', 'Urban'] as const;

  const hashString = (value: string) =>
    [...value].reduce((sum, char) => sum + char.charCodeAt(0), 0);

  const metaFor = (name: string) => {
    const seed = hashString(name);
    const type = MONSTER_TYPES[seed % MONSTER_TYPES.length];
    const habitat = HABITATS[(seed >> 3) % HABITATS.length];
    const cr = ((seed % 18) + 1) / 4;
    const crLabel = Number.isInteger(cr) ? String(cr) : cr.toFixed(1);
    const initials = name
      .split(/[\s,]+/)
      .map((part) => part.charAt(0))
      .join('')
      .slice(0, 2)
      .toUpperCase();
    const boss = 10 <= seed % 20;

    return { type, habitat, cr: crLabel, initials, boss };
  };

  const renderAdvancedResults = async (query: string, signal: AbortSignal) => {
    await new Promise<void>((resolve, reject) => {
      const timer = window.setTimeout(resolve, 180);
      const onAbort = () => {
        window.clearTimeout(timer);
        reject(signal.reason ?? new DOMException('Aborted', 'AbortError'));
      };
      if (signal.aborted) {
        onAbort();
        return;
      }
      signal.addEventListener('abort', onAbort, { once: true });
    });

    const matches = filterMonsters(LOCAL_MONSTERS, query);
    if (matches.length === 0) return '';

    const groups = new Map<string, string[]>();
    matches.forEach((name) => {
      const { type } = metaFor(name);
      const bucket = groups.get(type) ?? [];
      bucket.push(name);
      groups.set(type, bucket);
    });

    let optionIndex = 0;

    return [...groups.entries()]
      .map(([type, names]) => {
        const options = names
          .map((name) => {
            const { cr, habitat, initials, boss } = metaFor(name);
            const optionId = `docs-advanced-option-${optionIndex}`;
            optionIndex += 1;

            return `<div
  role="option"
  id="${optionId}"
  data-value="${escapeHtml(name)}"
  data-cr="${escapeHtml(cr)}"
  data-type="${escapeHtml(type)}"
  data-habitat="${escapeHtml(habitat)}"
>
  <div class="docs-combobox-rich-option">
    <span class="docs-combobox-rich-option__avatar" aria-hidden="true">${escapeHtml(initials)}</span>
    <span class="docs-combobox-rich-option__body">
      <span class="docs-combobox-rich-option__name">${escapeHtml(name)}</span>
      <span class="docs-combobox-rich-option__meta">CR ${escapeHtml(cr)}, ${escapeHtml(habitat)}</span>
    </span>
    ${boss ? '<span class="docs-combobox-rich-option__badge">Boss</span>' : ''}
  </div>
</div>`;
          })
          .join('');

        return `<div role="group" aria-label="${escapeHtml(type)}">
  <p class="docs-combobox-group-label">${escapeHtml(type)}</p>
  ${options}
</div>`;
      })
      .join('');
  };

  const renderGroupedResults = async (query: string, signal: AbortSignal) => {
    const response = await fetch(MONSTERS_URL, { signal });
    if (!response.ok) {
      throw new Error(`Failed to load monsters: ${response.status}`);
    }

    const remote = (await response.json()) as string[];
    const matches = filterMonsters(remote, query);
    if (matches.length === 0) return '';

    const groups = new Map<string, string[]>();
    matches.forEach((name) => {
      const group = classifyMonster(name);
      const bucket = groups.get(group) ?? [];
      bucket.push(name);
      groups.set(group, bucket);
    });

    let optionIndex = 0;

    return [...groups.entries()]
      .map(([label, names]) => {
        const options = names
          .map((name) => {
            const optionId = `docs-external-option-${optionIndex}`;
            optionIndex += 1;
            return `<div role="option" id="${optionId}" data-value="${escapeHtml(name)}">
  <a class="docs-combobox-option-link" href="#monster-${encodeURIComponent(name)}" tabindex="-1">
    ${escapeHtml(name)}
  </a>
</div>`;
          })
          .join('');

        return `<div role="group" aria-label="${escapeHtml(label)}">
  <p class="docs-combobox-group-label">${escapeHtml(label)}</p>
  ${options}
</div>`;
      })
      .join('');
  };

  // ── 1. Managed local ──────────────────────────────────────────────────────
  {
    const host = document.getElementById('docs-monster-local') as ComboboxHost | null;
    const status = document.querySelector('[data-combobox-status="local"]');
    if (host && status) {
      host.search = (value) => filterMonsters(LOCAL_MONSTERS, value);

      const button = host.querySelector('button[aria-controls]');
      if (button instanceof HTMLButtonElement) {
        wireOpenButton(host, button);
      }

      host.addEventListener(EVENTS.COMBOBOX_SUBMIT, (event) => {
        const { value } = (event as CustomEvent<{ value: string }>).detail;
        status.textContent = `Selected: ${value}`;
      });
    }
  }

  // ── 2. Async fetch + event log ────────────────────────────────────────────
  {
    const host = document.getElementById('docs-monster-api') as ComboboxHost | null;
    const status = document.querySelector('[data-combobox-status="api"]');
    const logEl = document.querySelector('[data-combobox-log="api"]');
    if (host && status && logEl) {
      const log = (message: string) => {
        const line = document.createElement('div');
        line.textContent = message;
        logEl.prepend(line);
      };

      host.search = async (value, { signal }) => {
        status.textContent = 'Loading...';

        const response = await fetch(MONSTERS_URL, { signal });
        if (!response.ok) {
          status.textContent = `Error ${response.status}`;
          throw new Error(`Failed to load monsters: ${response.status}`);
        }

        const remote = (await response.json()) as string[];

        // Keep busy/loading visible; honour abort while waiting.
        await new Promise<void>((resolve, reject) => {
          const timer = window.setTimeout(resolve, 350);
          const onAbort = () => {
            window.clearTimeout(timer);
            reject(signal.reason ?? new DOMException('Aborted', 'AbortError'));
          };
          if (signal.aborted) {
            onAbort();
            return;
          }
          signal.addEventListener('abort', onAbort, { once: true });
        });

        const results = filterMonsters(remote, value);
        status.textContent = `${results.length} result(s)`;
        return results;
      };

      host.addEventListener(EVENTS.COMBOBOX_LOADING, () => {
        status.textContent = 'Loading...';
        log('loading');
      });
      host.addEventListener(EVENTS.COMBOBOX_LOADED, () => log('loaded'));
      host.addEventListener(EVENTS.COMBOBOX_SUBMIT, (event) => {
        const { value, index } = (event as CustomEvent<{ value: string; index: number }>).detail;
        log(`submit: ${value} (index ${index})`);
      });
      host.addEventListener(EVENTS.COMBOBOX_UPDATE, (event) => {
        const { options, index, value } = (
          event as CustomEvent<{ options: unknown[]; index: number; value: string }>
        ).detail;
        log(`update value="${value}" index=${index} (${options.length})`);
      });
    }
  }

  // ── 3. External grouped ───────────────────────────────────────────────────
  {
    const host = document.getElementById('docs-monster-external') as ComboboxHost | null;
    const form = document.querySelector<HTMLFormElement>('[data-combobox-form="external"]');
    const emptyEl = document.querySelector<HTMLElement>('[data-combobox-empty="external"]');
    const liveEl = document.querySelector('[data-combobox-live="external"]');
    const hint = document.querySelector('[data-combobox-hint="external"]');

    if (host && form && emptyEl && liveEl && hint) {
      const hideEmpty = () => {
        emptyEl.textContent = '';
        emptyEl.classList.remove('is-visible');
        liveEl.textContent = '';
      };

      const showEmpty = (message: string) => {
        emptyEl.textContent = message;
        emptyEl.classList.add('is-visible');
        liveEl.textContent = message;
      };

      host.search = async (query, { signal }) => {
        hideEmpty();
        hint.textContent = `Searching "${query}"...`;
        const html = await renderGroupedResults(query, signal);
        return { html };
      };

      host.onSelect = ({ option, value }) => {
        const link = option?.element.querySelector('a');
        hint.textContent = link
          ? `Selected: ${value} (${link.getAttribute('href')})`
          : `Selected: ${value || '(empty)'}`;
      };

      host.addEventListener(EVENTS.COMBOBOX_EMPTY, (event) => {
        const { value } = (event as CustomEvent<{ value: string }>).detail;
        const message =
          value.trim().length < 2
            ? 'Type at least 2 characters to search.'
            : `No monsters match "${value}".`;
        showEmpty(message);
        hint.textContent = message;
      });

      host.addEventListener(EVENTS.COMBOBOX_LOADED, () => {
        if (host.options.length > 0) {
          hideEmpty();
          hint.textContent = `${host.options.length} result(s)`;
        }
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = host.querySelector<HTMLInputElement>('input');
        hint.textContent = `Form submit: q=${input?.value || '(empty)'}`;
      });
    }
  }

  // ── 4. Custom select ──────────────────────────────────────────────────────
  {
    const host = document.getElementById('docs-monster-custom') as ComboboxHost | null;
    const queryEl = document.querySelector('[data-combobox-query="custom"]');
    const pickedEl = document.querySelector('[data-combobox-picked="custom"]');

    if (host && queryEl && pickedEl) {
      const syncQuery = () => {
        queryEl.textContent = host.$input?.value || '-';
      };

      host.search = (value) => filterMonsters(LOCAL_MONSTERS, value);

      host.addEventListener(EVENTS.COMBOBOX_UPDATE, syncQuery);
      host.addEventListener(EVENTS.COMBOBOX_SUBMIT, (event) => {
        const { value } = (event as CustomEvent<{ value: string }>).detail;
        pickedEl.textContent = value || '-';
        syncQuery();
      });

      syncQuery();
    }
  }

  // ── 5. Advanced compendium ────────────────────────────────────────────────
  {
    const host = document.getElementById('docs-monster-advanced') as ComboboxHost | null;
    const emptyEl = document.querySelector<HTMLElement>('[data-combobox-empty="advanced"]');
    const filterEl = document.querySelector('[data-combobox-filter="advanced"]');
    const detailEl = document.querySelector<HTMLElement>('[data-combobox-detail="advanced"]');
    const clearBtn = document.querySelector<HTMLButtonElement>('[data-combobox-clear="advanced"]');

    if (host && emptyEl && filterEl && detailEl && clearBtn) {
      const hideEmpty = () => {
        emptyEl.textContent = '';
        emptyEl.classList.remove('is-visible');
      };

      const showEmpty = (message: string) => {
        emptyEl.textContent = message;
        emptyEl.classList.add('is-visible');
      };

      const syncFilter = () => {
        filterEl.textContent = host.$input?.value.trim() || '-';
      };

      const renderEmptyDetail = () => {
        detailEl.classList.add('is-empty');
        detailEl.innerHTML = `
          <p class="text-sm">Pick a creature from the list.</p>
          <p class="mt-1 text-xs text-gray-500">The search field keeps your filter.</p>
        `;
      };

      const renderDetail = (name: string, cr: string, type: string, habitat: string) => {
        const { initials } = metaFor(name);
        detailEl.classList.remove('is-empty');
        detailEl.innerHTML = `
          <p class="docs-combobox-detail__eyebrow">Compendium entry</p>
          <h4 class="docs-combobox-detail__title">${escapeHtml(name)}</h4>
          <dl class="docs-combobox-detail__stats">
            <div class="docs-combobox-detail__stat">
              <dt>Challenge</dt>
              <dd>CR ${escapeHtml(cr)}</dd>
            </div>
            <div class="docs-combobox-detail__stat">
              <dt>Type</dt>
              <dd>${escapeHtml(type)}</dd>
            </div>
            <div class="docs-combobox-detail__stat">
              <dt>Habitat</dt>
              <dd>${escapeHtml(habitat)}</dd>
            </div>
          </dl>
          <p class="docs-combobox-detail__blurb">
            ${escapeHtml(initials)}: ${escapeHtml(name)} indexed from the Undermountain bestiary.
            Selection came from <code>combobox:submit</code>; the filter field was not overwritten.
          </p>
        `;
      };

      host.search = async (query, { signal }) => {
        hideEmpty();
        syncFilter();
        const html = await renderAdvancedResults(query, signal);
        return { html };
      };

      host.addEventListener(EVENTS.COMBOBOX_UPDATE, syncFilter);
      host.addEventListener(EVENTS.COMBOBOX_EMPTY, (event) => {
        const { value } = (event as CustomEvent<{ value: string }>).detail;
        showEmpty(`No creatures match "${value}".`);
      });
      host.addEventListener(EVENTS.COMBOBOX_LOADED, () => {
        if (0 < host.options.length) hideEmpty();
      });
      host.addEventListener(EVENTS.COMBOBOX_SUBMIT, (event) => {
        const { option, value } = (
          event as CustomEvent<{ option: { element: HTMLElement } | null; value: string }>
        ).detail;
        const element = option?.element;
        const cr = element?.dataset.cr ?? metaFor(value).cr;
        const type = element?.dataset.type ?? metaFor(value).type;
        const habitat = element?.dataset.habitat ?? metaFor(value).habitat;

        renderDetail(value, cr, type, habitat);
        syncFilter();
      });

      clearBtn.addEventListener('click', () => {
        renderEmptyDetail();
        host.setValue('');
        host.hide({ force: true });
        syncFilter();
        hideEmpty();
        host.$input?.focus();
      });

      renderEmptyDetail();
      syncFilter();
    }
  }
</script>
