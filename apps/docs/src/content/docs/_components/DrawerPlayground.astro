---
import PortalToBody from "./PortalToBody.astro";
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<div class="not-content">
  <section class="rounded-2xl bg-elevated p-6 shadow flex flex-col gap-4 border border-default">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-semibold text-primary">Bestiary drawer</h3>
        <p class="text-sm text-muted">
          A slide-in bestiary panel: backdrop, scroll lock, and a tally of creatures
          catalogued from your AD&amp;D campaign.
        </p>
      </div>
      <cinq-drawer-button class="block">
        <button
          class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
          aria-controls="bestiary-drawer-demo"
          aria-expanded="false"
        >
          Open bestiary
        </button>
      </cinq-drawer-button>
    </div>

    <div
      class="flex items-center justify-between rounded-lg bg-surface px-3 py-2 text-sm text-body"
    >
      <span>Entries catalogued</span>
      <span class="font-semibold" data-cart-count>3 creatures</span>
    </div>

    <cinq-drawer id="bestiary-drawer-demo">
      <dialog
        aria-labelledby="bestiary-drawer-demo-title"
        class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-full max-w-md border-0 p-0 bg-elevated shadow-2xl transition-[translate,overlay,display] transition-discrete duration-300 backdrop:bg-overlay-scrim backdrop:opacity-0 backdrop:transition-[opacity,overlay,display] backdrop:transition-discrete backdrop:duration-300 open:translate-x-0 open:backdrop:opacity-100 starting:open:backdrop:opacity-0 translate-x-full starting:open:translate-x-full"
      >
        <div class="flex h-full flex-col">
          <header class="flex items-center justify-between border-b px-6 py-4">
            <h2 id="bestiary-drawer-demo-title" class="text-lg font-semibold text-primary">Bestiary</h2>
            <cinq-drawer-button class="block">
              <button
                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-body hover:bg-surface-hover focus:outline-none focus:ring-2 focus:ring-focus-ring/20"
                aria-controls="bestiary-drawer-demo"
                aria-expanded="false"
              >
                ✕
              </button>
            </cinq-drawer-button>
          </header>

          <div class="flex-1 overflow-y-auto px-6 py-4 flex flex-col gap-3" data-cart-list>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-medium text-primary">Troll</p>
                <p class="text-xs text-muted">
                  Regenerates quickly. Best handled with fire or acid.
                </p>
              </div>
              <span class="text-sm text-body whitespace-nowrap tabular-nums">120 gp</span>
            </div>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-medium text-primary">Dracolich skull</p>
                <p class="text-xs text-muted">
                  A trophy from an undead dragon. Radiates faint necromancy.
                </p>
              </div>
              <span class="text-sm text-body whitespace-nowrap tabular-nums">2 500 gp</span>
            </div>
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-medium text-primary">Galeb duhr statuette</p>
                <p class="text-xs text-muted">
                  Looks like a boulder, watches like a sentry.
                </p>
              </div>
              <span class="text-sm text-body whitespace-nowrap tabular-nums">350 gp</span>
            </div>
          </div>

          <footer class="border-t px-6 py-4 flex items-center justify-between gap-3">
            <div class="text-sm text-body">
              Total: <span class="font-semibold" data-cart-total>2 970 gp</span>
            </div>
            <button
              type="button"
              class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover text-sm"
            >
              Add to encounter
            </button>
          </footer>
        </div>
      </dialog>
    </cinq-drawer>

    <PortalToBody selector="#bestiary-drawer-demo" />
  </section>
</div>
