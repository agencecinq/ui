---
---

<section class="rounded-2xl bg-elevated p-6 shadow not-content border border-default">
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-semibold text-primary">Destroy / Create</h3>
        <p class="text-sm text-muted">
          Useful when you mutate the DOM and want to re-bind events.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
          data-action="destroy"
        >
          Destroy
        </button>
        <button
          type="button"
          class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
          data-action="create"
        >
          Create
        </button>
      </div>
    </div>

    <cinq-tabs
      class="block flex flex-col gap-4"
      data-hash="false"
      data-delay="0"
      data-demo="destroy"
    >
      <div
        role="tablist"
        aria-label="Bestiary tabs"
        class="inline-flex gap-2 rounded-lg bg-surface p-1"
      >
        <button
          type="button"
          class="aria-selected:bg-accent-default aria-selected:text-on-accent text-body hover:bg-surface-hover px-3 py-1.5 text-sm font-medium rounded-md"
          role="tab"
          aria-selected="true"
          aria-controls="demo-dc-troll-panel"
          id="demo-dc-troll"
        >
          Troll
        </button>
        <button
          type="button"
          class="aria-selected:bg-accent-default aria-selected:text-on-accent text-body hover:bg-surface-hover px-3 py-1.5 text-sm font-medium rounded-md"
          role="tab"
          aria-selected="false"
          aria-controls="demo-dc-galeb-panel"
          id="demo-dc-galeb"
          tabindex="-1"
        >
          Galeb Duhr
        </button>
      </div>

      <section
        tabindex="0"
        role="tabpanel"
        aria-labelledby="demo-dc-troll"
        id="demo-dc-troll-panel"
        class="rounded-xl bg-surface p-4"
      >
        <p class="text-body">
          Trolls regenerate 3 hp per round unless burned or acid-treated.
        </p>
      </section>
      <section
        tabindex="0"
        role="tabpanel"
        aria-labelledby="demo-dc-galeb"
        id="demo-dc-galeb-panel"
        class="rounded-xl bg-surface p-4"
        hidden
      >
        <p class="text-body">Looks like a boulder until it animates. Then the fists start flying.</p>
      </section>
    </cinq-tabs>
  </div>
</section>

<script>
  // Destroy / Create demo
  {
    const root = document.querySelector('[data-demo="destroy"]')?.closest('section');
    const tabsEl = document.querySelector('cinq-tabs[data-demo="destroy"]');
    if (root && tabsEl) {
      root.querySelector('[data-action="destroy"]')?.addEventListener('click', () => tabsEl.destroy());
      root.querySelector('[data-action="create"]')?.addEventListener('click', () => tabsEl.init());
    }
  }
</script>

