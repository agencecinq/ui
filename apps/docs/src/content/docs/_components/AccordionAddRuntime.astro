---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-accordion-add [role='region'] {
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .docs-accordion-add > [data-panel]:first-child > [data-header] {
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  .docs-accordion-add > [data-panel]:last-child > [data-header][aria-expanded='false'] {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .docs-accordion-add > [data-panel]:last-child [data-inner] {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .docs-accordion-add-chevron {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    margin-top: -0.125rem;
    transition: transform 0.2s ease;
  }

  .docs-accordion-add [data-header][aria-expanded='true'] .docs-accordion-add-chevron {
    transform: rotate(-135deg);
    margin-top: 0.125rem;
  }

  .docs-accordion-add [data-header].focus {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -2px;
  }
</style>

<section class="rounded-2xl bg-elevated p-6 shadow not-content border border-default" data-demo-root="accordion-add">
  <div class="flex flex-col gap-4">
    <div>
      <h3 class="text-lg font-semibold text-primary">Add panels at runtime</h3>
      <p class="text-sm text-muted">
        The pattern is: <code class="font-mono">destroy()</code>, mutate DOM,{' '}
        <code class="font-mono">init()</code>.
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 max-w-xl">
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-body">Label</span>
        <input
          class="w-full rounded-lg border border-default px-3 py-2 text-sm"
          type="text"
          placeholder="E.g. Cloaker"
          data-input="label"
        />
      </label>
      <label class="block">
        <span class="mb-1 block text-sm font-medium text-body">Content</span>
        <input
          class="w-full rounded-lg border border-default px-3 py-2 text-sm"
          type="text"
          placeholder="E.g. Hangs from the ceiling..."
          data-input="content"
        />
      </label>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
        data-action="add"
      >
        Add
      </button>
      <button
        type="button"
        class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
        data-action="destroy"
      >
        Destroy
      </button>
      <button
        type="button"
        class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
        data-action="create"
      >
        Create
      </button>
    </div>

    <cinq-accordion
      class="docs-accordion-add max-w-xl overflow-hidden rounded-xl border border-default divide-y divide-default"
      data-hash="false"
      data-demo="accordion-add"
    >
      <div data-panel data-open="true" data-deselectable="true">
        <button
          type="button"
          data-header
          id="docs-accordion-add-galeb-header"
          class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover aria-expanded:bg-accent-default aria-expanded:text-on-accent aria-expanded:hover:bg-accent-hover"
          aria-expanded="true"
          aria-controls="docs-accordion-add-galeb-body"
        >
          Galeb Duhr
          <span class="docs-accordion-add-chevron" aria-hidden="true"></span>
        </button>
        <div
          id="docs-accordion-add-galeb-body"
          role="region"
          aria-labelledby="docs-accordion-add-galeb-header"
        >
          <div
            data-inner
            class="border-t border-dashed border-default bg-surface px-4 py-4 text-sm leading-relaxed text-body"
          >
            <p class="m-0">
              The galeb duhr is a curious boulder-like creature with appendages that act as hands and
              feet.
            </p>
          </div>
        </div>
      </div>

      <div data-panel data-open="false">
        <button
          type="button"
          data-header
          id="docs-accordion-add-troll-header"
          class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover aria-expanded:bg-accent-default aria-expanded:text-on-accent aria-expanded:hover:bg-accent-hover"
          aria-expanded="false"
          aria-controls="docs-accordion-add-troll-body"
        >
          Troll
          <span class="docs-accordion-add-chevron" aria-hidden="true"></span>
        </button>
        <div
          id="docs-accordion-add-troll-body"
          role="region"
          aria-labelledby="docs-accordion-add-troll-header"
          hidden
        >
          <div
            data-inner
            class="border-t border-dashed border-default bg-surface px-4 py-4 text-sm leading-relaxed text-body"
          >
            <p class="m-0">
              Trolls are horrid carnivores found in all climes, from arctic wastelands to tropical
              jungles.
            </p>
          </div>
        </div>
      </div>
    </cinq-accordion>
  </div>
</section>

<script>
  const slugify = (input) =>
    input
      .toLowerCase()
      .trim()
      .replace(/['"]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

  const escapeHtml = (value) =>
    value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

  const headerClass =
    'flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover aria-expanded:bg-accent-default aria-expanded:text-on-accent aria-expanded:hover:bg-accent-hover';

  const innerClass =
    'border-t border-dashed border-default bg-surface px-4 py-4 text-sm leading-relaxed text-body';

  {
    const root = document.querySelector('[data-demo-root="accordion-add"]');
    const accordion = document.querySelector('cinq-accordion[data-demo="accordion-add"]');
    const labelInput = root?.querySelector('[data-input="label"]');
    const contentInput = root?.querySelector('[data-input="content"]');

    root?.querySelector('[data-action="destroy"]')?.addEventListener('click', () => {
      accordion?.destroy();
    });

    root?.querySelector('[data-action="create"]')?.addEventListener('click', () => {
      accordion?.init();
    });

    root?.querySelector('[data-action="add"]')?.addEventListener('click', () => {
      if (!(accordion && labelInput && contentInput)) return;

      const label = labelInput.value.trim();
      const content = contentInput.value.trim();
      if (!label || !content) return;

      const slug = slugify(label) || `panel-${Date.now()}`;
      const headerId = `docs-accordion-add-${slug}-header`;
      const bodyId = `docs-accordion-add-${slug}-body`;

      if (document.getElementById(headerId)) {
        labelInput.focus();
        return;
      }

      accordion.destroy();

      accordion.insertAdjacentHTML(
        'beforeend',
        `<div data-panel data-open="false">
          <button
            type="button"
            data-header
            id="${headerId}"
            class="${headerClass}"
            aria-expanded="false"
            aria-controls="${bodyId}"
          >
            ${escapeHtml(label)}
            <span class="docs-accordion-add-chevron" aria-hidden="true"></span>
          </button>
          <div
            id="${bodyId}"
            role="region"
            aria-labelledby="${headerId}"
            hidden
          >
            <div data-inner class="${innerClass}">
              <p class="m-0">${escapeHtml(content)}</p>
            </div>
          </div>
        </div>`,
      );

      accordion.init();
      labelInput.value = '';
      contentInput.value = '';
      labelInput.focus();
    });
  }
</script>
