---
import PortalToBody from './PortalToBody.astro';
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  /* Portal of summoning: deliberately excessive, driven by data-direction only. */
  @media (prefers-reduced-motion: no-preference) {
    #docs-drilldown-portal {
      perspective: 800px;
    }

    #docs-drilldown-portal[data-direction] > * {
      transition:
        opacity 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
        transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),
        filter 0.8s ease-out,
        box-shadow 0.8s ease-out,
        display 0.8s allow-discrete;
    }

    #docs-drilldown-portal[data-direction] > [hidden] {
      opacity: 0;
      filter: blur(12px) hue-rotate(180deg) saturate(3);
      pointer-events: none;
    }

    #docs-drilldown-portal[data-direction='forward'] > [hidden] {
      transform: translateX(-60%) rotateY(75deg) scale(0.5);
    }

    #docs-drilldown-portal[data-direction='back'] > [hidden] {
      transform: translateX(60%) rotateY(-75deg) scale(0.5);
    }

    @starting-style {
      #docs-drilldown-portal[data-direction] > :not([hidden]) {
        opacity: 0;
        filter: blur(12px) hue-rotate(-180deg) saturate(3);
        box-shadow: 0 0 4rem 1rem rgb(168 85 247);
      }

      #docs-drilldown-portal[data-direction='forward'] > :not([hidden]) {
        transform: translateX(60%) rotateY(-75deg) scale(0.5);
      }

      #docs-drilldown-portal[data-direction='back'] > :not([hidden]) {
        transform: translateX(-60%) rotateY(75deg) scale(0.5);
      }
    }
  }
</style>


<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Bestiary navigation</h3>
          <p class="text-sm text-muted">
            Three levels deep. Triggers open their child panel, the back button returns to the
            parent and focus goes back to the trigger. The Undead panel focuses its heading
            with <code>data-autofocus</code>. Open/close events are logged below.
          </p>
        </div>

        <cinq-drilldown
          id="docs-drilldown"
          class="relative h-80 overflow-hidden rounded-lg border border-default"
        >
          <nav id="docs-drilldown-root" aria-label="Bestiary" class="h-full overflow-y-auto bg-elevated p-4 text-primary">
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-dragons"
                >
                  Dragons <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-undead"
                >
                  Undead <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Random encounter table</a>
              </li>
            </ul>
          </nav>

          <nav id="docs-drilldown-dragons" aria-label="Dragons" class="h-full overflow-y-auto bg-elevated p-4 text-primary" hidden>
            <button
              type="button"
              class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
              data-close
            >
              <span aria-hidden="true">←</span> Back to bestiary
            </button>
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-chromatic"
                >
                  Chromatic <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Metallic</a>
              </li>
            </ul>
          </nav>

          <nav id="docs-drilldown-chromatic" aria-label="Chromatic dragons" class="h-full overflow-y-auto bg-elevated p-4 text-primary" hidden>
            <button
              type="button"
              class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
              data-close
            >
              <span aria-hidden="true">←</span> Back to dragons
            </button>
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Red dragon</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Blue dragon</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Green dragon</a></li>
            </ul>
          </nav>

          <nav id="docs-drilldown-undead" aria-labelledby="docs-drilldown-undead-title" class="h-full overflow-y-auto bg-elevated p-4 text-primary" hidden>
            <button
              type="button"
              class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
              data-close
            >
              <span aria-hidden="true">←</span> Back to bestiary
            </button>
            <h4 id="docs-drilldown-undead-title" tabindex="-1" data-autofocus class="mt-0 mb-3 px-1 text-base font-semibold text-primary">Undead</h4>
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Lich</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Vampire</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Beholder zombie</a></li>
            </ul>
          </nav>
        </cinq-drilldown>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-drilldown-close-all"
            class="rounded-lg bg-accent-default px-3 py-2 text-on-accent hover:bg-accent-hover"
          >
            closeAll()
          </button>
        </div>

        <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
          Last event: <span id="docs-drilldown-status" class="font-mono font-medium text-primary">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Portal of summoning</h3>
          <p class="text-sm text-muted">
            Deliberately over the top, to show what <code>data-direction</code> allows. The host
            reflects <code>forward</code> or <code>back</code> before each change, and pure CSS
            spins the panels through a portal: 3D turn, scale, blur and hue shift, with an
            overshooting curve. <code>closeAll()</code> removes the attribute, so the reset is
            instant. Skipped when you prefer reduced motion.
          </p>
        </div>

        <cinq-drilldown
          id="docs-drilldown-portal"
          class="relative block h-80 rounded-lg bg-accent-default"
        >
          <nav id="docs-drilldown-portal-root" aria-label="Planes of existence" class="absolute inset-0 overflow-y-auto rounded-lg bg-elevated p-4 text-primary">
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-portal-outer"
                >
                  Outer planes <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-portal-elemental"
                >
                  Elemental planes <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Material plane</a>
              </li>
            </ul>
          </nav>

          <nav id="docs-drilldown-portal-outer" aria-label="Outer planes" class="absolute inset-0 overflow-y-auto rounded-lg bg-elevated p-4 text-primary" hidden>
            <button type="button" class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover" data-close>
              <span aria-hidden="true">←</span> Back to the planes
            </button>
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-portal-abyss"
                >
                  The Abyss <span aria-hidden="true">→</span>
                </button>
              </li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Mount Celestia</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Limbo</a></li>
            </ul>
          </nav>

          <nav id="docs-drilldown-portal-abyss" aria-label="The Abyss" class="absolute inset-0 overflow-y-auto rounded-lg bg-elevated p-4 text-primary" hidden>
            <button type="button" class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover" data-close>
              <span aria-hidden="true">←</span> Back to the outer planes
            </button>
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Demogorgon</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Orcus</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Lolth</a></li>
            </ul>
          </nav>

          <nav id="docs-drilldown-portal-elemental" aria-label="Elemental planes" class="absolute inset-0 overflow-y-auto rounded-lg bg-elevated p-4 text-primary" hidden>
            <button type="button" class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover" data-close>
              <span aria-hidden="true">←</span> Back to the planes
            </button>
            <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Plane of Fire</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Plane of Water</a></li>
              <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Plane of Air</a></li>
            </ul>
          </nav>
        </cinq-drilldown>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-drilldown-portal-close-all"
            class="rounded-lg bg-accent-default px-3 py-2 text-on-accent hover:bg-accent-hover"
          >
            closeAll()
          </button>
        </div>

        <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
          <code>data-direction</code>: <span id="docs-drilldown-portal-status" class="font-mono font-medium text-primary">none</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Inside a drawer</h3>
          <p class="text-sm text-muted">
            The drawer's modal dialog makes the page inert and hidden panels are not focusable,
            so Tab only cycles through the drawer header and the visible panel. Closing the
            drawer resets the drilldown with <code>closeAll()</code>.
          </p>
        </div>
        <cinq-drawer-button class="block shrink-0">
          <button
            type="button"
            class="rounded-lg bg-accent-default px-3 py-2 text-on-accent hover:bg-accent-hover"
            aria-controls="docs-drilldown-drawer"
            aria-expanded="false"
          >
            Open menu
          </button>
        </cinq-drawer-button>
      </div>
    </section>

    <cinq-drawer id="docs-drilldown-drawer">
      <dialog
        aria-labelledby="docs-drilldown-drawer-title"
        class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-full max-w-sm border-0 p-0 bg-elevated shadow-2xl transition-[translate,overlay,display] transition-discrete duration-300 backdrop:bg-overlay-scrim backdrop:opacity-0 backdrop:transition-[opacity,overlay,display] backdrop:transition-discrete backdrop:duration-300 open:translate-x-0 open:backdrop:opacity-100 starting:open:backdrop:opacity-0 translate-x-full starting:open:translate-x-full"
      >
        <div class="flex h-full flex-col">
          <header class="flex items-center justify-between border-b px-6 py-4">
            <h2 id="docs-drilldown-drawer-title" class="text-lg font-semibold text-primary">Grimoire</h2>
            <cinq-drawer-button class="block">
              <button
                type="button"
                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-body hover:bg-surface-hover"
                aria-label="Close menu"
                aria-controls="docs-drilldown-drawer"
                aria-expanded="false"
              >
                ✕
              </button>
            </cinq-drawer-button>
          </header>

          <cinq-drilldown id="docs-drilldown-in-drawer" class="relative min-h-0 flex-1">
            <nav id="docs-drilldown-in-drawer-root" aria-label="Grimoire" class="h-full overflow-y-auto bg-elevated p-4 text-primary">
              <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
                <li>
                  <button
                    type="button"
                    class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                    aria-expanded="false"
                    aria-controls="docs-drilldown-in-drawer-arcane"
                  >
                    Arcane spells <span aria-hidden="true">→</span>
                  </button>
                </li>
                <li>
                  <button
                    type="button"
                    class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                    aria-expanded="false"
                    aria-controls="docs-drilldown-in-drawer-divine"
                  >
                    Divine spells <span aria-hidden="true">→</span>
                  </button>
                </li>
                <li>
                  <a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Spell components</a>
                </li>
              </ul>
            </nav>

            <nav id="docs-drilldown-in-drawer-arcane" aria-label="Arcane spells" class="h-full overflow-y-auto bg-elevated p-4 text-primary" hidden>
              <button
                type="button"
                class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                data-close
              >
                <span aria-hidden="true">←</span> Back to grimoire
              </button>
              <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
                <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Magic missile</a></li>
                <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Fireball</a></li>
                <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Lightning bolt</a></li>
              </ul>
            </nav>

            <nav id="docs-drilldown-in-drawer-divine" aria-label="Divine spells" class="h-full overflow-y-auto bg-elevated p-4 text-primary" hidden>
              <button
                type="button"
                class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-primary transition-colors hover:bg-surface-hover"
                data-close
              >
                <span aria-hidden="true">←</span> Back to grimoire
              </button>
              <ul class="m-0 list-none divide-y divide-default overflow-hidden rounded-xl border border-default p-0">
                <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Cure light wounds</a></li>
                <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Bless</a></li>
                <li><a href="#" class="block bg-surface px-4 py-3 text-sm font-medium text-primary no-underline transition-colors hover:bg-surface-hover">Turn undead</a></li>
              </ul>
            </nav>
          </cinq-drilldown>
        </div>
      </dialog>
    </cinq-drawer>

    <PortalToBody selector="#docs-drilldown-drawer" />
  </div>
</div>

<script>
  import { EVENTS } from '@agencecinq/utils';
  import type { Drilldown, Detail } from '@agencecinq/drilldown';

  const $host = document.getElementById('docs-drilldown') as Drilldown | null;
  const $status = document.getElementById('docs-drilldown-status');
  const $closeAll = document.getElementById('docs-drilldown-close-all');

  const log = (event: Event) => {
    const { detail, type } = event as CustomEvent<Detail>;

    if ($status) {
      $status.textContent = `${type} #${detail.previous.id} → #${detail.panel.id}`;
    }
  };

  $host?.addEventListener(EVENTS.DRILLDOWN_OPEN, log);
  $host?.addEventListener(EVENTS.DRILLDOWN_CLOSE, log);
  $closeAll?.addEventListener('click', () => $host?.closeAll());

  const $portal = document.getElementById('docs-drilldown-portal') as Drilldown | null;
  const $portalStatus = document.getElementById('docs-drilldown-portal-status');

  if ($portal && $portalStatus) {
    new MutationObserver(() => {
      $portalStatus.textContent = $portal.dataset.direction ?? 'none';
    }).observe($portal, { attributeFilter: ['data-direction'] });
  }

  document
    .getElementById('docs-drilldown-portal-close-all')
    ?.addEventListener('click', () => $portal?.closeAll());

  const $drawerDrilldown = document.getElementById('docs-drilldown-in-drawer') as Drilldown | null;

  document.documentElement.addEventListener(EVENTS.DRAWER_CLOSE, (event) => {
    if ((event as CustomEvent<{ drawer: string }>).detail.drawer === 'docs-drilldown-drawer') {
      $drawerDrilldown?.closeAll();
    }
  });
</script>
