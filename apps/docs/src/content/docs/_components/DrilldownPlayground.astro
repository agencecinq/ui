---
import PortalToBody from './PortalToBody.astro';
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Bestiary navigation</h3>
          <p class="text-sm text-gray-600">
            Three levels deep. Triggers open their child panel, the back button returns to the
            parent and focus goes back to the trigger. The Undead panel focuses its heading
            with <code>autofocus</code>. Open/close events are logged below.
          </p>
        </div>

        <cinq-drilldown
          id="docs-drilldown"
          class="relative h-80 overflow-hidden rounded-lg border border-gray-200"
        >
          <nav id="docs-drilldown-root" aria-label="Bestiary" class="h-full overflow-y-auto bg-white p-4 text-gray-900">
            <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-gray-50 px-4 py-3 text-left text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-dragons"
                >
                  Dragons <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-gray-50 px-4 py-3 text-left text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-undead"
                >
                  Undead <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Random encounter table</a>
              </li>
            </ul>
          </nav>

          <nav id="docs-drilldown-dragons" aria-label="Dragons" class="h-full overflow-y-auto bg-white p-4 text-gray-900" hidden>
            <button
              type="button"
              class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
              data-close
            >
              <span aria-hidden="true">←</span> Back to bestiary
            </button>
            <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
              <li>
                <button
                  type="button"
                  class="flex w-full items-center justify-between gap-3 bg-gray-50 px-4 py-3 text-left text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                  aria-expanded="false"
                  aria-controls="docs-drilldown-chromatic"
                >
                  Chromatic <span aria-hidden="true">→</span>
                </button>
              </li>
              <li>
                <a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Metallic</a>
              </li>
            </ul>
          </nav>

          <nav id="docs-drilldown-chromatic" aria-label="Chromatic dragons" class="h-full overflow-y-auto bg-white p-4 text-gray-900" hidden>
            <button
              type="button"
              class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
              data-close
            >
              <span aria-hidden="true">←</span> Back to dragons
            </button>
            <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
              <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Red dragon</a></li>
              <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Blue dragon</a></li>
              <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Green dragon</a></li>
            </ul>
          </nav>

          <nav id="docs-drilldown-undead" aria-labelledby="docs-drilldown-undead-title" class="h-full overflow-y-auto bg-white p-4 text-gray-900" hidden>
            <button
              type="button"
              class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
              data-close
            >
              <span aria-hidden="true">←</span> Back to bestiary
            </button>
            <h4 id="docs-drilldown-undead-title" tabindex="-1" autofocus class="mt-0 mb-3 px-1 text-base font-semibold text-gray-900">Undead</h4>
            <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
              <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Lich</a></li>
              <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Vampire</a></li>
              <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Beholder zombie</a></li>
            </ul>
          </nav>
        </cinq-drilldown>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-drilldown-close-all"
            class="rounded-lg bg-black px-3 py-2 text-white hover:bg-gray-800"
          >
            closeAll()
          </button>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Last event: <span id="docs-drilldown-status" class="font-mono font-medium text-gray-900">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Inside a drawer</h3>
          <p class="text-sm text-gray-600">
            The drawer's modal dialog makes the page inert and hidden panels are not focusable,
            so Tab only cycles through the drawer header and the visible panel. Closing the
            drawer resets the drilldown with <code>closeAll()</code>.
          </p>
        </div>
        <cinq-drawer-button class="block shrink-0">
          <button
            type="button"
            class="rounded-lg bg-black px-3 py-2 text-white hover:bg-gray-800"
            aria-controls="docs-drilldown-drawer"
            aria-expanded="false"
          >
            Open menu
          </button>
        </cinq-drawer-button>
      </div>
    </section>

    <cinq-drawer id="docs-drilldown-drawer">
      <dialog
        aria-labelledby="docs-drilldown-drawer-title"
        class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-full max-w-sm border-0 p-0 bg-white shadow-2xl transition-[translate,overlay,display] transition-discrete duration-300 backdrop:bg-black/50 backdrop:opacity-0 backdrop:transition-[opacity,overlay,display] backdrop:transition-discrete backdrop:duration-300 open:translate-x-0 open:backdrop:opacity-100 starting:open:backdrop:opacity-0 translate-x-full starting:open:translate-x-full"
      >
        <div class="flex h-full flex-col">
          <header class="flex items-center justify-between border-b px-6 py-4">
            <h2 id="docs-drilldown-drawer-title" class="text-lg font-semibold text-gray-900">Grimoire</h2>
            <cinq-drawer-button class="block">
              <button
                type="button"
                class="inline-flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-gray-100"
                aria-label="Close menu"
                aria-controls="docs-drilldown-drawer"
                aria-expanded="false"
              >
                ✕
              </button>
            </cinq-drawer-button>
          </header>

          <cinq-drilldown id="docs-drilldown-in-drawer" class="relative min-h-0 flex-1">
            <nav id="docs-drilldown-in-drawer-root" aria-label="Grimoire" class="h-full overflow-y-auto bg-white p-4 text-gray-900">
              <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
                <li>
                  <button
                    type="button"
                    class="flex w-full items-center justify-between gap-3 bg-gray-50 px-4 py-3 text-left text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                    aria-expanded="false"
                    aria-controls="docs-drilldown-in-drawer-arcane"
                  >
                    Arcane spells <span aria-hidden="true">→</span>
                  </button>
                </li>
                <li>
                  <button
                    type="button"
                    class="flex w-full items-center justify-between gap-3 bg-gray-50 px-4 py-3 text-left text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                    aria-expanded="false"
                    aria-controls="docs-drilldown-in-drawer-divine"
                  >
                    Divine spells <span aria-hidden="true">→</span>
                  </button>
                </li>
                <li>
                  <a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Spell components</a>
                </li>
              </ul>
            </nav>

            <nav id="docs-drilldown-in-drawer-arcane" aria-label="Arcane spells" class="h-full overflow-y-auto bg-white p-4 text-gray-900" hidden>
              <button
                type="button"
                class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                data-close
              >
                <span aria-hidden="true">←</span> Back to grimoire
              </button>
              <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
                <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Magic missile</a></li>
                <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Fireball</a></li>
                <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Lightning bolt</a></li>
              </ul>
            </nav>

            <nav id="docs-drilldown-in-drawer-divine" aria-label="Divine spells" class="h-full overflow-y-auto bg-white p-4 text-gray-900" hidden>
              <button
                type="button"
                class="mb-3 rounded-lg px-3 py-2 text-sm font-medium text-gray-900 transition-colors hover:bg-gray-100"
                data-close
              >
                <span aria-hidden="true">←</span> Back to grimoire
              </button>
              <ul class="m-0 list-none divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 p-0">
                <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Cure light wounds</a></li>
                <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Bless</a></li>
                <li><a href="#" class="block bg-gray-50 px-4 py-3 text-gray-900 no-underline transition-colors hover:bg-gray-100">Turn undead</a></li>
              </ul>
            </nav>
          </cinq-drilldown>
        </div>
      </dialog>
    </cinq-drawer>

    <PortalToBody selector="#docs-drilldown-drawer" />
  </div>
</div>

<script>
  import { EVENTS } from '@agencecinq/utils';
  import type { Drilldown, Detail } from '@agencecinq/drilldown';

  const $host = document.getElementById('docs-drilldown') as Drilldown | null;
  const $status = document.getElementById('docs-drilldown-status');
  const $closeAll = document.getElementById('docs-drilldown-close-all');

  const log = (event: Event) => {
    const { detail, type } = event as CustomEvent<Detail>;

    if ($status) {
      $status.textContent = `${type} #${detail.previous.id} → #${detail.panel.id}`;
    }
  };

  $host?.addEventListener(EVENTS.DRILLDOWN_OPEN, log);
  $host?.addEventListener(EVENTS.DRILLDOWN_CLOSE, log);
  $closeAll?.addEventListener('click', () => $host?.closeAll());

  const $drawerDrilldown = document.getElementById('docs-drilldown-in-drawer') as Drilldown | null;

  document.documentElement.addEventListener(EVENTS.DRAWER_CLOSE, (event) => {
    if ((event as CustomEvent<{ drawer: string }>).detail.drawer === 'docs-drilldown-drawer') {
      $drawerDrilldown?.closeAll();
    }
  });
</script>
