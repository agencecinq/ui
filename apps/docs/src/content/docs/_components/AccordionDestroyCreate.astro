---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-accordion-runtime [role='region'] {
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .docs-accordion-runtime > [data-panel]:first-child > [data-header] {
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  .docs-accordion-runtime > [data-panel]:last-child > [data-header][aria-expanded='false'] {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .docs-accordion-runtime > [data-panel]:last-child [data-inner] {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .docs-accordion-runtime-chevron {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    flex-shrink: 0;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    margin-top: -0.125rem;
    transition: transform 0.2s ease;
  }

  .docs-accordion-runtime [data-header][aria-expanded='true'] .docs-accordion-runtime-chevron {
    transform: rotate(-135deg);
    margin-top: 0.125rem;
  }

  .docs-accordion-runtime [data-header].focus {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: -2px;
  }

  .docs-accordion-runtime[data-unbound] {
    opacity: 0.55;
  }

  .docs-accordion-runtime[data-unbound] [data-header] {
    pointer-events: none;
    cursor: not-allowed;
  }
</style>

<section class="rounded-2xl bg-elevated p-6 shadow not-content border border-default" data-demo-root="accordion-destroy">
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-semibold text-primary">Destroy / Create</h3>
        <p class="text-sm text-muted">
          Useful when you mutate the DOM and want to re-bind events.
          Pattern: <code class="font-mono">destroy()</code>, mutate,{' '}
          <code class="font-mono">init()</code>.
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
          data-action="destroy"
        >
          Destroy
        </button>
        <button
          type="button"
          class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
          data-action="create"
        >
          Create
        </button>
      </div>
    </div>

    <cinq-accordion
      class="docs-accordion-runtime max-w-xl overflow-hidden rounded-xl border border-default divide-y divide-default"
      data-hash="false"
      data-demo="accordion-destroy"
    >
      <div data-panel data-open="true" data-deselectable="true">
        <button
          type="button"
          data-header
          id="docs-accordion-dc-1-header"
          class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover aria-expanded:bg-accent-default aria-expanded:text-on-accent aria-expanded:hover:bg-accent-hover"
          aria-expanded="true"
          aria-controls="docs-accordion-dc-1-body"
        >
          Troll
          <span class="docs-accordion-runtime-chevron" aria-hidden="true"></span>
        </button>
        <div
          id="docs-accordion-dc-1-body"
          role="region"
          aria-labelledby="docs-accordion-dc-1-header"
        >
          <div
            data-inner
            class="border-t border-dashed border-default bg-surface px-4 py-4 text-sm leading-relaxed text-body"
          >
            <p class="m-0">Trolls regenerate 3 hp per round unless burned or acid-treated.</p>
          </div>
        </div>
      </div>

      <div data-panel data-open="false">
        <button
          type="button"
          data-header
          id="docs-accordion-dc-2-header"
          class="flex w-full items-center justify-between gap-3 bg-surface px-4 py-3 text-left text-sm font-medium text-primary transition-colors hover:bg-surface-hover aria-expanded:bg-accent-default aria-expanded:text-on-accent aria-expanded:hover:bg-accent-hover"
          aria-expanded="false"
          aria-controls="docs-accordion-dc-2-body"
        >
          Galeb Duhr
          <span class="docs-accordion-runtime-chevron" aria-hidden="true"></span>
        </button>
        <div
          id="docs-accordion-dc-2-body"
          role="region"
          aria-labelledby="docs-accordion-dc-2-header"
          hidden
        >
          <div
            data-inner
            class="border-t border-dashed border-default bg-surface px-4 py-4 text-sm leading-relaxed text-body"
          >
            <p class="m-0">Looks like a boulder until it animates. Then the fists start flying.</p>
          </div>
        </div>
      </div>
    </cinq-accordion>

    <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
      Status&nbsp;:&nbsp;<span data-status class="font-mono font-medium text-primary">Bound. Headers respond</span>
    </p>
  </div>
</section>

<script>
  {
    const root = document.querySelector('[data-demo-root="accordion-destroy"]');
    const accordion = document.querySelector('cinq-accordion[data-demo="accordion-destroy"]');
    const status = root?.querySelector('[data-status]');
    const destroyBtn = root?.querySelector('[data-action="destroy"]');
    const createBtn = root?.querySelector('[data-action="create"]');

    const setBound = (bound) => {
      if (status) status.textContent = bound ? 'Bound, headers respond' : 'Destroyed, headers inert';
      accordion?.toggleAttribute('data-unbound', !bound);
      destroyBtn && (destroyBtn.disabled = !bound);
      createBtn && (createBtn.disabled = bound);
    };

    setBound(true);

    destroyBtn?.addEventListener('click', () => {
      accordion?.destroy();
      setBound(false);
    });

    createBtn?.addEventListener('click', () => {
      accordion?.init();
      setBound(true);
    });
  }
</script>
