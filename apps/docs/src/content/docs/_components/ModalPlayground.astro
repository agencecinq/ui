---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-primary">Confirm dialog</h3>
            <p class="text-sm text-muted">
              A confirm/cancel flow: each button closes with <code>request-close</code> and
              its <code>value</code>, read back from <code>returnValue</code>.
            </p>
          </div>
          <button
            type="button"
            class="shrink-0 px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover shrink-0"
            commandfor="confirm-modal"
            command="show-modal"
          >
            Open confirm
          </button>
        </div>

        <p
          class="rounded-lg bg-surface px-3 py-2 text-sm text-body"
          data-modal-status="confirm"
        >
          Waiting for your choice...
        </p>

        <cinq-modal>
          <dialog
            id="confirm-modal"
            closedby="any"
            aria-labelledby="memorize-fireball-title"
            class="fixed left-1/2 top-1/2 w-[min(92vw,32rem)] -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-elevated p-6 shadow-2xl backdrop:bg-overlay-scrim text-primary border border-default"
            data-modal="confirm"
          >
            <h2 id="memorize-fireball-title" class="text-xl font-semibold mb-2">Memorize fireball?</h2>
            <p class="text-body mb-4">
              Memorizing <span class="font-semibold">fireball</span> uses one of your wizard's
              3rd-level spell slots for the day.
            </p>

            <div class="flex justify-end gap-2">
              <button
                type="button"
                class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
                commandfor="confirm-modal"
                command="request-close"
                value="cancel"
              >
                Cancel
              </button>
              <button
                type="button"
                class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
                commandfor="confirm-modal"
                command="request-close"
                value="confirm"
              >
                Confirm
              </button>
            </div>
          </dialog>
        </cinq-modal>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-primary">Inline form</h3>
            <p class="text-sm text-muted">
              A small form inside the modal. The dialog closes on submit and shows the result
              outside.
            </p>
          </div>
          <button
            type="button"
            class="shrink-0 px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover shrink-0"
            commandfor="character-modal"
            command="show-modal"
          >
            Edit character
          </button>
        </div>

        <p
          class="rounded-lg bg-surface px-3 py-2 text-sm text-body"
          data-modal-status="character"
        >
          No character saved yet.
        </p>

        <cinq-modal>
          <dialog
            id="character-modal"
            closedby="any"
            aria-labelledby="character-sheet-title"
            class="fixed left-1/2 top-1/2 w-[min(92vw,32rem)] -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-elevated p-6 shadow-2xl backdrop:bg-overlay-scrim text-primary border border-default"
            data-modal="character"
          >
            <form class="flex flex-col gap-4" data-character-form>
              <div>
                <h2 id="character-sheet-title" class="text-xl font-semibold mb-2">Character sheet</h2>
                <p class="text-body text-sm">
                  Enter a name and class for your adventurer.
                </p>
              </div>

              <label class="block">
                <span class="block text-sm font-medium text-body mb-1">Name</span>
                <input
                  name="name"
                  required
                  class="w-full rounded-lg border border-default px-3 py-2 text-sm"
                  placeholder="Mialee"
                />
              </label>

              <label class="block">
                <span class="block text-sm font-medium text-body mb-1">Class</span>
                <input
                  name="class"
                  required
                  class="w-full rounded-lg border border-default px-3 py-2 text-sm"
                  placeholder="Wizard"
                />
              </label>

              <div class="flex justify-end gap-2">
                <button
                  type="button"
                  class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
                  commandfor="character-modal"
                  command="request-close"
                >
                  Cancel
                </button>

                <button
                  type="submit"
                  class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
                >
                  Save
                </button>
              </div>
            </form>
          </dialog>
        </cinq-modal>
      </div>
    </section>
  </div>
</div>

<script>
  // Confirm modal status: each button closes with its value as returnValue.
  {
    const dialog = document.querySelector('[data-modal="confirm"]') as HTMLDialogElement | null;
    const status = document.querySelector('[data-modal-status="confirm"]');

    dialog?.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') {
        dialog.returnValue = '';
        return;
      }

      if (status) {
        status.textContent =
          dialog.returnValue === 'confirm'
            ? 'You memorise the spell. Fireball is ready when you need it.'
            : 'You leave the spell unmemorised and keep the slot free.';
      }
    });
  }

  // Character form modal
  {
    const dialog = document.querySelector('[data-modal="character"]') as HTMLDialogElement | null;
    const form = dialog?.querySelector('[data-character-form]') as HTMLFormElement | null;
    const status = document.querySelector('[data-modal-status="character"]');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const name = (formData.get('name') || '').toString();
      const klass = (formData.get('class') || '').toString();

      if (name && klass) {
        status && (status.textContent = `${name} the ${klass} is ready for adventure.`);
      }

      dialog?.close();
    });
  }
</script>

