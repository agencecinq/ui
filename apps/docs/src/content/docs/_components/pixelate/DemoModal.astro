---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { modalImage } from './images';
---

<PixelateDemoFrame>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="text-sm text-gray-600">
      Uses <code>cinq-modal</code> and <code>cinq-modal-button</code>.
    </p>
    <cinq-modal-button class="block shrink-0">
      <button
        type="button"
        class="rounded-lg bg-black px-4 py-2 text-sm text-white hover:bg-gray-800"
        aria-controls="docs-pixelate-modal"
        aria-pressed="false"
      >
        Open photo
      </button>
    </cinq-modal-button>
  </div>

  <cinq-modal id="docs-pixelate-modal">
    <dialog
      class="fixed left-1/2 top-1/2 w-[min(92vw,40rem)] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-2xl bg-white p-0 opacity-0 shadow-2xl"
    >
      <cinq-pixelate id="docs-pixelate-modal-host" pixel="256">
        <img
          src={modalImage}
          crossorigin="anonymous"
          alt="Northern lights"
          width="960"
          height="540"
        />
        <canvas role="img" aria-label="Northern lights" />
      </cinq-pixelate>
      <div class="flex justify-end border-t border-gray-100 p-4">
        <cinq-modal-button class="block">
          <button
            type="button"
            class="rounded-lg bg-gray-100 px-4 py-2 text-sm text-gray-800 hover:bg-gray-200"
            aria-controls="docs-pixelate-modal"
            aria-pressed="false"
          >
            Close
          </button>
        </cinq-modal-button>
      </div>
    </dialog>
  </cinq-modal>
</PixelateDemoFrame>
