---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { modalImage } from './images';
---

<PixelateDemoFrame>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="text-sm text-muted">
      Uses <code>cinq-modal</code>: <code>modal:before-close</code> holds the close until the animation ends.
    </p>
    <button
      type="button"
      class="shrink-0 rounded-lg bg-accent-default px-4 py-2 text-sm text-on-accent hover:bg-accent-hover"
      commandfor="docs-pixelate-modal"
      command="show-modal"
    >
      Open photo
    </button>
  </div>

  <cinq-modal>
    <dialog
      id="docs-pixelate-modal"
      closedby="any"
      aria-label="Northern lights"
      class="fixed left-1/2 top-1/2 w-[min(92vw,40rem)] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-2xl bg-elevated p-0 opacity-0 shadow-2xl border border-default"
    >
      <cinq-pixelate id="docs-pixelate-modal-host" pixel="256">
        <img
          src={modalImage}
          crossorigin="anonymous"
          alt="Northern lights"
          width="960"
          height="540"
        />
        <canvas role="img" aria-label="Northern lights" />
      </cinq-pixelate>
      <div class="flex justify-end border-t border-subtle p-4">
        <button
          type="button"
          class="rounded-lg bg-surface px-4 py-2 text-sm text-body hover:bg-surface-hover"
          commandfor="docs-pixelate-modal"
          command="request-close"
        >
          Close
        </button>
      </div>
    </dialog>
  </cinq-modal>
</PixelateDemoFrame>
