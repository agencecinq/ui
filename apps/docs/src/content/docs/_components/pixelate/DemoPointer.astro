---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { pointerImage } from './images';
---

<PixelateDemoFrame>
  <cinq-pixelate
    id="docs-pixelate-pointer"
    class="mx-auto max-w-3xl overflow-hidden rounded-2xl shadow-lg"
    pixel="256"
  >
    <img
      src={pointerImage}
      crossorigin="anonymous"
      alt="City skyline at night"
      width="960"
      height="540"
    />
    <canvas role="img" aria-label="City skyline at night"></canvas>
  </cinq-pixelate>
</PixelateDemoFrame>
