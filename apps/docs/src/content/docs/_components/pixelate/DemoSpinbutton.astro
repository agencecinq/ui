---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { sliderImage } from './images';
---

<PixelateDemoFrame>
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <cinq-spinbutton
        id="docs-pixelate-spinbutton"
        data-step="8"
        class="inline-flex w-fit items-center gap-2 rounded-lg border border-default bg-surface p-1 text-primary focus-within:ring-2 focus-within:ring-focus-ring"
      >
      <button
        type="button"
        name="decrease"
        tabindex="-1"
        aria-label="Decrease block size"
        class="grid h-8 w-8 place-items-center rounded-md bg-elevated shadow-sm hover:bg-surface-hover disabled:cursor-not-allowed disabled:opacity-40 border border-default"
      >
        −
      </button>

      <input
        type="number"
        value="160"
        aria-label="Block size"
        aria-valuemin="0"
        aria-valuemax="256"
        aria-valuenow="160"
        aria-controls="docs-pixelate-spinbutton-demo"
        class="w-16 bg-transparent text-center font-mono text-base focus:outline-none"
      />

      <button
        type="button"
        name="increase"
        tabindex="-1"
        aria-label="Increase block size"
        class="grid h-8 w-8 place-items-center rounded-md bg-elevated shadow-sm hover:bg-surface-hover disabled:cursor-not-allowed disabled:opacity-40 border border-default"
      >
        +
      </button>
    </cinq-spinbutton>

    <div class="flex flex-col gap-2 sm:items-end">
      <p class="text-sm text-muted">
        <code>pixel</code> block size (px):{' '}
        <span id="docs-pixelate-spinbutton-value" class="font-mono font-medium text-primary">
          160
        </span>
        {', '}
        <span id="docs-pixelate-spinbutton-buffer" class="font-mono text-body">
          ...
        </span>
      </p>
      <button
        type="button"
        id="docs-pixelate-spinbutton-download"
        class="rounded-lg bg-accent-default px-3 py-2 text-sm text-on-accent hover:bg-accent-hover"
      >
        Download PNG
      </button>
    </div>
  </div>

  <cinq-pixelate
    id="docs-pixelate-spinbutton-demo"
    class="mx-auto max-w-3xl overflow-hidden rounded-2xl shadow-lg"
    pixel="160"
  >
    <img
      src={sliderImage}
      crossorigin="anonymous"
      alt="Coastal cliffs"
      width="960"
      height="540"
    />
    <canvas role="img" aria-label="Coastal cliffs"></canvas>
  </cinq-pixelate>
</PixelateDemoFrame>
