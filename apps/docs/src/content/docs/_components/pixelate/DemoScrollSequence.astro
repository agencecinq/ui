---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { sequenceImages } from './images';
---

<PixelateDemoFrame>
  <p class="text-sm text-gray-600">
    Three stacked photos, one scroll listener. Each host gets a staggered reveal
    window from its index in the list. Scroll slowly: the first can be sharp
    while the next is still blocky.
  </p>

  <div class="h-[20vh]" aria-hidden="true"></div>

  <div class="mx-auto flex max-w-3xl flex-col gap-8">
    {
      sequenceImages.map((src, index) => (
        <cinq-pixelate
          id={`docs-pixelate-seq-${index}`}
          class="overflow-hidden rounded-2xl shadow-lg"
          data-pixelate-sequence
          pixel="256"
        >
          <img
            src={src}
            crossorigin="anonymous"
            alt={`Sequence photo ${index + 1}`}
            width="960"
            height="540"
          />
          <canvas role="img" aria-label={`Sequence photo ${index + 1}`} />
        </cinq-pixelate>
      ))
    }
  </div>

  <div class="h-[25vh]" aria-hidden="true"></div>
</PixelateDemoFrame>
