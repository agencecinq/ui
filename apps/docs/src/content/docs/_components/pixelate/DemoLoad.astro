---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { loadImage } from './images';
---

<PixelateDemoFrame>
  <p class="text-sm text-gray-600">
    The image uses <code>loading="lazy"</code>: the reveal runs when it enters
    the viewport and finishes loading.
  </p>

  <cinq-pixelate
    id="docs-pixelate-load"
    class="mx-auto max-w-3xl overflow-hidden rounded-2xl shadow-lg"
    pixel="256"
  >
    <img
      src={loadImage}
      loading="lazy"
      crossorigin="anonymous"
      alt="Desert dunes"
      width="960"
      height="540"
    />
    <canvas role="img" aria-label="Desert dunes"></canvas>
  </cinq-pixelate>
</PixelateDemoFrame>
