---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { splitterImage } from './images';
---

<PixelateDemoFrame>
  <cinq-windowsplitter
    class="docs-pixelate-comparison mx-auto max-w-3xl shadow-lg"
    id="docs-pixelate-splitter"
    data-windowsplitter-mode="clip"
    data-windowsplitter-step="5"
    data-windowsplitter-page="20"
    role="region"
    aria-label="Original and pixelated photo comparison"
  >
    <div class="docs-pixelate-comparison__layer docs-pixelate-comparison__after">
      <img
        src={splitterImage}
        crossorigin="anonymous"
        alt=""
        width="960"
        height="540"
        aria-hidden="true"
      />
    </div>
    <div
      id="docs-pixelate-splitter-before"
      class="docs-pixelate-comparison__layer docs-pixelate-comparison__before"
    >
      <cinq-pixelate id="docs-pixelate-splitter-pixelate" pixel="40">
        <img
          src={splitterImage}
          crossorigin="anonymous"
          alt="Coastal cliffs"
          width="960"
          height="540"
        />
        <canvas role="img" aria-label="Pixelated coastal cliffs"></canvas>
      </cinq-pixelate>
    </div>
    <div
      role="separator"
      tabindex="0"
      aria-orientation="vertical"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-controls="docs-pixelate-splitter-before"
      aria-label="Reveal original photo"
    >
      <span class="docs-pixelate-comparison__handle" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M5.5 4.5 2 8l3.5 3.5M10.5 4.5 14 8l-3.5 3.5M2 8h12"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </cinq-windowsplitter>
</PixelateDemoFrame>
