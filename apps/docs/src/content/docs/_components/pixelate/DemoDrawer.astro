---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { drawerImage } from './images';
---

<PixelateDemoFrame>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="text-sm text-muted">
      Uses <code>cinq-drawer</code>.
    </p>
    <button
      type="button"
      class="rounded-lg bg-accent-default px-4 py-2 text-sm text-on-accent hover:bg-accent-hover"
      commandfor="docs-pixelate-drawer"
      command="show-modal"
    >
      Open drawer
    </button>
  </div>

  <cinq-drawer>
    <dialog
      id="docs-pixelate-drawer"
      closedby="any"
      aria-label="Photo drawer"
      class="fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-full max-w-md border-0 p-0 bg-elevated shadow-2xl"
    >
      <div class="flex h-full flex-col">
        <header class="flex items-center justify-between border-b px-4 py-3">
          <h2 class="text-base font-semibold text-primary">Gallery</h2>
          <button
            type="button"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-body hover:bg-surface-hover"
            commandfor="docs-pixelate-drawer"
            command="request-close"
          >
            ✕
          </button>
        </header>
        <div class="flex-1 overflow-y-auto p-4">
          <cinq-pixelate
            id="docs-pixelate-drawer-host"
            class="overflow-hidden rounded-xl shadow"
            pixel="256"
          >
            <img
              src={drawerImage}
              crossorigin="anonymous"
              alt="Misty valley"
              width="960"
              height="540"
            />
            <canvas role="img" aria-label="Misty valley" />
          </cinq-pixelate>
        </div>
      </div>
    </dialog>
  </cinq-drawer>

</PixelateDemoFrame>
