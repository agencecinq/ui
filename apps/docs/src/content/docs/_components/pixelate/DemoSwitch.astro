---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { animateImage } from './images';
---

<PixelateDemoFrame>
  <cinq-switch
    id="docs-pixelate-switch"
    class="docs-switch max-w-md"
    role="switch"
    aria-checked="false"
    tabindex="0"
  >
    <span class="label">Reveal photo</span>
    <span class="slider" aria-hidden="true"><span></span></span>
    <span class="on" aria-hidden="true">On</span>
    <span class="off" aria-hidden="true">Off</span>
    <div hidden>
      <input type="checkbox" tabindex="-1" aria-hidden="true" />
    </div>
  </cinq-switch>

  <cinq-pixelate
    id="docs-pixelate-switch-demo"
    class="mx-auto max-w-3xl overflow-hidden rounded-2xl shadow-lg"
    pixel="256"
  >
    <img
      src={animateImage}
      crossorigin="anonymous"
      alt="Autumn trees"
      width="960"
      height="540"
    />
    <canvas role="img" aria-label="Autumn trees"></canvas>
  </cinq-pixelate>
</PixelateDemoFrame>
