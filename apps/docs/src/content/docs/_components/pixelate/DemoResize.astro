---
import PixelateDemoFrame from './PixelateDemoFrame.astro';
import { resizeImage } from './images';
---

<PixelateDemoFrame>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="text-sm text-gray-600">
      Toggle width, then <code>sync()</code> if the buffer looks stale.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        id="docs-pixelate-resize-wide"
        type="button"
        class="rounded-lg bg-black px-3 py-2 text-sm text-white hover:bg-gray-800"
      >
        Wide
      </button>
      <button
        id="docs-pixelate-resize-narrow"
        type="button"
        class="rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-800 hover:bg-gray-200"
      >
        Narrow
      </button>
    </div>
  </div>

  <div
    id="docs-pixelate-resize-shell"
    class="mx-auto w-full transition-[width] duration-300"
  >
    <cinq-pixelate
      id="docs-pixelate-resize"
      class="overflow-hidden rounded-2xl shadow-lg"
      pixel="32"
    >
      <img
        src={resizeImage}
        crossorigin="anonymous"
        alt="Lake reflection"
        width="960"
        height="540"
      />
      <canvas role="img" aria-label="Lake reflection" />
    </cinq-pixelate>
  </div>
</PixelateDemoFrame>
