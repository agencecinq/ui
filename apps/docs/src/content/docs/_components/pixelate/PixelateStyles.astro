---
<style is:global>
  cinq-pixelate {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
  }

  cinq-pixelate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  cinq-pixelate canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    z-index: 1;
    image-rendering: pixelated;
  }

  [data-pixelate-card]:focus-within {
    outline: 2px solid #6366f1;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    cinq-pixelate img {
      opacity: 1;
    }

    cinq-pixelate canvas {
      display: none;
    }
  }

  #docs-pixelate-modal dialog[open] {
    opacity: 1;
    transition:
      opacity 700ms cubic-bezier(0.4, 0, 0.2, 1),
      overlay 700ms allow-discrete;
  }

  #docs-pixelate-modal dialog[open].is-closing {
    opacity: 0;
  }

  #docs-pixelate-modal dialog[open]::backdrop {
    background-color: rgb(0 0 0 / 50%);
    transition: background-color 700ms allow-discrete;
  }

  #docs-pixelate-modal dialog[open].is-closing::backdrop {
    background-color: rgb(0 0 0 / 0%);
  }

  @starting-style {
    #docs-pixelate-modal dialog[open] {
      opacity: 0;
    }

    #docs-pixelate-modal dialog[open]::backdrop {
      background-color: rgb(0 0 0 / 0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #docs-pixelate-modal dialog[open],
    #docs-pixelate-modal dialog[open]::backdrop {
      transition: none;
    }
  }

  #docs-pixelate-drawer [data-dom="overlay"] {
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  #docs-pixelate-drawer[open] [data-dom="overlay"] {
    opacity: 1;
    pointer-events: auto;
  }

  #docs-pixelate-drawer [role="dialog"] {
    transform: translateX(100%);
    transition: transform 700ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  #docs-pixelate-drawer[open] [role="dialog"] {
    transform: translateX(0);
  }

  #docs-pixelate-drawer.is-opening[open] [data-dom="overlay"],
  #docs-pixelate-drawer.is-closing[open] [data-dom="overlay"] {
    opacity: 0;
    pointer-events: none;
  }

  #docs-pixelate-drawer.is-opening[open] [role="dialog"],
  #docs-pixelate-drawer.is-closing[open] [role="dialog"] {
    transform: translateX(100%);
  }

  @media (prefers-reduced-motion: reduce) {
    #docs-pixelate-drawer [data-dom="overlay"],
    #docs-pixelate-drawer [role="dialog"] {
      transition: none;
    }
  }

  .docs-pixelate-comparison {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    user-select: none;
    touch-action: none;
  }

  .docs-pixelate-comparison__layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .docs-pixelate-comparison__after img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .docs-pixelate-comparison__before cinq-pixelate {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .docs-pixelate-comparison > [role='separator'] {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 3;
    width: 3rem;
    margin-left: -1.5rem;
    border: 0;
    background: transparent;
    cursor: col-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    user-select: none;
  }

  .docs-pixelate-comparison > [role='separator']::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: #fff;
  }

  .docs-pixelate-comparison__handle {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: #fff;
    color: #111827;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 6%),
      0 4px 12px rgb(0 0 0 / 12%);
  }

  .docs-pixelate-comparison__handle svg {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
  }

  .docs-pixelate-comparison > [role='separator']:focus-visible .docs-pixelate-comparison__handle {
    outline: 2px solid #111827;
    outline-offset: 2px;
  }

  .docs-switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    margin: 2px;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    outline: 2px solid transparent;
    outline-offset: -2px;
    user-select: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease-in-out,
      outline-color 0.15s ease-in-out;
  }

  .docs-switch:hover,
  .docs-switch:focus-visible {
    background-color: #f3f4f6;
    outline-color: #111827;
  }

  .docs-switch .label {
    flex: 1;
    font-size: 0.875rem;
    color: #111827;
  }

  .docs-switch .slider {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    min-width: 1.75rem;
    height: 1rem;
    border-radius: 0.5rem;
    border: 1px solid #adb5bd;
    background-color: #fff;
    transition:
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out;
  }

  .docs-switch .slider::before {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #adb5bd;
    transform: translateX(0.1rem);
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .docs-switch[aria-checked='true'] .slider {
    border-color: #111827;
    background-color: #111827;
  }

  .docs-switch[aria-checked='true'] .slider::before {
    background-color: #fff;
    transform: translateX(0.65rem);
  }

  .docs-switch .on,
  .docs-switch .off {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
