---
import RegisterComponents from "./RegisterComponents.astro";
---

<RegisterComponents />

<div class="not-content">
  <section class="rounded-2xl bg-elevated p-6 shadow flex flex-col gap-4 border border-default">
    <div>
      <h3 class="text-lg font-semibold text-primary">Replace: open next, close current</h3>
      <p class="text-sm text-muted">
        From the first modal, <strong>Continue</strong> opens the confirmation with
        <code class="text-xs">show-modal</code> and <code class="text-xs">data-replace</code>.
        The parent closes, then the child opens. Not a stack.
        <strong>Back</strong> replaces it the other way, with the street still filled in.
        Closing confirm returns focus to <strong>Start checkout</strong>.
      </p>
    </div>

    <button
      type="button"
      class="self-start px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
      commandfor="replace-modal-address"
      command="show-modal"
    >
      Start checkout
    </button>

    <p class="text-xs text-muted">
      Flow: Start checkout to Continue (and Back) to Cancel/Place order to focus back on Start checkout.
    </p>

    <cinq-modal>
      <dialog
        id="replace-modal-address"
        closedby="any"
        aria-labelledby="delivery-address-title"
        class="fixed left-1/2 top-1/2 w-[min(92vw,32rem)] -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-elevated p-6 shadow-2xl backdrop:bg-overlay-scrim text-primary border border-default"
      >
        <div class="flex flex-col gap-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 id="delivery-address-title" class="text-xl font-semibold mb-1">Delivery address</h2>
              <p class="text-sm text-muted">
                Step 1 of 2. Continue replaces this dialog with the confirmation.
              </p>
            </div>
            <button
              type="button"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full text-body hover:bg-surface-hover"
              commandfor="replace-modal-address"
              command="request-close"
              aria-label="Close"
            >
              ✕
            </button>
          </div>

          <label class="block">
            <span class="block text-sm font-medium text-body mb-1">Street</span>
            <input
              id="replace-street"
              name="street"
              class="w-full rounded-lg border border-default px-3 py-2 text-sm"
              placeholder="12 Goblin Alley"
            />
          </label>

          <button
            type="button"
            class="self-end px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover text-sm"
            commandfor="replace-modal-confirm"
            command="show-modal"
            data-replace
          >
            Continue
          </button>
        </div>
      </dialog>
    </cinq-modal>

    <cinq-modal>
      <dialog
        id="replace-modal-confirm"
        closedby="any"
        aria-labelledby="confirm-order-title"
        class="fixed left-1/2 top-1/2 w-[min(92vw,28rem)] -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-elevated p-6 shadow-2xl backdrop:bg-overlay-scrim text-primary border border-default"
      >
        <div class="flex flex-col gap-4">
          <div>
            <h2 id="confirm-order-title" class="text-xl font-semibold mb-1">Confirm order</h2>
            <p class="text-sm text-muted">
              Step 2 of 2. The address dialog is closed. Only this one is open.
            </p>
          </div>
          <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
            Deliver to <strong data-replace-street>an unnamed street</strong>.
          </p>
          <div class="flex flex-wrap justify-end gap-2">
            <button
              type="button"
              class="mr-auto px-3 py-2 rounded-lg text-body hover:bg-surface-hover"
              commandfor="replace-modal-address"
              command="show-modal"
              data-replace
            >
              Back
            </button>
            <button
              type="button"
              class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
              commandfor="replace-modal-confirm"
              command="request-close"
            >
              Cancel
            </button>
            <button
              type="button"
              class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
              commandfor="replace-modal-confirm"
              command="request-close"
            >
              Place order
            </button>
          </div>
        </div>
      </dialog>
    </cinq-modal>
  </section>
</div>

<script>
  import { EVENTS } from "@agencecinq/utils";

  // Fill the confirmation before it opens, so it never shows a stale street.
  document.documentElement.addEventListener(EVENTS.MODAL_BEFORE_OPEN, (event) => {
    if (!(event instanceof CustomEvent) || event.detail.modal !== "replace-modal-confirm") {
      return;
    }

    const street = document.querySelector<HTMLInputElement>("#replace-street")?.value.trim();
    const output = document.querySelector("[data-replace-street]");

    if (output) {
      output.textContent = street || "an unnamed street";
    }
  });
</script>
