---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    margin: 2px;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    outline: 2px solid transparent;
    outline-offset: -2px;
    user-select: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease-in-out,
      outline-color 0.15s ease-in-out;
  }

  .docs-switch:hover,
  .docs-switch:focus-visible {
    background-color: var(--background-color-surface-hover);
    outline-color: var(--color-focus-ring);
  }

  .docs-switch:disabled,
  .docs-switch[aria-disabled='true'] {
    opacity: 0.65;
    pointer-events: none;
    cursor: not-allowed;
  }

  .docs-switch:disabled:hover,
  .docs-switch[aria-disabled='true']:hover,
  .docs-switch[aria-disabled='true']:focus-visible {
    background-color: transparent;
    outline-color: transparent;
  }

  .docs-switch .label {
    flex: 1;
    font-size: 0.875rem;
    color: var(--text-color-primary);
  }

  .docs-switch .slider {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    min-width: 1.75rem;
    height: 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color-control);
    background-color: var(--background-color-elevated);
    transition:
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out;
  }

  .docs-switch .slider::before {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--border-color-control);
    transform: translateX(0.1rem);
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .docs-switch[aria-checked='true'] .slider {
    border-color: var(--border-color-accent);
    background-color: var(--color-accent-default);
  }

  .docs-switch[aria-checked='true'] .slider::before {
    background-color: var(--background-color-elevated);
    transform: translateX(0.75rem);
  }

  .docs-switch.large .slider {
    justify-content: space-between;
    padding: 0 6px;
    width: 60px;
    height: 1.5rem;
    border-radius: 0.75rem;
  }

  .docs-switch.large .slider span {
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .docs-switch.large[aria-checked='false'] .slider span:last-child {
    opacity: 1;
    visibility: visible;
  }

  .docs-switch.large[aria-checked='true'] .slider span:first-child {
    opacity: 1;
    visibility: visible;
  }

  .docs-switch.large .slider::before {
    position: absolute;
    top: 50%;
    left: 0;
    margin-top: -7px;
    height: 14px;
    width: 14px;
    transform: translateX(4px);
  }

  .docs-switch.large[aria-checked='true'] .slider::before {
    transform: translateX(2.25rem);
  }

  .docs-switch[aria-checked='true'] .label {
    font-weight: 600;
    color: var(--text-color-primary);
  }

  .docs-switch-minimal {
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-color-control);
    border-radius: 0.5rem;
    background-color: var(--background-color-surface);
    color: var(--text-color-muted);
    transition:
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out,
      color 0.15s ease-in-out;
  }

  .docs-switch-minimal[aria-checked='true'] {
    border-color: var(--border-color-accent);
    background-color: var(--color-accent-default);
    color: var(--text-color-on-accent);
    font-weight: 600;
  }

  .docs-switch-minimal[aria-checked='true']:hover,
  .docs-switch-minimal[aria-checked='true']:focus-visible {
    background-color: var(--color-accent-hover);
    outline-color: var(--color-focus-ring);
  }

  .docs-switch-advanced-panel {
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--border-color-default);
    border-radius: 0.75rem;
    background: var(--background-color-surface);
  }

  .docs-switch-advanced-panel legend {
    padding: 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-color-primary);
  }

  .docs-switch-advanced-panel .docs-switch + .docs-switch {
    margin-top: 0.5rem;
  }

  .docs-switch-advanced-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 32rem;
  }

  .docs-switch-advanced-output {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-color-default);
    background: var(--background-color-elevated);
    color: var(--text-color-body);
    white-space: pre-wrap;
  }
</style>

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Basic switch</h3>
          <p class="text-sm text-muted">
            Click or press <kbd>Space</kbd> / <kbd>Enter</kbd> to toggle. Activate and deactivate
            events are logged below.
          </p>
        </div>

        <cinq-switch
          id="docs-switch-basic"
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Infravision</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>

        <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
          Last event: <span id="docs-switch-status" class="font-mono font-medium text-primary">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">On / Off labels</h3>
          <p class="text-sm text-muted">
            A larger track can reveal <strong>On</strong> and <strong>Off</strong> text inside the
            slider. Style with <code>[aria-checked="true"]</code> on the host.
          </p>
        </div>

        <cinq-switch
          id="docs-switch-labels"
          class="docs-switch large self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Underdark vision</span>
          <span class="slider" aria-hidden="true">
            <span class="on" aria-hidden="true">On</span>
            <span class="off" aria-hidden="true">Off</span>
          </span>
        </cinq-switch>

        <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
          State: <span id="docs-switch-labels-status" class="font-mono font-medium text-primary">off</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Accessible naming</h3>
          <p class="text-sm text-muted">
            Per the <a href="https://www.w3.org/WAI/ARIA/apg/patterns/switch/">APG</a>, the switch
            needs an accessible name via visible text, <code>aria-label</code>,
            <code>aria-labelledby</code>, or a <code>&lt;label&gt;</code> (see <strong>Like a native field</strong>).
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-muted">
              <code>aria-label</code>
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              tabindex="0"
              aria-label="Battle cries"
            >
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
            <p class="text-xs text-muted">No visible label. Name comes from <code>aria-label</code>.</p>
          </div>

          <div class="flex flex-col gap-2">
            <span
              id="docs-switch-aria-labelledby-label"
              class="text-xs font-medium uppercase tracking-wide text-muted"
            >
              <code>aria-labelledby</code>
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              tabindex="0"
              aria-labelledby="docs-switch-aria-labelledby-label"
            >
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
            <p class="text-xs text-muted">
              The visible heading above is referenced by <code>aria-labelledby</code>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Minimal markup</h3>
          <p class="text-sm text-muted">
            No slider. The visible text inside the host provides the accessible name. Style the on
            state with <code>[aria-checked="true"]</code>.
          </p>
        </div>

        <cinq-switch
          class="docs-switch docs-switch-minimal self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          Auto-map corridors
        </cinq-switch>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Pre-checked state</h3>
          <p class="text-sm text-muted">
            Set <code>aria-checked="true"</code> in markup for an initially on switch. It is also
            the state <code>form.reset()</code> brings back.
          </p>
        </div>

        <cinq-switch
          class="docs-switch self-start"
          role="switch"
          aria-checked="true"
          tabindex="0"
        >
          <span class="label">Sage's gazette</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Description</h3>
          <p class="text-sm text-muted">
            Use <code>aria-describedby</code> when additional static help text should be announced
            with the switch.
          </p>
        </div>

        <cinq-switch
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
          aria-describedby="docs-switch-push-desc"
        >
          <span class="label">Torch light</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>

        <p id="docs-switch-push-desc" class="text-sm text-muted">
          Keeps a dim light source active while the party explores underground.
        </p>
      </div>
    </section>



    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Like a native field</h3>
          <p class="text-sm text-muted">
            Plain HTML, no script: with a <code>name</code>, the switch submits its
            <code>value</code> while on (<code>"on"</code> by default), and Reset brings back the
            markup state. A <code>&lt;label for&gt;</code> or a wrapping <code>&lt;label&gt;</code>
            names the switch and toggles it on click, a <code>&lt;fieldset&gt;</code> with a
            <code>&lt;legend&gt;</code> groups it, and <code>&lt;fieldset disabled&gt;</code>
            disables every switch inside. The output lists <code>new FormData(form)</code>.
          </p>
        </div>

        <label class="flex items-center gap-2 text-sm text-body">
          <input type="checkbox" id="docs-switch-native-lock" class="rounded border-control" />
          Disable the fieldset
        </label>

        <form id="docs-switch-native-form" class="flex max-w-md flex-col gap-3">

          <fieldset id="docs-switch-native-fieldset" class="docs-switch-advanced-panel">
            <legend>Party notifications</legend>

            <div class="flex items-center justify-between gap-3">
              <label for="docs-switch-native-loot" class="text-sm text-primary">Loot found</label>
              <cinq-switch
                id="docs-switch-native-loot"
                class="docs-switch"
                name="loot"
                role="switch"
                aria-checked="true"
                tabindex="0"
              >
                <span class="slider" aria-hidden="true"></span>
              </cinq-switch>
            </div>

            <label class="flex items-center justify-between gap-3 text-sm text-primary">
              Level up
              <cinq-switch
                class="docs-switch"
                name="level_up"
                value="yes"
                role="switch"
                aria-checked="false"
                tabindex="0"
              >
                <span class="slider" aria-hidden="true"></span>
              </cinq-switch>
            </label>
          </fieldset>

          <div class="flex flex-wrap gap-2">
            <button
              type="submit"
              class="rounded-lg bg-accent-default px-4 py-2 text-sm text-on-accent hover:bg-accent-hover"
            >
              Submit
            </button>
            <button
              type="reset"
              class="rounded-lg bg-surface px-4 py-2 text-sm text-body hover:bg-surface-hover"
            >
              Reset
            </button>
          </div>
        </form>

        <pre
          id="docs-switch-native-output"
          class="docs-switch-advanced-output"
        >Submit the form to read FormData.</pre>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Disabled</h3>
          <p class="text-sm text-muted">
            <code>disabled</code> works as on a native field: the switch leaves the tab order and
            the form, matches <code>:disabled</code>, and is announced as disabled.
            <code>aria-disabled="true"</code> alone keeps it focusable and submitted.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-muted">
              <code>disabled</code>
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              disabled
              tabindex="0"
            >
              <span class="label">Experimental kits</span>
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
          </div>

          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-muted">
              <code>aria-disabled</code> only
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              aria-disabled="true"
              tabindex="0"
            >
              <span class="label">1st-edition THAC0</span>
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Programmatic API</h3>
          <p class="text-sm text-muted">
            Call <code>activate()</code>, <code>deactivate()</code>, or <code>toggle()</code> from
            external controls.
          </p>
        </div>

        <cinq-switch
          id="docs-switch-programmatic"
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Auto-save session notes</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-switch-programmatic-on"
            class="px-3 py-2 rounded-lg bg-accent-default text-on-accent hover:bg-accent-hover"
          >
            Turn on
          </button>
          <button
            type="button"
            id="docs-switch-programmatic-off"
            class="px-3 py-2 rounded-lg bg-surface text-body hover:bg-surface-hover"
          >
            Turn off
          </button>
          <button
            type="button"
            id="docs-switch-programmatic-toggle"
            class="px-3 py-2 rounded-lg border border-default bg-elevated text-body hover:bg-surface"
          >
            Toggle
          </button>
          <button
            type="button"
            id="docs-switch-programmatic-silent"
            class="px-3 py-2 rounded-lg border border-dashed border-control bg-elevated text-muted hover:bg-surface"
          >
            Sync on (silent)
          </button>
        </div>

        <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
          State: <span id="docs-switch-programmatic-status" class="font-mono font-medium text-primary">off</span>
        </p>
        <p class="text-sm text-muted">
          Events:
          <span id="docs-switch-programmatic-events" class="font-mono font-medium text-primary">none</span>
          (silent sync skips them)
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Cancellable events</h3>
          <p class="text-sm text-muted">
            Activate and deactivate events fire <em>before</em> the state changes. Call <code>event.preventDefault()</code> to abort. Useful for confirmations or gating access.
          </p>
        </div>

        <div class="flex flex-wrap gap-4 text-sm text-body">
          <label class="flex items-center gap-2">
            <input type="checkbox" id="docs-switch-cancel-allow-on" class="rounded border-control" checked />
            Allow activation
          </label>
          <label class="flex items-center gap-2">
            <input type="checkbox" id="docs-switch-cancel-allow-off" class="rounded border-control" checked />
            Allow deactivation
          </label>
        </div>

        <cinq-switch
          id="docs-switch-cancel"
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Scrying pool access</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>

        <p class="rounded-lg bg-surface px-3 py-2 text-sm text-body">
          Last attempt: <span id="docs-switch-cancel-status" class="font-mono font-medium text-primary">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-elevated p-6 shadow border border-default">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-primary">Campaign settings (advanced)</h3>
          <p class="text-sm text-muted">
            Form submit, a master switch that enables/disables a child, preset loading via{' '}
            <code>activate(false)</code>, <code>form.reset()</code>, and a disabled
            <code>&lt;fieldset&gt;</code> that locks the whole panel.
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-switch-advanced-preset"
            class="rounded-lg bg-accent-default px-3 py-2 text-sm text-on-accent hover:bg-accent-hover"
          >
            Load veteran preset
          </button>
          <button
            type="button"
            id="docs-switch-advanced-reset"
            class="rounded-lg bg-surface px-3 py-2 text-sm text-body hover:bg-surface-hover"
          >
            Reset defaults
          </button>
          <button
            type="button"
            id="docs-switch-advanced-lock"
            class="rounded-lg border border-default bg-elevated px-3 py-2 text-sm text-body hover:bg-surface"
          >
            Lock panel
          </button>
        </div>

        <form id="docs-switch-advanced-form" class="docs-switch-advanced-form">
          <fieldset id="docs-switch-advanced-fieldset" class="docs-switch-advanced-panel">
            <legend>Table rules</legend>

            <cinq-switch
              id="docs-switch-advanced-master"
              class="docs-switch"
              name="house_rules"
              value="yes"
              role="switch"
              aria-checked="false"
              tabindex="0"
            >
              <span class="label">Enable house rules</span>
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>

            <cinq-switch
              id="docs-switch-advanced-fumbles"
              class="docs-switch"
              name="critical_fumbles"
              value="yes"
              role="switch"
              aria-checked="false"
              disabled
              tabindex="0"
            >
              <span class="label">Critical fumbles</span>
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>

            <cinq-switch
              id="docs-switch-advanced-milestone"
              class="docs-switch"
              name="milestone_leveling"
              value="yes"
              role="switch"
              aria-checked="false"
              tabindex="0"
            >
              <span class="label">Milestone leveling</span>
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
          </fieldset>

          <button
            type="submit"
            class="self-start rounded-lg bg-accent-default px-4 py-2 text-sm text-on-accent hover:bg-accent-hover"
          >
            Save campaign settings
          </button>
        </form>

        <pre
          id="docs-switch-advanced-output"
          class="docs-switch-advanced-output"
          aria-live="polite"
        >Toggle house rules, load a preset, or submit the form.</pre>
      </div>
    </section>
  </div>
</div>

<script>
  import type { Switch } from '@agencecinq/switch';
  import { EVENTS } from '@agencecinq/utils';

  const syncSwitchStatus = (host: Switch, statusEl: HTMLElement) => {
    statusEl.textContent = host.checked ? 'on' : 'off';
  };

  const basicHost = document.getElementById('docs-switch-basic');
  const status = document.getElementById('docs-switch-status');

  if (basicHost && status) {
    basicHost.addEventListener(EVENTS.SWITCH_ACTIVATE, () => {
      status.textContent = EVENTS.SWITCH_ACTIVATE;
    });

    basicHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, () => {
      status.textContent = EVENTS.SWITCH_DEACTIVATE;
    });
  }

  const labelsHost = document.getElementById('docs-switch-labels') as Switch | null;
  const labelsStatus = document.getElementById('docs-switch-labels-status');

  if (labelsHost && labelsStatus) {
    const update = () => syncSwitchStatus(labelsHost, labelsStatus);

    labelsHost.addEventListener(EVENTS.SWITCH_ACTIVATE, update);
    labelsHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, update);
  }

  const programmaticHost = document.getElementById(
    'docs-switch-programmatic',
  ) as Switch | null;
  const programmaticOn = document.getElementById('docs-switch-programmatic-on');
  const programmaticOff = document.getElementById('docs-switch-programmatic-off');
  const programmaticToggle = document.getElementById('docs-switch-programmatic-toggle');
  const programmaticSilent = document.getElementById('docs-switch-programmatic-silent');
  const programmaticStatus = document.getElementById('docs-switch-programmatic-status');
  const programmaticEvents = document.getElementById('docs-switch-programmatic-events');

  if (programmaticHost && programmaticStatus && programmaticEvents) {
    const update = () => syncSwitchStatus(programmaticHost, programmaticStatus);
    const logEvent = (name: string) => {
      programmaticEvents.textContent = name;
    };

    programmaticHost.addEventListener(EVENTS.SWITCH_ACTIVATE, () => {
      update();
      logEvent(EVENTS.SWITCH_ACTIVATE);
    });
    programmaticHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, () => {
      update();
      logEvent(EVENTS.SWITCH_DEACTIVATE);
    });

    programmaticOn?.addEventListener('click', () => {
      programmaticHost.activate();
    });

    programmaticOff?.addEventListener('click', () => {
      programmaticHost.deactivate();
    });

    programmaticToggle?.addEventListener('click', () => {
      programmaticHost.toggle();
    });

    programmaticSilent?.addEventListener('click', () => {
      programmaticHost.activate(false);
      update();
      logEvent('none (activate with emit: false)');
    });
  }

  const nativeForm = document.getElementById('docs-switch-native-form') as HTMLFormElement | null;
  const nativeLock = document.getElementById('docs-switch-native-lock') as HTMLInputElement | null;
  const nativeFieldset = document.getElementById(
    'docs-switch-native-fieldset',
  ) as HTMLFieldSetElement | null;
  const nativeOutput = document.getElementById('docs-switch-native-output');

  if (nativeForm && nativeLock && nativeFieldset && nativeOutput) {
    nativeLock.addEventListener('change', () => {
      nativeFieldset.disabled = nativeLock.checked;
    });

    nativeForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const entries = [...new FormData(nativeForm)].map(([key, value]) => `  ${key}=${value}`);
      nativeOutput.textContent = ['FormData:', ...(entries.length ? entries : ['  (empty)'])].join('\n');
    });
  }

  const cancelHost = document.getElementById('docs-switch-cancel') as Switch | null;
  const cancelAllowOn = document.getElementById(
    'docs-switch-cancel-allow-on',
  ) as HTMLInputElement | null;
  const cancelAllowOff = document.getElementById(
    'docs-switch-cancel-allow-off',
  ) as HTMLInputElement | null;
  const cancelStatus = document.getElementById('docs-switch-cancel-status');

  if (cancelHost && cancelStatus) {
    cancelHost.addEventListener(EVENTS.SWITCH_ACTIVATE, (event) => {
      if (cancelAllowOn && !cancelAllowOn.checked) {
        event.preventDefault();
        cancelStatus.textContent = 'activation blocked';
        return;
      }

      cancelStatus.textContent = 'activated';
    });

    cancelHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, (event) => {
      if (cancelAllowOff && !cancelAllowOff.checked) {
        event.preventDefault();
        cancelStatus.textContent = 'deactivation blocked';
        return;
      }

      cancelStatus.textContent = 'deactivated';
    });
  }

  const advancedForm = document.getElementById('docs-switch-advanced-form') as HTMLFormElement | null;
  const advancedFieldset = document.getElementById(
    'docs-switch-advanced-fieldset',
  ) as HTMLFieldSetElement | null;
  const advancedOutput = document.getElementById('docs-switch-advanced-output');
  const advancedMaster = document.getElementById('docs-switch-advanced-master') as Switch | null;
  const advancedFumbles = document.getElementById('docs-switch-advanced-fumbles') as Switch | null;
  const advancedMilestone = document.getElementById('docs-switch-advanced-milestone') as Switch | null;
  const advancedPreset = document.getElementById('docs-switch-advanced-preset');
  const advancedReset = document.getElementById('docs-switch-advanced-reset');
  const advancedLock = document.getElementById('docs-switch-advanced-lock');

  if (
    advancedForm &&
    advancedFieldset &&
    advancedOutput &&
    advancedMaster &&
    advancedFumbles &&
    advancedMilestone
  ) {
    let panelLocked = false;

    const formatFormData = () => {
      const data = new FormData(advancedForm);
      const lines = ['FormData:'];
      data.forEach((value, key) => {
        lines.push(`  ${key}=${value}`);
      });
      if (1 === lines.length) {
        lines.push('  (all switches off)');
      }
      return lines.join('\n');
    };

    const writeOutput = (message: string) => {
      advancedOutput.textContent = `${message}\n\n${formatFormData()}`;
    };

    const silentActivate = (host: Switch) => {
      host.removeAttribute('disabled');
      host.activate(false);
    };

    const setChildEnabled = (enabled: boolean) => {
      if (panelLocked) return;

      if (enabled) {
        advancedFumbles.removeAttribute('disabled');
        return;
      }

      advancedFumbles.removeAttribute('disabled');
      advancedFumbles.deactivate(false);
      advancedFumbles.setAttribute('disabled', '');
    };

    advancedMaster.addEventListener(EVENTS.SWITCH_ACTIVATE, () => {
      setChildEnabled(true);
      writeOutput('House rules enabled. Critical fumbles is now available.');
    });

    advancedMaster.addEventListener(EVENTS.SWITCH_DEACTIVATE, () => {
      setChildEnabled(false);
      writeOutput('House rules disabled. Critical fumbles locked off.');
    });

    advancedPreset?.addEventListener('click', () => {
      if (panelLocked) {
        writeOutput('Panel is locked. Unlock to load a preset.');
        return;
      }

      setChildEnabled(true);
      silentActivate(advancedMaster);
      silentActivate(advancedMilestone);
      silentActivate(advancedFumbles);
      writeOutput('Veteran preset loaded silently (activate with emit: false).');
    });

    advancedReset?.addEventListener('click', () => {
      if (panelLocked) {
        writeOutput('Panel is locked. Unlock to reset.');
        return;
      }

      advancedForm.reset();
      setChildEnabled(false);
      writeOutput('Defaults restored with form.reset().');
    });

    advancedLock?.addEventListener('click', () => {
      panelLocked = !panelLocked;

      advancedFieldset.disabled = panelLocked;

      advancedLock.textContent = panelLocked ? 'Unlock panel' : 'Lock panel';
      writeOutput(panelLocked ? 'Panel locked by the disabled fieldset.' : 'Panel unlocked.');
    });

    advancedForm.addEventListener('submit', (event) => {
      event.preventDefault();
      writeOutput('Form submitted.');
    });

    writeOutput('Toggle house rules, load a preset, or submit the form.');
  }
</script>
