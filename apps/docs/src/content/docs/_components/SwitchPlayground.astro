---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<style is:global>
  .docs-switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    margin: 2px;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    outline: 2px solid transparent;
    outline-offset: -2px;
    user-select: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease-in-out,
      outline-color 0.15s ease-in-out;
  }

  .docs-switch:hover,
  .docs-switch:focus-visible {
    background-color: #f3f4f6;
    outline-color: #111827;
  }

  .docs-switch[aria-disabled='true'] {
    opacity: 0.65;
    pointer-events: none;
    cursor: not-allowed;
  }

  .docs-switch[aria-disabled='true']:hover,
  .docs-switch[aria-disabled='true']:focus-visible {
    background-color: transparent;
    outline-color: transparent;
  }

  .docs-switch .label {
    flex: 1;
    font-size: 0.875rem;
    color: #111827;
  }

  .docs-switch .slider {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    min-width: 1.75rem;
    height: 1rem;
    border-radius: 0.5rem;
    border: 1px solid #adb5bd;
    background-color: #fff;
    transition:
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out;
  }

  .docs-switch .slider::before {
    content: '';
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #adb5bd;
    transform: translateX(0.1rem);
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .docs-switch[aria-checked='true'] .slider {
    border-color: #111827;
    background-color: #111827;
  }

  .docs-switch[aria-checked='true'] .slider::before {
    background-color: #fff;
    transform: translateX(0.75rem);
  }

  .docs-switch.large .slider {
    justify-content: space-between;
    padding: 0 6px;
    width: 60px;
    height: 1.5rem;
    border-radius: 0.75rem;
  }

  .docs-switch.large .slider span {
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  .docs-switch.large[aria-checked='false'] .slider span:last-child {
    opacity: 1;
    visibility: visible;
  }

  .docs-switch.large[aria-checked='true'] .slider span:first-child {
    opacity: 1;
    visibility: visible;
  }

  .docs-switch.large .slider::before {
    position: absolute;
    top: 50%;
    left: 0;
    margin-top: -7px;
    height: 14px;
    width: 14px;
    transform: translateX(4px);
  }

  .docs-switch.large[aria-checked='true'] .slider::before {
    transform: translateX(2.25rem);
  }

  .docs-switch[checked] .label {
    font-weight: 600;
    color: #111827;
  }

  .docs-switch-fieldset {
    margin: 0;
    padding: 1rem;
    border: 1px dashed #d1d5db;
    border-radius: 0.75rem;
  }

  .docs-switch-fieldset legend {
    padding: 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }

  .docs-switch-fieldset .docs-switch + .docs-switch {
    margin-top: 0.5rem;
  }

  .docs-switch-minimal {
    font-size: 0.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background-color: #f9fafb;
    color: #6b7280;
    transition:
      background-color 0.15s ease-in-out,
      border-color 0.15s ease-in-out,
      color 0.15s ease-in-out;
  }

  .docs-switch-minimal[aria-checked='true'],
  .docs-switch-minimal[checked] {
    border-color: #111827;
    background-color: #111827;
    color: #fff;
    font-weight: 600;
  }

  .docs-switch-minimal[aria-checked='true']:hover,
  .docs-switch-minimal[aria-checked='true']:focus-visible,
  .docs-switch-minimal[checked]:hover,
  .docs-switch-minimal[checked]:focus-visible {
    background-color: #1f2937;
    outline-color: #111827;
  }

  .docs-switch-advanced-panel {
    margin: 0;
    padding: 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #fafafa;
  }

  .docs-switch-advanced-panel legend {
    padding: 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
  }

  .docs-switch-advanced-panel .docs-switch + .docs-switch {
    margin-top: 0.5rem;
  }

  .docs-switch-advanced-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 32rem;
  }

  .docs-switch-advanced-output {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    padding: 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid #e5e7eb;
    background: #fff;
    color: #374151;
    white-space: pre-wrap;
  }
</style>

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Basic switch</h3>
          <p class="text-sm text-gray-600">
            Click or press <kbd>Space</kbd> / <kbd>Enter</kbd> to toggle. Activate and deactivate
            events are logged below.
          </p>
        </div>

        <cinq-switch
          id="docs-switch-basic"
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Infravision</span>
          <span class="slider" aria-hidden="true"></span>
          <div hidden>
            <input type="checkbox" name="infravision" tabindex="-1" aria-hidden="true" />
          </div>
        </cinq-switch>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Last event: <span id="docs-switch-status" class="font-mono font-medium text-gray-900">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">On / Off labels</h3>
          <p class="text-sm text-gray-600">
            A larger track can reveal <strong>On</strong> and <strong>Off</strong> text inside the
            slider. Style with <code>[aria-checked="true"]</code> or the reflected <code>checked</code> attribute on the host.
          </p>
        </div>

        <cinq-switch
          id="docs-switch-labels"
          class="docs-switch large self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Underdark vision</span>
          <span class="slider" aria-hidden="true">
            <span class="on" aria-hidden="true">On</span>
            <span class="off" aria-hidden="true">Off</span>
          </span>
          <div hidden>
            <input type="checkbox" name="dark-mode" tabindex="-1" aria-hidden="true" />
          </div>
        </cinq-switch>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          State: <span id="docs-switch-labels-status" class="font-mono font-medium text-gray-900">off</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Accessible naming</h3>
          <p class="text-sm text-gray-600">
            Per the <a href="https://www.w3.org/WAI/ARIA/apg/patterns/switch/">APG</a>, the switch
            needs an accessible name via visible text, <code>aria-label</code>, or <code>aria-labelledby</code>.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-gray-500">
              <code>aria-label</code>
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              tabindex="0"
              aria-label="Battle cries"
            >
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
            <p class="text-xs text-gray-500">No visible label. Name comes from <code>aria-label</code>.</p>
          </div>

          <div class="flex flex-col gap-2">
            <span
              id="docs-switch-aria-labelledby-label"
              class="text-xs font-medium uppercase tracking-wide text-gray-500"
            >
              <code>aria-labelledby</code>
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              tabindex="0"
              aria-labelledby="docs-switch-aria-labelledby-label"
            >
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
            <p class="text-xs text-gray-500">
              The visible heading above is referenced by <code>aria-labelledby</code>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Minimal markup</h3>
          <p class="text-sm text-gray-600">
            No slider, no hidden checkbox. Enough when you do not submit a form. The visible text
            inside the host provides the accessible name. Style the on state with <code>[aria-checked="true"]</code> or <code>[checked]</code>.
          </p>
        </div>

        <cinq-switch
          class="docs-switch docs-switch-minimal self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          Auto-map corridors
        </cinq-switch>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Pre-checked state</h3>
          <p class="text-sm text-gray-600">
            Set <code>aria-checked="true"</code> in markup for an initially on switch. Add <code>checked</code>             on the host too if you style with <code>cinq-switch[checked]</code>.
            The component reflects <code>checked</code> after the first toggle.
          </p>
        </div>

        <cinq-switch
          class="docs-switch self-start"
          role="switch"
          aria-checked="true"
          checked
          tabindex="0"
        >
          <span class="label">Sage's gazette</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Description</h3>
          <p class="text-sm text-gray-600">
            Use <code>aria-describedby</code> when additional static help text should be announced
            with the switch.
          </p>
        </div>

        <cinq-switch
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
          aria-describedby="docs-switch-push-desc"
        >
          <span class="label">Torch light</span>
          <span class="slider" aria-hidden="true"></span>
        </cinq-switch>

        <p id="docs-switch-push-desc" class="text-sm text-gray-600">
          Keeps a dim light source active while the party explores underground.
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Switch group</h3>
          <p class="text-sm text-gray-600">
            Wrap related switches in a <code>&lt;fieldset&gt;</code> with a <code>&lt;legend&gt;</code>, or use <code>role="group"</code> with <code>aria-labelledby</code>.
          </p>
        </div>

        <fieldset class="docs-switch-fieldset self-start">
          <legend>Campaign preferences</legend>

          <cinq-switch
            class="docs-switch"
            role="switch"
            aria-checked="false"
            tabindex="0"
          >
            <span class="label">Identify magic items</span>
            <span class="slider" aria-hidden="true"></span>
          </cinq-switch>

          <cinq-switch
            class="docs-switch"
            role="switch"
            aria-checked="true"
            checked
            tabindex="0"
          >
            <span class="label">Show THAC0</span>
            <span class="slider" aria-hidden="true"></span>
          </cinq-switch>
        </fieldset>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Form helper input</h3>
          <p class="text-sm text-gray-600">
            Optional hidden <code>&lt;input&gt;</code> for form submission (one per host). Keep
            it hidden from assistive tech. The host is the switch.
          </p>
        </div>

        <cinq-switch
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Henchman reports</span>
          <span class="slider" aria-hidden="true"></span>
          <div hidden>
            <input
              type="checkbox"
              name="newsletter"
              tabindex="-1"
              aria-hidden="true"
            />
          </div>
        </cinq-switch>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Form submission</h3>
          <p class="text-sm text-gray-600">
            Submit the form to read checkbox values synced by the component. The host stays the
            accessible switch. The hidden input is for the form only.
          </p>
        </div>

        <form id="docs-switch-form" class="flex flex-col gap-3 max-w-md">
          <cinq-switch
            class="docs-switch self-start"
            role="switch"
            aria-checked="false"
            tabindex="0"
          >
            <span class="label">Daily henchman reports</span>
            <span class="slider" aria-hidden="true"></span>
            <div hidden>
              <input
                type="checkbox"
                name="henchman_reports"
                value="yes"
                tabindex="-1"
                aria-hidden="true"
              />
            </div>
          </cinq-switch>

          <button
            type="submit"
            class="self-start rounded-lg bg-black px-4 py-2 text-sm text-white hover:bg-gray-800"
          >
            Submit preferences
          </button>
        </form>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Submitted:
          <span id="docs-switch-form-status" class="font-mono font-medium text-gray-900">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Disabled</h3>
          <p class="text-sm text-gray-600">
            Pair <code>disabled</code> with <code>aria-disabled="true"</code> and <code>tabindex="-1"</code>. The getter also respects <code>aria-disabled</code> alone.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-gray-500">
              <code>disabled</code> + <code>aria-disabled</code>
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              disabled
              aria-disabled="true"
              tabindex="-1"
            >
              <span class="label">Experimental kits</span>
              <span class="slider" aria-hidden="true"></span>
              <div hidden>
                <input type="checkbox" tabindex="-1" aria-hidden="true" disabled />
              </div>
            </cinq-switch>
          </div>

          <div class="flex flex-col gap-2">
            <span class="text-xs font-medium uppercase tracking-wide text-gray-500">
              <code>aria-disabled</code> only
            </span>
            <cinq-switch
              class="docs-switch self-start"
              role="switch"
              aria-checked="false"
              aria-disabled="true"
              tabindex="-1"
            >
              <span class="label">1st-edition THAC0</span>
              <span class="slider" aria-hidden="true"></span>
            </cinq-switch>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Programmatic API</h3>
          <p class="text-sm text-gray-600">
            Call <code>activate()</code>, <code>deactivate()</code>, or <code>toggle()</code> from
            external controls.
          </p>
        </div>

        <cinq-switch
          id="docs-switch-programmatic"
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Auto-save session notes</span>
          <span class="slider" aria-hidden="true"></span>
          <div hidden>
            <input type="checkbox" name="autosave" tabindex="-1" aria-hidden="true" />
          </div>
        </cinq-switch>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-switch-programmatic-on"
            class="px-3 py-2 rounded-lg bg-black text-white hover:bg-gray-800"
          >
            Turn on
          </button>
          <button
            type="button"
            id="docs-switch-programmatic-off"
            class="px-3 py-2 rounded-lg bg-gray-100 text-gray-800 hover:bg-gray-200"
          >
            Turn off
          </button>
          <button
            type="button"
            id="docs-switch-programmatic-toggle"
            class="px-3 py-2 rounded-lg border border-gray-200 bg-white text-gray-800 hover:bg-gray-50"
          >
            Toggle
          </button>
          <button
            type="button"
            id="docs-switch-programmatic-silent"
            class="px-3 py-2 rounded-lg border border-dashed border-gray-300 bg-white text-gray-600 hover:bg-gray-50"
          >
            Sync on (silent)
          </button>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          State: <span id="docs-switch-programmatic-status" class="font-mono font-medium text-gray-900">off</span>
        </p>
        <p class="text-sm text-gray-600">
          Events:
          <span id="docs-switch-programmatic-events" class="font-mono font-medium text-gray-900">none</span>
          (silent sync skips them)
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Cancellable events</h3>
          <p class="text-sm text-gray-600">
            Activate and deactivate events fire <em>before</em> the state changes. Call <code>event.preventDefault()</code> to abort. Useful for confirmations or gating access.
          </p>
        </div>

        <div class="flex flex-wrap gap-4 text-sm text-gray-700">
          <label class="flex items-center gap-2">
            <input type="checkbox" id="docs-switch-cancel-allow-on" class="rounded border-gray-300" checked />
            Allow activation
          </label>
          <label class="flex items-center gap-2">
            <input type="checkbox" id="docs-switch-cancel-allow-off" class="rounded border-gray-300" checked />
            Allow deactivation
          </label>
        </div>

        <cinq-switch
          id="docs-switch-cancel"
          class="docs-switch self-start"
          role="switch"
          aria-checked="false"
          tabindex="0"
        >
          <span class="label">Scrying pool access</span>
          <span class="slider" aria-hidden="true"></span>
          <div hidden>
            <input type="checkbox" name="analytics" tabindex="-1" aria-hidden="true" />
          </div>
        </cinq-switch>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Last attempt: <span id="docs-switch-cancel-status" class="font-mono font-medium text-gray-900">-</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Campaign settings (advanced)</h3>
          <p class="text-sm text-gray-600">
            Form submit, a master switch that enables/disables a child, preset loading via
            <code>activate(false)</code>, and external <code>disabled</code> on the whole panel.
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="docs-switch-advanced-preset"
            class="rounded-lg bg-black px-3 py-2 text-sm text-white hover:bg-gray-800"
          >
            Load veteran preset
          </button>
          <button
            type="button"
            id="docs-switch-advanced-reset"
            class="rounded-lg bg-gray-100 px-3 py-2 text-sm text-gray-800 hover:bg-gray-200"
          >
            Reset defaults
          </button>
          <button
            type="button"
            id="docs-switch-advanced-lock"
            class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-800 hover:bg-gray-50"
          >
            Lock panel
          </button>
        </div>

        <form id="docs-switch-advanced-form" class="docs-switch-advanced-form">
          <fieldset id="docs-switch-advanced-fieldset" class="docs-switch-advanced-panel">
            <legend>Table rules</legend>

            <cinq-switch
              id="docs-switch-advanced-master"
              class="docs-switch"
              role="switch"
              aria-checked="false"
              tabindex="0"
            >
              <span class="label">Enable house rules</span>
              <span class="slider" aria-hidden="true"></span>
              <div hidden>
                <input
                  type="checkbox"
                  name="house_rules"
                  value="yes"
                  tabindex="-1"
                  aria-hidden="true"
                />
              </div>
            </cinq-switch>

            <cinq-switch
              id="docs-switch-advanced-fumbles"
              class="docs-switch"
              role="switch"
              aria-checked="false"
              disabled
              aria-disabled="true"
              tabindex="-1"
            >
              <span class="label">Critical fumbles</span>
              <span class="slider" aria-hidden="true"></span>
              <div hidden>
                <input
                  type="checkbox"
                  name="critical_fumbles"
                  value="yes"
                  tabindex="-1"
                  aria-hidden="true"
                  disabled
                />
              </div>
            </cinq-switch>

            <cinq-switch
              id="docs-switch-advanced-milestone"
              class="docs-switch"
              role="switch"
              aria-checked="false"
              tabindex="0"
            >
              <span class="label">Milestone leveling</span>
              <span class="slider" aria-hidden="true"></span>
              <div hidden>
                <input
                  type="checkbox"
                  name="milestone_leveling"
                  value="yes"
                  tabindex="-1"
                  aria-hidden="true"
                />
              </div>
            </cinq-switch>
          </fieldset>

          <button
            type="submit"
            class="self-start rounded-lg bg-black px-4 py-2 text-sm text-white hover:bg-gray-800"
          >
            Save campaign settings
          </button>
        </form>

        <pre
          id="docs-switch-advanced-output"
          class="docs-switch-advanced-output"
          aria-live="polite"
        >Toggle house rules, load a preset, or submit the form.</pre>
      </div>
    </section>
  </div>
</div>

<script>
  import type { Switch } from '@agencecinq/switch';
  import { EVENTS } from '@agencecinq/utils';

  const syncSwitchStatus = (host: Switch, statusEl: HTMLElement) => {
    statusEl.textContent = host.checked ? 'on' : 'off';
  };

  const basicHost = document.getElementById('docs-switch-basic');
  const status = document.getElementById('docs-switch-status');

  if (basicHost && status) {
    basicHost.addEventListener(EVENTS.SWITCH_ACTIVATE, () => {
      status.textContent = EVENTS.SWITCH_ACTIVATE;
    });

    basicHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, () => {
      status.textContent = EVENTS.SWITCH_DEACTIVATE;
    });
  }

  const labelsHost = document.getElementById('docs-switch-labels') as Switch | null;
  const labelsStatus = document.getElementById('docs-switch-labels-status');

  if (labelsHost && labelsStatus) {
    const update = () => syncSwitchStatus(labelsHost, labelsStatus);

    labelsHost.addEventListener(EVENTS.SWITCH_ACTIVATE, update);
    labelsHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, update);
  }

  const programmaticHost = document.getElementById(
    'docs-switch-programmatic',
  ) as Switch | null;
  const programmaticOn = document.getElementById('docs-switch-programmatic-on');
  const programmaticOff = document.getElementById('docs-switch-programmatic-off');
  const programmaticToggle = document.getElementById('docs-switch-programmatic-toggle');
  const programmaticSilent = document.getElementById('docs-switch-programmatic-silent');
  const programmaticStatus = document.getElementById('docs-switch-programmatic-status');
  const programmaticEvents = document.getElementById('docs-switch-programmatic-events');

  if (programmaticHost && programmaticStatus && programmaticEvents) {
    const update = () => syncSwitchStatus(programmaticHost, programmaticStatus);
    const logEvent = (name: string) => {
      programmaticEvents.textContent = name;
    };

    programmaticHost.addEventListener(EVENTS.SWITCH_ACTIVATE, () => {
      update();
      logEvent(EVENTS.SWITCH_ACTIVATE);
    });
    programmaticHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, () => {
      update();
      logEvent(EVENTS.SWITCH_DEACTIVATE);
    });

    programmaticOn?.addEventListener('click', () => {
      programmaticHost.activate();
    });

    programmaticOff?.addEventListener('click', () => {
      programmaticHost.deactivate();
    });

    programmaticToggle?.addEventListener('click', () => {
      programmaticHost.toggle();
    });

    programmaticSilent?.addEventListener('click', () => {
      programmaticHost.activate(false);
      update();
      logEvent('none (activate with emit: false)');
    });
  }

  const switchForm = document.getElementById('docs-switch-form') as HTMLFormElement | null;
  const switchFormStatus = document.getElementById('docs-switch-form-status');

  if (switchForm && switchFormStatus) {
    switchForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(switchForm);
      const henchman = data.get('henchman_reports');
      switchFormStatus.textContent = henchman ? 'henchman_reports=yes' : 'henchman_reports=(off)';
    });
  }

  const cancelHost = document.getElementById('docs-switch-cancel') as Switch | null;
  const cancelAllowOn = document.getElementById(
    'docs-switch-cancel-allow-on',
  ) as HTMLInputElement | null;
  const cancelAllowOff = document.getElementById(
    'docs-switch-cancel-allow-off',
  ) as HTMLInputElement | null;
  const cancelStatus = document.getElementById('docs-switch-cancel-status');

  if (cancelHost && cancelStatus) {
    cancelHost.addEventListener(EVENTS.SWITCH_ACTIVATE, (event) => {
      if (cancelAllowOn && !cancelAllowOn.checked) {
        event.preventDefault();
        cancelStatus.textContent = 'activation blocked';
        return;
      }

      cancelStatus.textContent = 'activated';
    });

    cancelHost.addEventListener(EVENTS.SWITCH_DEACTIVATE, (event) => {
      if (cancelAllowOff && !cancelAllowOff.checked) {
        event.preventDefault();
        cancelStatus.textContent = 'deactivation blocked';
        return;
      }

      cancelStatus.textContent = 'deactivated';
    });
  }

  const advancedForm = document.getElementById('docs-switch-advanced-form') as HTMLFormElement | null;
  const advancedOutput = document.getElementById('docs-switch-advanced-output');
  const advancedMaster = document.getElementById('docs-switch-advanced-master') as Switch | null;
  const advancedFumbles = document.getElementById('docs-switch-advanced-fumbles') as Switch | null;
  const advancedMilestone = document.getElementById('docs-switch-advanced-milestone') as Switch | null;
  const advancedPreset = document.getElementById('docs-switch-advanced-preset');
  const advancedReset = document.getElementById('docs-switch-advanced-reset');
  const advancedLock = document.getElementById('docs-switch-advanced-lock');

  if (
    advancedForm &&
    advancedOutput &&
    advancedMaster &&
    advancedFumbles &&
    advancedMilestone
  ) {
    let panelLocked = false;

    const formatFormData = () => {
      const data = new FormData(advancedForm);
      const lines = ['FormData:'];
      data.forEach((value, key) => {
        lines.push(`  ${key}=${value}`);
      });
      if (1 === lines.length) {
        lines.push('  (all switches off)');
      }
      return lines.join('\n');
    };

    const writeOutput = (message: string) => {
      advancedOutput.textContent = `${message}\n\n${formatFormData()}`;
    };

    const silentActivate = (host: Switch) => {
      if (host.disabled) {
        host.removeAttribute('disabled');
        host.removeAttribute('aria-disabled');
        host.setAttribute('tabindex', '0');
      }

      if (!host.checked) {
        host.activate(false);
      }
    };

    const silentDeactivate = (host: Switch) => {
      if (host.disabled) {
        host.removeAttribute('disabled');
        host.removeAttribute('aria-disabled');
        host.setAttribute('tabindex', '0');
      }

      if (host.checked) {
        host.deactivate(false);
      }
    };

    const setChildEnabled = (enabled: boolean) => {
      if (panelLocked) return;

      if (enabled) {
        advancedFumbles.removeAttribute('disabled');
        advancedFumbles.removeAttribute('aria-disabled');
        advancedFumbles.setAttribute('tabindex', '0');
        return;
      }

      silentDeactivate(advancedFumbles);

      advancedFumbles.setAttribute('disabled', '');
      advancedFumbles.setAttribute('aria-disabled', 'true');
      advancedFumbles.setAttribute('tabindex', '-1');
    };

    advancedMaster.addEventListener(EVENTS.SWITCH_ACTIVATE, () => {
      setChildEnabled(true);
      writeOutput('House rules enabled. Critical fumbles is now available.');
    });

    advancedMaster.addEventListener(EVENTS.SWITCH_DEACTIVATE, () => {
      setChildEnabled(false);
      writeOutput('House rules disabled. Critical fumbles locked off.');
    });

    advancedPreset?.addEventListener('click', () => {
      if (panelLocked) {
        writeOutput('Panel is locked. Unlock to load a preset.');
        return;
      }

      setChildEnabled(true);
      silentActivate(advancedMaster);
      silentActivate(advancedMilestone);
      silentActivate(advancedFumbles);
      writeOutput('Veteran preset loaded silently (activate with emit: false).');
    });

    advancedReset?.addEventListener('click', () => {
      if (panelLocked) {
        writeOutput('Panel is locked. Unlock to reset.');
        return;
      }

      silentDeactivate(advancedMaster);
      silentDeactivate(advancedMilestone);
      setChildEnabled(false);
      writeOutput('Defaults restored silently.');
    });

    advancedLock?.addEventListener('click', () => {
      panelLocked = !panelLocked;

      for (const host of [advancedMaster, advancedFumbles, advancedMilestone]) {
        if (panelLocked) {
          host.setAttribute('disabled', '');
          host.setAttribute('aria-disabled', 'true');
          host.setAttribute('tabindex', '-1');
        } else {
          host.removeAttribute('disabled');
          host.removeAttribute('aria-disabled');
          host.setAttribute('tabindex', '0');
        }
      }

      if (!panelLocked && !advancedMaster.checked) {
        setChildEnabled(false);
      } else if (!panelLocked && advancedMaster.checked) {
        setChildEnabled(true);
      }

      advancedLock.textContent = panelLocked ? 'Unlock panel' : 'Lock panel';
      writeOutput(panelLocked ? 'Panel locked via disabled attribute.' : 'Panel unlocked.');
    });

    advancedForm.addEventListener('submit', (event) => {
      event.preventDefault();
      writeOutput('Form submitted.');
    });

    writeOutput('Toggle house rules, load a preset, or submit the form.');
  }
</script>
