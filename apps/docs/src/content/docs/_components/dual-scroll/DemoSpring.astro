---
import { leftImages, rightImages } from "./images.ts";

interface Props {
  spring: string;
  label: string;
}

const { spring, label } = Astro.props;
---
<div class="not-content my-6 flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow">
  <p class="text-sm text-gray-600 m-0">{label}</p>
  <cinq-dual-scroll spring={spring}>
    <div class="dual-scroll__columns">
      <div data-scroll-column="left">
        {
          leftImages.slice(0, 2).map((src) => (
            <div class="dual-scroll__pane">
              <img src={src} width="640" height="480" alt="" />
            </div>
          ))
        }
      </div>
      <div data-scroll-column="right">
        {
          rightImages.slice(0, 2).map((src) => (
            <div class="dual-scroll__pane">
              <img src={src} width="640" height="480" alt="" />
            </div>
          ))
        }
      </div>
    </div>
  </cinq-dual-scroll>
</div>
