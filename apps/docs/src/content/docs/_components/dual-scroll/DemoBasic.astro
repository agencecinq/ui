---
import { leftImages, rightImages } from "./images.ts";
---
<div class="not-content my-6 flex flex-col gap-4 rounded-2xl border border-default bg-elevated p-6 shadow">
  <p class="text-sm text-muted m-0">
    Scroll or swipe inside the zone. Right column goes down, left goes up.
  </p>
  <cinq-dual-scroll spring="0.1">
    <div class="dual-scroll__columns">
      <div data-scroll-column="left">
        {
          leftImages.map((src) => (
            <div class="dual-scroll__pane">
              <img src={src} width="640" height="480" alt="" />
            </div>
          ))
        }
      </div>
      <div data-scroll-column="right">
        {
          rightImages.map((src) => (
            <div class="dual-scroll__pane">
              <img src={src} width="640" height="480" alt="" />
            </div>
          ))
        }
      </div>
    </div>
  </cinq-dual-scroll>
</div>
