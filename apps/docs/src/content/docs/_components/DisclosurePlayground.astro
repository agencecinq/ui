---
import RegisterComponents from './RegisterComponents.astro';
---

<RegisterComponents />

<div class="not-content">
  <div class="flex flex-col gap-10">
    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Basic disclosure</h3>
          <p class="text-sm text-gray-600">
            A single trigger toggles one region. The button label stays fixed — open/close events are
            logged below.
          </p>
        </div>

        <cinq-disclosure-button id="docs-disclosure-basic">
          <button
            type="button"
            id="docs-disclosure-trigger"
            class="self-start px-3 py-2 rounded-lg bg-black text-white hover:bg-gray-800"
            aria-expanded="false"
            aria-controls="docs-disclosure-region"
          >
            Show spell details
          </button>
        </cinq-disclosure-button>

        <div
          id="docs-disclosure-region"
          class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
          hidden
        >
          <p class="m-0">
            Fireball deals <strong>1d6 per caster level</strong> (maximum 10d6) in a
            20-foot-radius sphere. Creatures in the area may save vs. spell for half
            damage if they have Dexterity 15+ and room to dive for cover.
          </p>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Last event: <span id="docs-disclosure-status" class="font-mono font-medium text-gray-900">—</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Updating the button label</h3>
          <p class="text-sm text-gray-600">
            Listen to <code>DISCLOSURE_BUTTON_OPEN</code> / <code>DISCLOSURE_BUTTON_CLOSE</code> and
            update the trigger text yourself — useful for Show/Hide copy or i18n.
          </p>
        </div>

        <cinq-disclosure-button>
          <button
            type="button"
            id="docs-disclosure-label-trigger"
            class="self-start px-3 py-2 rounded-lg bg-black text-white hover:bg-gray-800"
            aria-expanded="false"
            aria-controls="docs-disclosure-label-region"
          >
            Show stat block
          </button>
        </cinq-disclosure-button>

        <div
          id="docs-disclosure-label-region"
          class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
          hidden
        >
          <p class="m-0">
            HD 6+6, THAC0 13, #AT 3, Dmg 1d4/1d4/1d8+6. Special: regeneration 3 hp/round
            unless burned or acid-treated. Treasure type: Q (×3), S.
          </p>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Current label: <span id="docs-disclosure-label-status" class="font-mono font-medium text-gray-900">Show stat block</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Read more / Read less</h3>
          <p class="text-sm text-gray-600">
            A short excerpt stays visible; the rest lives in a hidden region. Style the trigger as an
            inline text control and swap the label on open/close.
          </p>
        </div>

        <article class="max-w-prose text-sm leading-relaxed text-gray-700">
          <p class="m-0">
            The ruined keep broods over the moors — a crumbling fortress built for siege
            and betrayal.
          </p>

          <div id="docs-disclosure-readmore-region" hidden>
            <p class="mb-0 mt-3">
              The great hall opens onto a collapsed battlement. Below, three cellars share
              a flooded oubliette once used to hold political prisoners.
            </p>
          </div>

          <cinq-disclosure-button>
            <button
              type="button"
              id="docs-disclosure-readmore-trigger"
              class="mt-2 p-0 text-sm font-medium text-gray-900 underline decoration-gray-400 underline-offset-2 hover:decoration-gray-900"
              aria-expanded="false"
              aria-controls="docs-disclosure-readmore-region"
            >
              Read full entry
            </button>
          </cinq-disclosure-button>
        </article>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-3">
          <h3 class="m-0 text-lg font-semibold text-gray-900">One button, multiple targets</h3>
          <p class="m-0 text-sm text-gray-600">
            <code>aria-controls</code> is an ID reference list — one trigger can open every listed
            region. Each region can be dismissed on its own, then <code>update()</code> keeps <code>aria-expanded</code> honest.
          </p>
          <p
            class="m-0 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm text-sky-950"
            role="note"
          >
            <strong>Note:</strong> multi-target is valid ARIA (see MDN’s <code>ariaControlsElements</code> example). Here <code>aria-expanded</code> is <code>true</code> while at least one region is visible; a click closes if any remains open.
          </p>
        </div>

        <cinq-disclosure-button id="docs-disclosure-components-host">
          <button
            type="button"
            id="docs-disclosure-components-trigger"
            class="self-start px-3 py-2 rounded-lg bg-black text-white hover:bg-gray-800"
            aria-expanded="false"
            aria-controls="docs-disclosure-verbal-component docs-disclosure-somatic-component docs-disclosure-material-component"
          >
            Show material components
          </button>
        </cinq-disclosure-button>

        <div class="grid gap-3 sm:grid-cols-3">
          <div
            id="docs-disclosure-verbal-component"
            class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
            hidden
          >
            <div class="flex items-start justify-between gap-2">
              <h4 class="m-0 text-sm font-semibold text-gray-900">Verbal</h4>
              <button
                type="button"
                class="shrink-0 text-xs font-medium text-gray-500 hover:text-gray-900"
                data-disclosure-dismiss
                aria-label="Dismiss verbal component"
              >
                Dismiss
              </button>
            </div>
            <p class="mb-0 mt-2">A forceful invocation ending in <em>ignis!</em></p>
          </div>

          <div
            id="docs-disclosure-somatic-component"
            class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
            hidden
          >
            <div class="flex items-start justify-between gap-2">
              <h4 class="m-0 text-sm font-semibold text-gray-900">Somatic</h4>
              <button
                type="button"
                class="shrink-0 text-xs font-medium text-gray-500 hover:text-gray-900"
                data-disclosure-dismiss
                aria-label="Dismiss somatic component"
              >
                Dismiss
              </button>
            </div>
            <p class="mb-0 mt-2">Pinch sulfur, then thrust both hands toward the target.</p>
          </div>

          <div
            id="docs-disclosure-material-component"
            class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
            hidden
          >
            <div class="flex items-start justify-between gap-2">
              <h4 class="m-0 text-sm font-semibold text-gray-900">Material</h4>
              <button
                type="button"
                class="shrink-0 text-xs font-medium text-gray-500 hover:text-gray-900"
                data-disclosure-dismiss
                aria-label="Dismiss material component"
              >
                Dismiss
              </button>
            </div>
            <p class="mb-0 mt-2">A tiny ball of bat guano and sulfur.</p>
          </div>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Regions visible:&nbsp;<span id="docs-disclosure-multi-status" class="font-mono font-medium text-gray-900">0</span> / 3
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Multiple buttons, one target</h3>
          <p class="text-sm text-gray-600">
            Several triggers can share the same <code>aria-controls</code> ID. Listen to the
            open/close events and keep each trigger’s <code>aria-expanded</code> in sync yourself —
            use <code>event.detail.open</code> and <code>event.detail.el</code>.
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <cinq-disclosure-button>
            <button
              type="button"
              id="docs-disclosure-glyph-trigger"
              class="px-3 py-2 rounded-lg bg-gray-100 text-gray-800 hover:bg-gray-200 aria-expanded:bg-black aria-expanded:text-white aria-expanded:hover:bg-gray-800"
              aria-expanded="false"
              aria-controls="docs-disclosure-shared-lore"
            >
              Inspect glyph
            </button>
          </cinq-disclosure-button>

          <cinq-disclosure-button>
            <button
              type="button"
              id="docs-disclosure-journal-trigger"
              class="px-3 py-2 rounded-lg bg-gray-100 text-gray-800 hover:bg-gray-200 aria-expanded:bg-black aria-expanded:text-white aria-expanded:hover:bg-gray-800"
              aria-expanded="false"
              aria-controls="docs-disclosure-shared-lore"
            >
              Read journal entry
            </button>
          </cinq-disclosure-button>
        </div>

        <div
          id="docs-disclosure-shared-lore"
          class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
          hidden
        >
          <p class="m-0">
            The rune translates to <strong>“Beware the sleeping flame”</strong> — the same warning
            appears in the adventurer’s journal beside a sketch of the dungeon door.
          </p>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Lore excerpt: <span id="docs-disclosure-shared-status" class="font-mono font-medium text-gray-900">hidden</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Programmatic open &amp; close</h3>
          <p class="text-sm text-gray-600">
            Call <code>open()</code> or <code>close()</code> on the host element — from an external
            control, a dismiss button inside the region, or your own routing logic.
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <cinq-disclosure-button id="docs-disclosure-programmatic-host">
            <button
              type="button"
              id="docs-disclosure-programmatic-trigger"
              class="px-3 py-2 rounded-lg bg-black text-white hover:bg-gray-800"
              aria-expanded="false"
              aria-controls="docs-disclosure-programmatic-region"
            >
              Show session notes
            </button>
          </cinq-disclosure-button>

          <button
            type="button"
            id="docs-disclosure-programmatic-open"
            class="px-3 py-2 rounded-lg bg-gray-100 text-gray-800 hover:bg-gray-200"
          >
            Open from elsewhere
          </button>
        </div>

        <div
          id="docs-disclosure-programmatic-region"
          class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
          hidden
        >
          <p class="mt-0">
            The party spotted a hidden door behind the tapestry. Roll for investigation before the
            torch burns out.
          </p>
          <button
            type="button"
            id="docs-disclosure-programmatic-dismiss"
            class="px-3 py-2 rounded-lg bg-gray-100 text-gray-800 hover:bg-gray-200"
          >
            Dismiss
          </button>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Region state: <span id="docs-disclosure-programmatic-status" class="font-mono font-medium text-gray-900">closed</span>
        </p>
      </div>
    </section>

    <section class="rounded-2xl bg-white p-6 shadow">
      <div class="flex flex-col gap-4">
        <div>
          <h3 class="text-lg font-semibold text-gray-900">Cancellable events</h3>
          <p class="text-sm text-gray-600">
            Open and close events fire <em>before</em> the state changes. Call <code>event.preventDefault()</code> to abort — useful for confirmations or gating access.
          </p>
        </div>

        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" id="docs-disclosure-cancel-allow" class="rounded border-gray-300" checked />
          Allow opening
        </label>

        <cinq-disclosure-button id="docs-disclosure-cancel-host">
          <button
            type="button"
            id="docs-disclosure-cancel-trigger"
            class="self-start px-3 py-2 rounded-lg bg-black text-white hover:bg-gray-800"
            aria-expanded="false"
            aria-controls="docs-disclosure-cancel-region"
          >
            Reveal treasure map
          </button>
        </cinq-disclosure-button>

        <div
          id="docs-disclosure-cancel-region"
          class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-700"
          hidden
        >
          <p class="m-0">X marks a sunken vault beneath the old lighthouse — approach at low tide only.</p>
        </div>

        <p class="rounded-lg bg-gray-50 px-3 py-2 text-sm text-gray-800">
          Last attempt: <span id="docs-disclosure-cancel-status" class="font-mono font-medium text-gray-900">—</span>
        </p>
      </div>
    </section>
  </div>
</div>

<script>
  import type { DisclosureButton } from '@agencecinq/disclosure-button';
  import { EVENTS } from '@agencecinq/utils';

  const basicHost = document.getElementById('docs-disclosure-basic');
  const status = document.getElementById('docs-disclosure-status');

  if (basicHost && status) {
    basicHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, () => {
      status.textContent = EVENTS.DISCLOSURE_BUTTON_OPEN;
    });

    basicHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, () => {
      status.textContent = EVENTS.DISCLOSURE_BUTTON_CLOSE;
    });
  }

  const labelTrigger = document.getElementById('docs-disclosure-label-trigger');
  const labelStatus = document.getElementById('docs-disclosure-label-status');

  if (labelTrigger && labelStatus) {
    const labels = { closed: 'Show stat block', open: 'Hide stat block' };

    labelTrigger.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, () => {
      labelTrigger.textContent = labels.open;
      labelStatus.textContent = labels.open;
    });

    labelTrigger.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, () => {
      labelTrigger.textContent = labels.closed;
      labelStatus.textContent = labels.closed;
    });
  }

  const readMoreTrigger = document.getElementById('docs-disclosure-readmore-trigger');

  if (readMoreTrigger) {
    const labels = { closed: 'Read full entry', open: 'Hide entry' };

    readMoreTrigger.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, () => {
      readMoreTrigger.textContent = labels.open;
    });

    readMoreTrigger.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, () => {
      readMoreTrigger.textContent = labels.closed;
    });
  }

  const componentsHost = document.getElementById(
    'docs-disclosure-components-host',
  ) as DisclosureButton | null;
  const componentsTrigger = document.getElementById('docs-disclosure-components-trigger');
  const multiStatus = document.getElementById('docs-disclosure-multi-status');

  const countVisibleRegions = (elements: HTMLElement[]) =>
    elements.filter((element) => !element.hidden).length;

  if (componentsHost && componentsTrigger && multiStatus) {
    const labels = {
      closed: 'Show material components',
      open: 'Hide material components',
    };

    const updateMultiUI = () => {
      const visible = countVisibleRegions(componentsHost.elements);
      multiStatus.textContent = String(visible);
      componentsTrigger.textContent = visible > 0 ? labels.open : labels.closed;
    };

    // Events fire before the DOM mutates — refresh after open/close apply.
    componentsHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, () => {
      queueMicrotask(updateMultiUI);
    });
    componentsHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, () => {
      queueMicrotask(updateMultiUI);
    });

    componentsHost.elements.forEach((region) => {
      region.querySelector('[data-disclosure-dismiss]')?.addEventListener('click', () => {
        region.hidden = true;
        componentsHost.update();
        updateMultiUI();
      });
    });
  }

  const glyphTrigger = document.getElementById('docs-disclosure-glyph-trigger');
  const journalTrigger = document.getElementById('docs-disclosure-journal-trigger');
  const sharedStatus = document.getElementById('docs-disclosure-shared-status');

  if (glyphTrigger && journalTrigger && sharedStatus) {
    const triggers = [glyphTrigger, journalTrigger];

    const syncSharedTriggers = (event: Event) => {
      if (!(event instanceof CustomEvent)) return;

      const { el, open } = event.detail as { el: HTMLElement; open: boolean };

      triggers.forEach((trigger) => {
        if (trigger !== el) {
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
      });

      sharedStatus.textContent = open ? 'visible' : 'hidden';
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, syncSharedTriggers);
      trigger.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, syncSharedTriggers);
    });
  }

  const programmaticHost = document.getElementById(
    'docs-disclosure-programmatic-host',
  ) as DisclosureButton | null;
  const programmaticOpen = document.getElementById('docs-disclosure-programmatic-open');
  const programmaticDismiss = document.getElementById('docs-disclosure-programmatic-dismiss');
  const programmaticTrigger = document.getElementById('docs-disclosure-programmatic-trigger');
  const programmaticStatus = document.getElementById('docs-disclosure-programmatic-status');

  const syncProgrammaticStatus = (trigger: HTMLElement, statusEl: HTMLElement, label: string) => {
    statusEl.textContent = `${label} (aria-expanded=${trigger.getAttribute('aria-expanded')})`;
  };

  if (programmaticHost && programmaticOpen && programmaticDismiss && programmaticTrigger && programmaticStatus) {
    programmaticHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, () => {
      syncProgrammaticStatus(programmaticTrigger, programmaticStatus, 'open');
    });

    programmaticHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, () => {
      syncProgrammaticStatus(programmaticTrigger, programmaticStatus, 'closed');
    });

    programmaticOpen.addEventListener('click', () => {
      programmaticHost.open();
    });

    programmaticDismiss.addEventListener('click', () => {
      programmaticHost.close();
    });
  }

  const cancelAllow = document.getElementById('docs-disclosure-cancel-allow') as HTMLInputElement | null;
  const cancelHost = document.getElementById(
    'docs-disclosure-cancel-host',
  ) as DisclosureButton | null;
  const cancelStatus = document.getElementById('docs-disclosure-cancel-status');

  if (cancelAllow && cancelHost && cancelStatus) {
    cancelHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_OPEN, (event) => {
      if (!cancelAllow.checked) {
        event.preventDefault();
        cancelStatus.textContent = 'blocked (preventDefault)';
        return;
      }

      cancelStatus.textContent = 'opened';
    });

    cancelHost.addEventListener(EVENTS.DISCLOSURE_BUTTON_CLOSE, () => {
      cancelStatus.textContent = 'closed';
    });
  }
</script>
